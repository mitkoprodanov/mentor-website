---
import type { Person } from '../../data/people';
import { getLinkedSkills } from '../../data/skills';
import { slugify } from '../../lib/slug';

interface Props {
	person: Person;
}

const { person } = Astro.props;
const linkedSkills = getLinkedSkills(person.id);
---

<div class="person-card" style={`--person-color: var(--${person.id}-color)`}>
	<h3>{person.name}</h3>
	<p class="role">{person.role}</p>
	<div class="skill-groups">
		{
			person.skillGroups.map((group) => (
				<div class="skill-group">
					<h4>{group.category}</h4>
					<div class="tag-row">
						{group.skills.map((skill) =>
							linkedSkills.has(skill) ? (
								<button
									type="button"
									class="tag tag--linked"
									data-person={person.id}
									data-skill={slugify(skill)}
									aria-pressed="false"
								>
									{skill}
								</button>
							) : (
								<span class="tag">{skill}</span>
							),
						)}
					</div>
				</div>
			))
		}
	</div>
	<p class="stat-line">In the games industry since {person.since}</p>
	<p class="edu-line">{person.education}</p>
</div>

<style>
	.person-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-top: 3px solid var(--person-color);
		border-radius: 16px;
		padding: 1.75rem;
		text-align: left;
	}

	.person-card h3 {
		margin: 0 0 0.15rem;
		font-size: 1.2rem;
	}

	.role {
		color: var(--person-color);
		margin: 0 0 1.25rem;
		font-size: 0.9rem;
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
	}

	.skill-group h4 {
		margin: 0 0 0.4rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-size: 0.75rem;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-3);
		border: 1px solid rgba(255, 122, 0, 0.3);
		white-space: nowrap;
	}

	button.tag {
		font-family: inherit;
		cursor: pointer;
		text-decoration: underline dotted rgba(255, 209, 102, 0.5);
		text-underline-offset: 3px;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	button.tag:hover {
		background: var(--accent-3);
		color: var(--bg);
	}

	button.tag:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	button.tag[aria-pressed='true'] {
		background: var(--accent-3);
		color: var(--bg);
		text-decoration: none;
		transform: scale(1.05);
		box-shadow: 0 0 12px 2px var(--accent-soft);
	}

	:global(body.filter-active) button.tag:not([aria-pressed='true']) {
		opacity: 0.45;
	}

	.stat-line {
		font-size: 0.85rem;
		color: var(--fg);
		margin: 0 0 0.25rem;
	}

	.edu-line {
		font-size: 0.8rem;
		color: var(--fg-muted);
		margin: 0;
	}
</style>
