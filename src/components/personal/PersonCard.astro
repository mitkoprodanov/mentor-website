---
import type { Person } from '../../data/people';
import { groupTagsByCategory, getLinkedTagIds } from '../../data/tags';
import Tag from '../common/Tag.astro';

interface Props {
	person: Person;
}

const { person } = Astro.props;
const linkedTagIds = getLinkedTagIds();
const tagGroups = groupTagsByCategory(person.tagIds);
---

<div class="person-card" style={`--person-color: var(--${person.id}-color)`}>
	<div class="skill-groups">
		{
			tagGroups.map((group) => (
				<div class="skill-group">
					<h4>{group.category}</h4>
					<div class="tag-row">
						{group.tags.map((tag) => (
							<Tag label={tag.label} linked={linkedTagIds.has(tag.id)} tagId={tag.id} />
						))}
					</div>
				</div>
			))
		}
	</div>
	<p class="stat-line">In the games industry since {person.since}</p>
	<p class="edu-line">{person.education}</p>
	{
		person.hobbies && person.hobbies.length > 0 && (
			<div class="hobbies">
				<h4>Hobbies</h4>
				<ul>
					{person.hobbies.map((hobby) => (
						<li>{hobby}</li>
					))}
				</ul>
			</div>
		)
	}
</div>

<style>
	.person-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.25rem 1.75rem 1.75rem;
		text-align: left;
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
	}

	.skill-group h4 {
		margin: 0 0 0.4rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.stat-line {
		font-size: 0.85rem;
		color: var(--fg);
		margin: 0 0 0.25rem;
	}

	.edu-line {
		font-size: 0.8rem;
		color: var(--fg-muted);
		margin: 0;
	}

	.hobbies {
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.hobbies h4 {
		margin: 0 0 0.6rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}

	.hobbies ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.hobbies li {
		font-size: 0.85rem;
		line-height: 1.4;
		color: var(--fg);
		padding-left: 1rem;
		position: relative;
	}

	.hobbies li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--person-color);
	}
</style>
