---
import type { Person } from '../../data/people';
import ExternalLink from '../common/ExternalLink.astro';

interface Props {
	person: Person;
}

const { person } = Astro.props;
---

<div class="contact-card" style={`--person-color: var(--${person.id}-color)`}>
	<h4>{person.name}</h4>
	<ExternalLink href={person.linkedin}>LinkedIn</ExternalLink>
	{
		person.email && (
			<ExternalLink href={`mailto:${person.email}`} external={false}>
				{person.email}
			</ExternalLink>
		)
	}
</div>

<style>
	.contact-card {
		background: var(--bg-alt);
		border: 1px solid var(--border);
		border-top: 3px solid var(--person-color);
		border-radius: 16px;
		padding: 1.25rem 1.5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contact-card h4 {
		margin: 0 0 0.15rem;
		font-size: 1rem;
	}

	.contact-card :global(.external-link) {
		align-self: center;
		font-size: 0.9rem;
	}
</style>
