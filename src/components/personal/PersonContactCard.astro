---
import type { Person } from '../../data/people';
import ExternalLink from '../common/ExternalLink.astro';
import CvDownloadLink from './CvDownloadLink.astro';

interface Props {
	person: Person;
}

const { person } = Astro.props;
---

<div class="contact-card" style={`--person-color: var(--${person.id}-color)`}>
	{
		person.cv && (
			<div class="cv-slot">
				<CvDownloadLink person={person} />
			</div>
		)
	}
	<ExternalLink href={person.linkedin}>LinkedIn</ExternalLink>
	{
		person.email && (
			<ExternalLink href={`mailto:${person.email}`} external={false}>
				{person.email}
			</ExternalLink>
		)
	}
</div>

<style>
	/* No name here — a PersonHeader.astro sits directly above this, both in
	   the Contact section (see Contact.astro) and in the fixed side panel
	   while it's still visible, so repeating it would be redundant. Same
	   look as that header — plain background, single thick accent border,
	   rounded only on the edge that faces away from it — just mirrored:
	   the accent border and rounding are on the bottom here instead of the
	   top, since this card sits below the header rather than above it. */
	.contact-card {
		background: var(--bg);
		border-bottom: 3px solid var(--person-color);
		border-radius: 0 0 16px 16px;
		padding: 0.5rem 1.75rem 1.25rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.contact-card :global(.external-link) {
		align-self: center;
		font-size: 1rem;
		font-weight: 600;
	}

	/* Sits at the very top of this card, which is directly below the name in
	   PersonHeader — so the CV download reads as belonging to that person. */
	.cv-slot {
		display: flex;
		justify-content: center;
		margin-bottom: 0.2rem;
	}

	/* No entrance animation of its own: the whole Contact overlay crossfades
	   in as one piece (see Contact.astro / contactReveal.client.ts), so this
	   card is simply part of that fade rather than a separate element sliding
	   or popping into view. */
</style>
