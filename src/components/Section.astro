---
interface Props {
	id: string;
	title?: string;
	class?: string;
	/** Skip the full-viewport centering — for embedding inline (e.g. inside the Timeline/Personal scrolly grid) instead of as a standalone full-screen stop. */
	compact?: boolean;
}

const { id, title, class: className, compact = false } = Astro.props;
---

<section id={id} class:list={['section', { 'section--compact': compact }, className]}>
	{title && <h2 class="section-title brand-heading">{title}</h2>}
	<slot />
</section>

<style>
	.section {
		min-height: 100vh;
		width: 100%;
		padding: 4rem 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.section.section--compact {
		min-height: 0;
		padding: 2rem 0;
		justify-content: flex-start;
	}

	.section-title {
		font-size: var(--text-hero);
		margin-bottom: 3rem;
		text-align: center;
	}
</style>
