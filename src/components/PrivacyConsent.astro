---
// Compact Privacy control (docs/privacy.md): a fixed lock button (bottom-left) and a thin floating
// bar with three choices over TWO independent permissions (External media, Analytics).
// ONE instance of this markup exists. Normally it lives in <body>; while a native modal <dialog> is
// open (everything outside it is inert) privacyConsent.client.ts moves the same root into that
// dialog, so state and logic are shared and nothing is duplicated. Behaviour: privacyConsent.client.ts.
---

<div class="privacy-root" id="privacy-root">
	<button type="button" class="privacy-toggle" id="privacy-toggle" aria-label="Privacy" aria-expanded="false" aria-controls="privacy-bar" hidden>
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
			<rect x="5" y="10.5" width="14" height="10" rx="2" fill="currentColor"></rect>
			<path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
		</svg>
	</button>

	<section class="privacy-bar" id="privacy-bar" role="group" aria-label="Privacy choices" hidden>
		<p class="privacy-bar__intro">Choose whether to load external media and allow anonymous usage analytics.</p>

		<div class="privacy-bar__choices">
			<button type="button" class="privacy-choice" data-privacy-choice="none" aria-pressed="false">
				<span class="privacy-choice__mark" aria-hidden="true"></span>
				<span class="privacy-choice__text"><strong>No optional services</strong><small>Maximum privacy</small></span>
			</button>
			<button type="button" class="privacy-choice" data-privacy-choice="media" aria-pressed="false">
				<span class="privacy-choice__mark" aria-hidden="true"></span>
				<span class="privacy-choice__text"><strong>External media</strong><small>Essential visuals</small></span>
			</button>
			<button type="button" class="privacy-choice" data-privacy-choice="analytics" aria-pressed="false">
				<span class="privacy-choice__mark" aria-hidden="true"></span>
				<span class="privacy-choice__text"><strong>Analytics</strong><small>Site improvement</small></span>
			</button>
		</div>

		<div class="privacy-bar__tools">
			<button type="button" class="privacy-link" data-privacy-action="details" aria-expanded="false" aria-controls="privacy-details">Details</button>
			<button type="button" class="privacy-bar__close" data-privacy-action="close" aria-label="Close Privacy">×</button>
		</div>

		<p class="privacy-bar__note" id="privacy-note" role="status" hidden></p>

		<div class="privacy-details" id="privacy-details" hidden>
			<p><strong>External media</strong><br />Loads embedded content from YouTube, Facebook and LinkedIn. Your browser connects to these providers when their content is displayed.</p>
			<p><strong>Analytics</strong><br />Collects anonymous usage data to understand how the site is used and improve it. No persistent visitor ID, cross-site tracking or session replay. Raw analytics data is retained for 90 days.</p>
			<p><strong>Your choices</strong><br />Your privacy choices are stored in this browser and can be changed at any time using Privacy.</p>
		</div>
	</section>
</div>

<style>
	/* Top-level viewport UI: the root generates no box; the two fixed children are the UI. Nothing here
	   uses opacity/filter/transform on an ancestor, so modal blur can never reach it. */
	.privacy-root {
		display: contents;
		--privacy-edge: max(0.75rem, env(safe-area-inset-bottom));
		--privacy-edge-l: max(0.75rem, env(safe-area-inset-left));
		--privacy-edge-r: max(0.75rem, env(safe-area-inset-right));
	}

	.privacy-toggle[hidden],
	.privacy-bar[hidden],
	.privacy-details[hidden],
	.privacy-bar__note[hidden] {
		display: none;
	}

	.privacy-toggle,
	.privacy-bar {
		position: fixed;
		z-index: 1000;
		bottom: max(0.75rem, env(safe-area-inset-bottom));
	}

	.privacy-toggle {
		left: max(0.75rem, env(safe-area-inset-left));
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border-radius: 50%;
		border: 1px solid var(--mentor-border);
		background: color-mix(in oklab, var(--bg-alt) 96%, transparent);
		color: var(--fg-muted);
		box-shadow: 0 4px 14px var(--color-shadow-deep);
		cursor: pointer;
		overflow: hidden;
	}

	.privacy-toggle:hover,
	.privacy-toggle:focus-visible,
	.privacy-toggle[aria-expanded='true'] {
		color: var(--fg);
		border-color: var(--mentor);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--mentor) 28%, transparent), 0 4px 14px var(--color-shadow-deep);
	}

	/* Subtle periodic glint while unanswered; reduced-motion users get none. */
	.privacy-toggle[data-attention='true']::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(110deg, transparent 35%, color-mix(in oklab, var(--mentor) 55%, white) 50%, transparent 65%);
		transform: translateX(-120%);
		animation: privacy-glint 6s ease-in-out 2s infinite;
		pointer-events: none;
	}

	@keyframes privacy-glint {
		0%, 70% { transform: translateX(-120%); }
		100% { transform: translateX(120%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.privacy-toggle[data-attention='true']::after {
			animation: none;
			display: none;
		}
	}

	.privacy-bar {
		left: calc(var(--privacy-edge-l) + 2.75rem);
		right: var(--privacy-edge-r);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.9rem;
		padding: 0.45rem 0.7rem;
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		background: color-mix(in oklab, var(--bg-alt) 97%, transparent);
		border: 1px solid var(--mentor-border);
		border-radius: 12px;
		box-shadow: 0 8px 26px var(--color-shadow-deep);
		color: var(--fg);
		font-size: 0.78rem;
		line-height: 1.35;
	}

	.privacy-bar__intro {
		margin: 0;
		flex: 1 1 14rem;
		color: var(--fg-muted);
	}

	.privacy-bar__choices {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.privacy-choice {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font: inherit;
		padding: 0.3rem 0.65rem 0.3rem 0.5rem;
		border-radius: 10px;
		border: 1px solid var(--mentor-border);
		background: transparent;
		color: var(--fg);
		text-align: left;
		cursor: pointer;
	}

	.privacy-choice__text {
		display: grid;
	}

	.privacy-choice small {
		color: var(--fg-muted);
		font-size: 0.7rem;
	}

	/* Selected = filled tint + a check mark in the indicator (never colour alone). */
	.privacy-choice__mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.05rem;
		height: 1.05rem;
		border: 1.5px solid var(--fg-muted);
		border-radius: 4px;
		font-size: 0.75rem;
		line-height: 1;
	}

	.privacy-choice[data-privacy-choice='none'] .privacy-choice__mark {
		border-radius: 50%;
	}

	.privacy-choice[aria-pressed='true'] {
		background: var(--mentor-bg);
		border-color: var(--mentor);
		box-shadow: inset 0 0 0 1px var(--mentor);
	}

	.privacy-choice[aria-pressed='true'] .privacy-choice__mark {
		border-color: var(--mentor);
		background: var(--mentor);
		color: var(--bg);
	}

	.privacy-choice[aria-pressed='true'] .privacy-choice__mark::before {
		content: '✓';
	}

	.privacy-choice:hover,
	.privacy-choice:focus-visible,
	.privacy-link:focus-visible,
	.privacy-bar__close:focus-visible {
		outline: 2px solid var(--mentor);
		outline-offset: 2px;
	}

	.privacy-choice:disabled {
		opacity: 0.65;
		cursor: default;
	}

	.privacy-bar__tools {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
	}

	.privacy-link {
		font: inherit;
		background: none;
		border: 0;
		padding: 0.2rem 0.3rem;
		color: var(--fg-muted);
		text-decoration: underline;
		cursor: pointer;
	}

	.privacy-bar__close {
		font: inherit;
		font-size: 1.2rem;
		line-height: 1;
		background: none;
		border: 0;
		padding: 0 0.3rem;
		color: var(--fg-muted);
		cursor: pointer;
	}

	.privacy-bar__note,
	.privacy-details {
		flex: 1 1 100%;
		margin: 0;
	}

	.privacy-bar__note {
		color: var(--fg-muted);
	}

	.privacy-details p {
		margin: 0.35rem 0 0;
	}

	@media (max-width: 600px) {
		.privacy-bar {
			gap: 0.3rem 0.6rem;
		}
		.privacy-bar__intro {
			flex-basis: 100%;
		}
		.privacy-bar__choices {
			flex: 1 1 100%;
		}
		.privacy-choice {
			flex: 1 1 8rem;
		}
	}
</style>
