---
import { getEntry, render } from 'astro:content';
import { getPerson, COLUMN } from '../../data/people';
import type { ProjectDef } from '../../data/timeline';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
	project: ProjectDef;
	emphasized?: boolean;
}

const { project, emphasized = false } = Astro.props;

const cards = await Promise.all(
	project.experiences.map(async (ref) => {
		const entry = await getEntry('experiences', ref.slug);
		if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
		const { Content } = await render(entry);
		return {
			person: getPerson(ref.person),
			Content,
			tagIds: ref.tagIds ?? [],
			link: entry.data.link,
			previewImage: entry.data.previewImage,
		};
	}),
);

const leftCard = cards.find((c) => COLUMN[c.person.id] === 'left');
const rightCard = cards.find((c) => COLUMN[c.person.id] === 'right');
const singleCard = leftCard && rightCard ? null : (leftCard ?? rightCard);
---

<div class="project-row" class:list={{ 'project-row--boxed': Boolean(project.name) }}>
	{
		project.name && (
			<div class="node">
				<span class="dot" class:list={{ emphasized }} />
				<div class="node-text">
					<h5 class="node-label">{project.name}</h5>
					{project.info && <p class="node-info">{project.info}</p>}
				</div>
			</div>
		)
	}
	<div class="experience-row" class:list={{ 'experience-row--single': Boolean(singleCard) }}>
		{
			singleCard ? (
				<ExperienceCard
					personId={singleCard.person.id}
					tagIds={singleCard.tagIds}
					color={emphasized ? 'var(--accent-3)' : `var(--${singleCard.person.id}-color)`}
					side={COLUMN[singleCard.person.id]}
					link={singleCard.link}
					previewImage={singleCard.previewImage}
				>
					<singleCard.Content />
				</ExperienceCard>
			) : (
				<Fragment>
					{leftCard && (
						<ExperienceCard
							personId={leftCard.person.id}
							tagIds={leftCard.tagIds}
							color={emphasized ? 'var(--accent-3)' : `var(--${leftCard.person.id}-color)`}
							side="left"
							link={leftCard.link}
							previewImage={leftCard.previewImage}
						>
							<leftCard.Content />
						</ExperienceCard>
					)}
					{rightCard && (
						<ExperienceCard
							personId={rightCard.person.id}
							tagIds={rightCard.tagIds}
							color={emphasized ? 'var(--accent-3)' : `var(--${rightCard.person.id}-color)`}
							side="right"
							link={rightCard.link}
							previewImage={rightCard.previewImage}
						>
							<rightCard.Content />
						</ExperienceCard>
					)}
				</Fragment>
			)
		}
	</div>
</div>

<style>
	.project-row {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project-row--boxed {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--bg);
		padding: 1.25rem;
	}

	.node {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.dot {
		flex-shrink: 0;
		margin-top: 0.4rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent-soft);
	}

	.dot.emphasized {
		background: var(--accent-3);
		box-shadow: 0 0 12px 3px var(--accent-soft);
	}

	.node-text {
		min-width: 0;
	}

	.node-label {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--fg);
	}

	.node-info {
		margin: 0.3rem 0 0;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--fg-muted);
	}

	.experience-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.experience-row--single {
		grid-template-columns: 1fr;
	}

	@media (max-width: 900px) {
		.experience-row {
			grid-template-columns: 1fr;
		}
	}
</style>
