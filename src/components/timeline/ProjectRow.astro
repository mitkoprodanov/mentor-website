---
import { getEntry, render } from 'astro:content';
import { getPerson, COLUMN } from '../../data/people';
import { getTag } from '../../data/tags';
import { PLACEHOLDER_MEDIA } from '../../data/projects';
import type { ProjectDef } from '../../data/timeline';
import ExperienceCard from './ExperienceCard.astro';
import ProjectModal from '../projects/ProjectModal.astro';

interface Props {
	project: ProjectDef;
	emphasized?: boolean;
	/** The enclosing company's date range — shown in the detail modal unless the project overrides it with its own `dateRange`. */
	dateRange?: string;
}

const { project, emphasized = false, dateRange } = Astro.props;

async function loadCards(refs: ProjectDef['experiences']) {
	return Promise.all(
		refs.map(async (ref) => {
			const entry = await getEntry('experiences', ref.slug);
			if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
			const { Content } = await render(entry);
			return {
				person: getPerson(ref.person),
				Content,
				tagIds: ref.tagIds ?? [],
				link: entry.data.link,
				previewImage: entry.data.previewImage,
			};
		}),
	);
}

// Cards rendered inline in this row — one person for a split project's half.
const cards = await loadCards(project.experiences);
// Cards shown inside the detail modal. A split project's modal-owning half sets
// `modalExperiences` to list both people, so its shared card reads like any
// other joint project; everything else just reuses its own inline cards.
const modalCards = project.modalExperiences ? await loadCards(project.modalExperiences) : cards;

const leftCard = cards.find((c) => COLUMN[c.person.id] === 'left');
const rightCard = cards.find((c) => COLUMN[c.person.id] === 'right');
const singleCard = leftCard && rightCard ? null : (leftCard ?? rightCard);
const singleSide = singleCard ? COLUMN[singleCard.person.id] : null;

// Detail modal — only named projects render a clickable node, so only they get
// a modal. Namespaced (`tl-`) so timeline ids never collide with the Projects
// section's own modal ids. A split project's two rows share one `modalId`, so
// both open the same modal; the non-owning half sets `noModal` and renders none
// of its own. Tags are the union of the modal's experience tags; media falls
// back to the shared placeholder (see data/timeline.ts).
const modalId = `tl-${project.modalId ?? project.id}`;
const modalDateRange = project.dateRange ?? dateRange;
const peopleLabel = modalCards.map((c) => c.person.name).join(' & ');
const modalTagLabels = [...new Set(modalCards.flatMap((c) => c.tagIds))].map((id) => getTag(id).label);
const modalMedia = project.media ?? PLACEHOLDER_MEDIA;
---

<div
	class="project-row"
	data-modal-group={project.modalId}
	class:list={{
		'project-row--boxed': Boolean(project.name),
		'btn-sheen': Boolean(project.name),
		'project-row--solo-left': singleSide === 'left',
		'project-row--solo-right': singleSide === 'right',
		'project-row--tall': Boolean(project.rowSpan),
		'project-row--square-bottom-right': Boolean(project.squareBottomRight),
		'project-row--bridge-left': Boolean(project.bridgeLeft),
	}}
	style={project.rowSpan ? `grid-row: span ${project.rowSpan};` : undefined}
>
	{
		project.bridgeLeft && (
			// The concave step at this fill's top-left (see the comment on
			// .project-row--square-bottom-right below) needs a corner that
			// curves down from the rowSpan neighbor's edge above, then bends
			// into the flat fill below — exact enough that plain CSS
			// border-radius corner tricks kept landing on the wrong curve.
			// Drawn directly as an arc instead of approximated.
			<svg class="bridge-curve" viewBox="0 0 20 16" preserveAspectRatio="none" aria-hidden="true">
				<path class="bridge-curve-fill" d="M 0 0 A 16 16 0 0 0 16 16 L 0 16 Z" />
				<path class="bridge-curve-stroke" d="M 0 0 A 16 16 0 0 0 16 16 L 20 16" />
			</svg>
		)
	}
	{
		project.name && (
			<div class="node">
				<span class="dot" class:list={{ emphasized }} />
				<div class="node-text">
					<h5 class="node-label">{project.name}</h5>
					{project.info && <p class="node-info">{project.info}</p>}
				</div>
				<span class="node-hint" aria-hidden="true">Details →</span>
			</div>
		)
	}
	<div class="experience-row">
		{
			singleCard ? (
				<ExperienceCard
					personId={singleCard.person.id}
					tagIds={singleCard.tagIds}
					color={`var(--${singleCard.person.id}-color)`}
					side={COLUMN[singleCard.person.id]}
					link={singleCard.link}
					previewImage={singleCard.previewImage}
					interactive={Boolean(project.name)}
				>
					<singleCard.Content />
				</ExperienceCard>
			) : (
				<Fragment>
					{leftCard && (
						<ExperienceCard
							personId={leftCard.person.id}
							tagIds={leftCard.tagIds}
							color={`var(--${leftCard.person.id}-color)`}
							side="left"
							link={leftCard.link}
							previewImage={leftCard.previewImage}
							interactive={Boolean(project.name)}
						>
							<leftCard.Content />
						</ExperienceCard>
					)}
					{rightCard && (
						<ExperienceCard
							personId={rightCard.person.id}
							tagIds={rightCard.tagIds}
							color={`var(--${rightCard.person.id}-color)`}
							side="right"
							link={rightCard.link}
							previewImage={rightCard.previewImage}
							interactive={Boolean(project.name)}
						>
							<rightCard.Content />
						</ExperienceCard>
					)}
				</Fragment>
			)
		}
	</div>

	{
		project.name && (
			<button
				type="button"
				class="row-open"
				data-project-open={modalId}
				aria-haspopup="dialog"
				aria-label={`Open details for ${project.name}`}
			/>
		)
	}

	{
		project.name && !project.noModal && (
			<ProjectModal
				modalId={modalId}
				title={project.name}
				subtitle={project.info}
				dateRange={modalDateRange}
				people={peopleLabel}
				tags={modalTagLabels}
				media={modalMedia}
			>
				{modalCards.map((c) => (
					<div class="modal-exp" style={`--person-color: var(--${c.person.id}-color)`}>
						<p class="modal-exp__person">{c.person.name}</p>
						<c.Content />
					</div>
				))}
			</ProjectModal>
		)
	}
</div>

<style>
	/* A grid item of the parent .company-projects grid. Full-width by default;
	   solo projects narrow to a single column (see the modifiers below). */
	.project-row {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		/* A boxed row reads as a clickable action surface, not a plain panel:
		   the same soft warm-accent tint + colored slim border language as the
		   Skills / Download CV pills, one notch calmer since the box is large.
		   Shared as variables so the bridged seam fills (::before + the SVG
		   curve) can match the box exactly, at rest and on hover. */
		--row-fill: color-mix(in oklab, var(--accent) 6%, var(--bg));
		--row-fill-hover: color-mix(in oklab, var(--accent) 11%, var(--bg-alt));
		--row-line: color-mix(in oklab, var(--accent) 32%, var(--border));
		/* The drifting sheen is a warm-gold glint on these warm surfaces. */
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.07;
	}

	.project-row--boxed {
		border: 1px solid var(--row-line);
		border-radius: 16px;
		background: var(--row-fill);
		padding: 1.25rem;
	}

	.node {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
	}

	/* The whole boxed row is the click target: a transparent <button> stretched
	   over the row (below the experience cards' own Showcase controls, which are
	   lifted above it) so clicking anywhere over the node OR the experience
	   cards opens the modal. `isolation` keeps that overlay's z-index local to
	   the row. Only named projects are boxed, and only they get an overlay. */
	.project-row--boxed {
		position: relative;
		isolation: isolate;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.project-row--boxed:hover {
		/* Bright, glowing hover to match the Projects cards under the Timeline
		   — a warm accent halo and crisp ring on top of the lift shadow. */
		border-color: color-mix(in oklab, var(--accent) 70%, var(--border));
		box-shadow:
			0 10px 28px -14px rgba(0, 0, 0, 0.7),
			0 0 22px -2px rgba(255, 122, 0, 0.45),
			0 0 0 1px color-mix(in oklab, var(--accent) 55%, transparent);
		background: var(--row-fill-hover);
	}

	/* A project split into two layout rows that share one modal (see
	   ProjectDef.modalId, e.g. "Around") reads as a single clickable area:
	   hovering either half lights up both boxes — and the bridge fill between
	   them — so the seam never gives away that they're two separate boxes.
	   `.company-projects` is the parent grid (owned by CompanyBlock), reached
	   via :global; the grouped rows are this component's own elements. */
	:global(.company-projects:has([data-modal-group]:hover)) .project-row[data-modal-group] {
		border-color: color-mix(in oklab, var(--accent) 70%, var(--border));
		box-shadow:
			0 10px 28px -14px rgba(0, 0, 0, 0.7),
			0 0 22px -2px rgba(255, 122, 0, 0.45),
			0 0 0 1px color-mix(in oklab, var(--accent) 55%, transparent);
		background: var(--row-fill-hover);
	}

	:global(.company-projects:has([data-modal-group]:hover)) .project-row--bridge-left::before {
		background: var(--row-fill-hover);
	}

	:global(.company-projects:has([data-modal-group]:hover)) .project-row--bridge-left .bridge-curve-fill {
		fill: var(--row-fill-hover);
	}

	:global(.company-projects:has([data-modal-group]:hover)) .project-row[data-modal-group] .node-hint {
		color: var(--accent-3);
		opacity: 1;
		transform: translateX(3px);
	}

	.row-open {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		border-radius: inherit;
		cursor: pointer;
	}

	.row-open:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	/* Keep each experience card's own Showcase toggle (and its expanded embed)
	   above the overlay so they stay independently clickable. */
	.experience-row :global(.showcase) {
		position: relative;
		z-index: 2;
	}

	.node-hint {
		flex-shrink: 0;
		margin-left: auto;
		align-self: center;
		font-size: 0.75rem;
		color: var(--fg-muted);
		opacity: 0.7;
		transition:
			color 0.2s ease,
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.project-row--boxed:hover .node-hint {
		color: var(--accent-3);
		opacity: 1;
		transform: translateX(3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-row--boxed,
		.node-hint {
			transition: none;
		}
	}

	/* One person's experience prose inside the modal — a lighter-weight stand-in
	   for the timeline's ExperienceCard, deliberately without the `.card`/
	   `data-tags` hooks so the tag-filter never treats these as timeline cards. */
	.modal-exp {
		padding-left: 0.85rem;
		border-left: 2px solid var(--person-color, var(--accent));
	}

	.modal-exp + .modal-exp {
		margin-top: 1.1rem;
	}

	.modal-exp__person {
		margin: 0 0 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--person-color, var(--accent));
	}

	.dot {
		flex-shrink: 0;
		margin-top: 0.4rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--project-dot);
		box-shadow: 0 0 10px var(--project-dot-soft);
	}

	.dot.emphasized {
		background: var(--mentor);
		box-shadow: 0 0 12px 3px var(--mentor-soft);
	}

	.node-text {
		min-width: 0;
	}

	.node-label {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--fg);
	}

	.node-info {
		margin: 0.3rem 0 0;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--fg-muted);
	}

	.experience-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	/* A solo project belongs to one person — the whole box (node + card) sits
	   in just that person's column of the grid, so the empty half makes it
	   unmistakable this was one person's work. Two opposite-side solo projects
	   from the same period then pack side by side in one grid row. */
	.project-row--solo-left {
		grid-column: 1;
	}

	.project-row--solo-right {
		grid-column: 2;
	}

	.project-row--solo-left .experience-row,
	.project-row--solo-right .experience-row {
		grid-template-columns: 1fr;
	}

	/* .company-projects (the parent grid) aligns items to the start of
	   their cell by default, so a row-spanning card (see ProjectDef.rowSpan)
	   would otherwise only be as tall as its own content and leave the rest
	   of its spanned cell empty instead of visually reaching the row it's
	   meant to run alongside. Stretching this item to the cell's full
	   height, then growing .experience-row to fill the remaining space
	   below the node label, lets the card itself (a grid item of
	   .experience-row, `align-items` there defaulting to stretch too) fill
	   that height in turn. */
	.project-row--tall {
		align-self: stretch;
	}

	.project-row--tall .experience-row {
		flex: 1;
	}

	/* Drops the corner radius *and* the border line on the side touching a
	   `bridgeLeft` neighbor's fill (below) — trying to keep that line and
	   paint over it from the adjoining element was fighting sub-pixel
	   rounding (the two boxes' independently-laid-out edges don't land on
	   the exact same fractional pixel, so a hairline kept showing through).
	   Dropping the line outright removes it at the source instead. Above
	   the join, where this box sits beside "Beasts of Brawlia" (not
	   bridged), the gap there now reads with only that box's own left
	   border, not a doubled line — a harmless, arguably cleaner change
	   since there's nothing on this side to draw a border against anymore. */
	.project-row--square-bottom-right.project-row--boxed {
		border-bottom-right-radius: 0;
		border-right: none;
	}

	/* Joins this box to a taller rowSpan card beside it in the other
	   column: squares off this side's corners, drops the border line that
	   side (see the comment above), and fills the column gap between them
	   with a continuation of this box's own background so the pair reads
	   as one connected shape with no vertical seam anywhere in the join.
	   Assumes this box's own height already reaches the same bottom edge
	   as its `squareBottomRight` partner (see ProjectDef.bridgeLeft). */
	.project-row--bridge-left {
		position: relative;
	}

	.project-row--bridge-left.project-row--boxed {
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
		border-left: none;
	}

	.project-row--bridge-left.project-row--boxed::before {
		content: '';
		position: absolute;
		/* An absolutely positioned child is offset from its containing
		   block's *padding* edge, not its border edge — since this box is
		   border-box with a 1px border, top/bottom: 0 would sit 1px inside
		   the box's own border line, kinking the seam where the two borders
		   are meant to run flush as one straight line. -1px cancels that. */
		top: -1px;
		bottom: -1px;
		left: -1.25rem;
		width: 1.25rem;
		background: var(--row-fill);
		border-bottom: 1px solid var(--row-line);
		/* No border-top here — the curve's own SVG stroke (above) draws the
		   whole top line, arc included, so this fill doesn't also draw a
		   second, plain straight one underneath it. Two independently laid
		   out elements (an SVG path and a CSS border) rarely land on the
		   exact same fractional pixel, so relying on one to fully hide the
		   other left a hairline of the straight line poking out past the
		   curve — the same lesson as the border-right/border-left removal
		   below. */
	}

	/* The concave step (see the comment on .project-row--square-bottom-right
	   above) sits right at this fill's top-left corner, where the rowSpan
	   neighbor's own edge keeps going straight up, unbridged, above where
	   this fill starts. This arc (see the SVG in the markup above) rounds
	   *that* transition: it comes down from the neighbor's edge above,
	   then bends right into the fill's flat top border below — sitting
	   flush on top of the fill's left end. */
	.bridge-curve {
		position: absolute;
		top: calc(-1px - 16px);
		left: -1.25rem;
		width: 1.25rem;
		height: 16px;
		overflow: visible;
	}

	.bridge-curve-fill {
		fill: var(--row-fill);
		stroke: none;
	}

	.bridge-curve-stroke {
		fill: none;
		stroke: var(--row-line);
		stroke-width: 1px;
		vector-effect: non-scaling-stroke;
	}

	@media (max-width: 900px) {
		.experience-row {
			grid-template-columns: 1fr;
		}

		/* On narrow screens the grid is a single column, so solo projects span
		   it like everything else, and a row-spanning card (see
		   ProjectDef.rowSpan) has nothing on the side to run tall alongside —
		   the inline `grid-row` from rowSpan is overridden back to normal. */
		.project-row--solo-left,
		.project-row--solo-right {
			grid-column: 1 / -1;
			grid-row: auto !important;
		}

		/* The two boxes stack full-width instead of sitting side by side, so
		   there's no column gap left to bridge — drop the fill and let both
		   corners round, and both border lines draw, normally again. */
		.project-row--bridge-left.project-row--boxed::before {
			display: none;
		}

		.bridge-curve {
			display: none;
		}

		.project-row--bridge-left.project-row--boxed,
		.project-row--square-bottom-right.project-row--boxed {
			border-radius: 16px;
			border-left: 1px solid var(--row-line);
			border-right: 1px solid var(--row-line);
		}
	}

	/* Stagger the drifting sheen so adjacent boxes never glint in unison —
	   the cue reads as ambient life on the surfaces, not a synced blink. */
	.project-row--boxed:nth-child(3n + 2) {
		--sheen-delay: -3s;
	}

	.project-row--boxed:nth-child(3n + 3) {
		--sheen-delay: -6s;
	}
</style>
