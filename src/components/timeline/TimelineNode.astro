---
import type { TimelineEntry } from '../../data/timeline';
import type { Continuation } from './continuation';
import CompanyBlock from './CompanyBlock.astro';
import ApartBlock from './ApartBlock.astro';

interface Props {
	entry: TimelineEntry;
	continuation: Continuation;
	/** Set only on the entry that opens the Mentor Game Studio era — see ApartBlock's `showMentorHeader`. */
	showMentorHeader?: boolean;
}

const { entry, continuation, showMentorHeader = false } = Astro.props;
---

{
	entry.kind === 'together' ? (
		<CompanyBlock
			company={entry.company}
			squareTopLeft={continuation.squareTopLeft}
			squareTopRight={continuation.squareTopRight}
			squareBottomLeft={continuation.squareBottomLeft}
			squareBottomRight={continuation.squareBottomRight}
		/>
	) : (
		<ApartBlock
			mitko={entry.mitko}
			adam={entry.adam}
			mitkoContinuesAbove={continuation.mitkoAbove}
			mitkoContinuesBelow={continuation.mitkoBelow}
			adamContinuesAbove={continuation.adamAbove}
			adamContinuesBelow={continuation.adamBelow}
			showMentorHeader={showMentorHeader}
		/>
	)
}
