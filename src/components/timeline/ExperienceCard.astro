---
import type { PersonId } from '../../data/people';

interface Props {
	personId: PersonId;
	tagIds: string[];
	/** Resolved CSS color value for the `--person-color` custom property (e.g. `var(--mitko-color)` or `var(--accent-3)` when emphasized). */
	color: string;
	/** Which side of the timeline this card sits on — controls which edge gets the person-color accent border. */
	side: 'left' | 'right';
	category?: 'content' | 'system-feature';
	/** Optional showcase link (e.g. a YouTube video) — reveals an inline embed when the card is expanded. */
	link?: string;
	previewImage?: string;
	/**
	 * Whether this card sits inside a clickable row that opens a detail modal.
	 * Only interactive cards get the hover lift/glow; a static card (e.g. an
	 * unnamed, modal-less project like Ericsson) stays inert on hover so it
	 * doesn't imply a "Details" page that isn't there.
	 */
	interactive?: boolean;
}

const { personId, tagIds, color, side, link, previewImage, interactive = true } = Astro.props;
---

<div class:list={['card', `card--${side}`, { 'card--static': !interactive }]} data-person={personId} data-tags={tagIds.join(' ')} style={`--person-color: ${color}`}>
	<div class="content">
		<slot />
	</div>
	{
		link && (
			<div class="showcase">
				<button type="button" class="showcase-toggle" aria-expanded="false">
					<span class="chevron" aria-hidden="true">
						▸
					</span>{' '}
					Showcase
				</button>
				<div class="showcase-body">
					<div class="showcase-body-inner" data-showcase-embed data-link={link} data-preview-image={previewImage} />
				</div>
			</div>
		)
	}
</div>

<style>
	.card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--r-card);
		padding: 1.1rem 1.25rem;
		/* Grid contexts (ProjectRow's .experience-row) ignore this; flex
		   contexts (ApartBlock's .cards) use it to grow and fill a company
		   box that syncApartHeights.client.ts stretched taller than this
		   card's own natural content — see the chain of flex:1 in
		   ApartBlock.astro's .track-projects/.track-row/.cards. */
		flex: 1;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	/* Brighter, glowing silhouette on hover — the same strength as the
	   Projects cards and filter tags: a lift, a bright person-tinted halo and
	   a crisp accent ring. */
	.card:not(.card--static):hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--person-color, var(--accent)) 70%, var(--border));
		background: var(--bg-alt);
		box-shadow:
			0 10px 28px -12px rgba(0, 0, 0, 0.7),
			0 0 22px -2px color-mix(in srgb, var(--person-color, var(--accent)) 55%, transparent),
			0 0 0 1px color-mix(in srgb, var(--person-color, var(--accent)) 55%, transparent);
	}

	/* Pinned to their own column explicitly — not just left-to-right DOM
	   order — so that when a shared project's two cards sit side by side in
	   ProjectRow's 2-column .experience-row grid and the tag filter hides
	   one of them (display:none removes it from grid flow), the surviving
	   card stays in its own person's column instead of CSS Grid's default
	   auto-placement sliding it into the now-empty first column. Harmless
	   outside a grid context (e.g. ApartBlock's flex .cards list), where
	   grid-column has no effect. */
	/* The person-color accent rule sits on the card's *own* outer edge — the
	   side facing the person's own half of the layout — so the visual thread
	   stays with them rather than pointing at the empty middle. Mitko (left
	   column) → left edge; Ádám (right column) → right edge. */
	.card--left {
		grid-column: 1;
		border-left: 2px solid var(--person-color, var(--accent));
	}

	.card--right {
		grid-column: 2;
		border-right: 2px solid var(--person-color, var(--accent));
		text-align: right;
	}

	.card :global(p) {
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--fg);
		margin: 0;
	}

	.showcase {
		margin-top: 0.85rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
	}

	.showcase-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: inherit;
		font-size: 0.8rem;
		color: var(--accent-3);
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.showcase-toggle:hover {
		text-decoration: underline;
	}

	.showcase-toggle:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	.chevron {
		display: inline-block;
		transition: transform 0.2s ease;
	}

	.showcase-toggle[aria-expanded='true'] .chevron {
		transform: rotate(90deg);
	}

	.showcase-body {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 300ms ease;
	}

	.showcase-toggle[aria-expanded='true'] + .showcase-body {
		grid-template-rows: 1fr;
	}

	.showcase-body-inner {
		overflow: hidden;
	}

	.showcase-body-inner:not(:empty) {
		margin-top: 0.75rem;
	}

	.showcase-body-inner :global(iframe),
	.showcase-body-inner :global(img) {
		display: block;
		width: 100%;
		border-radius: 10px;
		border: 1px solid var(--border);
	}

	.showcase-body-inner :global(iframe) {
		aspect-ratio: 16 / 9;
		height: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.showcase-body {
			transition: none;
		}

		.card:hover {
			transform: none;
		}
	}

	@media (max-width: 900px) {
		/* ProjectRow's .experience-row collapses to a single column here, so
		   the explicit column pin above would otherwise force a phantom
		   second column back into existence — let cards stack naturally. */
		.card--left,
		.card--right {
			grid-column: auto;
		}

		/* Keep each person's accent on their own semantic side even in the
		   single-column mobile layout — left person stays left-accented,
		   right person stays right-accented — so the colored edge still
		   points toward the correct person regardless of layout. */
		.card--left {
			border-left: 2px solid var(--person-color, var(--accent));
			border-right: 1px solid var(--border);
		}

		.card--right {
			border-right: 2px solid var(--person-color, var(--accent));
			border-left: 1px solid var(--border);
		}

		.card {
			padding: var(--pad-card);
		}
	}
</style>
