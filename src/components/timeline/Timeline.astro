---
import Section from '../Section.astro';
import { timeline, MENTOR_ERA, type TimelineEntry } from '../../data/timeline';
import type { Continuation } from './continuation';
import TimelineNode from './TimelineNode.astro';
import MentorContainer from './MentorContainer.astro';

function entryHasMentor(entry: TimelineEntry): boolean {
	if (entry.kind === 'together') return entry.company.underMentor === true;
	return [...entry.mitko, ...entry.adam].some((c) => c.underMentor === true);
}

/**
 * Some real employers appear as two separate CompanyDef objects because the
 * fork/merge boundary falls mid-employment (see the big comment in
 * data/timeline.ts — Black Hole Entertainment, Primal Game Studio). Detect
 * those same-name pairs across consecutive entries so the two boxes can be
 * pulled flush together and styled as one continuing card instead of two
 * unrelated companies that happen to sit next to each other. See
 * ./continuation.ts for the shape produced here.
 */
function edgeCompanyNames(entry: TimelineEntry, edge: 'start' | 'end'): { mitko?: string; adam?: string; together?: string } {
	if (entry.kind === 'together') return { together: entry.company.name };
	const mitkoCo = edge === 'start' ? entry.mitko[0] : entry.mitko[entry.mitko.length - 1];
	const adamCo = edge === 'start' ? entry.adam[0] : entry.adam[entry.adam.length - 1];
	return { mitko: mitkoCo?.name, adam: adamCo?.name };
}

// The Mentor Game Studio container wraps every entry from the first
// underMentor entry through the last — derived from the data, not
// hand-maintained.
const mentorEntryIndexes = timeline.map((entry, i) => (entryHasMentor(entry) ? i : -1)).filter((i) => i >= 0);

const containerStart = mentorEntryIndexes.length ? mentorEntryIndexes[0] : -1;
const containerEnd = mentorEntryIndexes.length ? mentorEntryIndexes[mentorEntryIndexes.length - 1] : -1;

const continuations: Continuation[] = timeline.map(() => ({}));

timeline.forEach((entry, i) => {
	const prev = timeline[i - 1];
	if (!prev || prev.kind === entry.kind) return;

	const prevNames = edgeCompanyNames(prev, 'end');
	const currNames = edgeCompanyNames(entry, 'start');

	// Fork (shared company → two tracks): whichever track keeps the same
	// employer as the box above runs straight up into it. Square only that
	// side's shared corner, leaving the box closed over the track that
	// actually diverges.
	if (prev.kind === 'together' && entry.kind === 'apart') {
		if (prevNames.together && prevNames.together === currNames.mitko) {
			continuations[i - 1].togetherBelowLeft = true;
			continuations[i].mitkoAbove = true;
		}
		if (prevNames.together && prevNames.together === currNames.adam) {
			continuations[i - 1].togetherBelowRight = true;
			continuations[i].adamAbove = true;
		}
	}

	// Merge (two tracks → shared company): the track that keeps the same
	// employer flows down into the merged box.
	if (prev.kind === 'apart' && entry.kind === 'together') {
		if (prevNames.mitko && prevNames.mitko === currNames.together) {
			continuations[i - 1].mitkoBelow = true;
			continuations[i].togetherAbove = true;
		}
		if (prevNames.adam && prevNames.adam === currNames.together) {
			continuations[i - 1].adamBelow = true;
			continuations[i].togetherAbove = true;
		}
	}
});

// The Mentor Game Studio era is one continuous studio, so its column threads
// straight into the reunion (Together Again) even though that box is a
// different legal entity than Mitko's last solo-era employer — a seam plain
// name-matching won't catch. Force it: Mitko's mentor column flows down into
// Together Again on the left, while Ádám's side stays open above it (he is
// rejoining, not continuing).
if (containerStart >= 0 && timeline[containerEnd]?.kind === 'together' && timeline[containerEnd - 1]?.kind === 'apart') {
	continuations[containerEnd - 1].mitkoBelow = true;
	continuations[containerEnd].togetherAboveLeft = true;
}

// For each `together` card, work out who is newly joining vs continuing the
// same employer (top), and who is leaving vs continuing on (bottom) — from the
// adjacent apart entry's edge company on each track. Drives whether the name +
// join year / the leave year sit on one person's side or stay centered.
timeline.forEach((entry, i) => {
	if (entry.kind !== 'together') return;
	const name = entry.company.name;
	const prev = timeline[i - 1];
	const next = timeline[i + 1];
	const mitkoContinuesFromPrev = prev?.kind === 'apart' && prev.mitko[prev.mitko.length - 1]?.name === name;
	const adamContinuesFromPrev = prev?.kind === 'apart' && prev.adam[prev.adam.length - 1]?.name === name;
	const mitkoContinuesToNext = next?.kind === 'apart' && next.mitko[0]?.name === name;
	const adamContinuesToNext = next?.kind === 'apart' && next.adam[0]?.name === name;
	continuations[i].mitkoJoins = !mitkoContinuesFromPrev;
	continuations[i].adamJoins = !adamContinuesFromPrev;
	continuations[i].mitkoLeaves = Boolean(next) && !mitkoContinuesToNext;
	continuations[i].adamLeaves = Boolean(next) && !adamContinuesToNext;
});

const mentorLabelIdx = containerStart >= 0 && timeline[containerStart]?.kind === 'apart' ? containerStart : -1;

function withIdx(entries: TimelineEntry[], offset: number) {
	return entries.map((entry, i) => ({ entry, idx: offset + i }));
}

const before = containerStart >= 0 ? withIdx(timeline.slice(0, containerStart), 0) : withIdx(timeline, 0);
const contained = containerStart >= 0 ? withIdx(timeline.slice(containerStart, containerEnd + 1), containerStart) : [];
const after = containerStart >= 0 ? withIdx(timeline.slice(containerEnd + 1), containerEnd + 1) : [];
---

<Section id="timeline" title="Timeline" compact>
	<div class="filter-chip" id="timeline-filter-chip" hidden>
		<span class="filter-chip-label">Filtered by: <strong id="timeline-filter-chip-skill"></strong></span>
		<button type="button" class="filter-chip-clear" id="timeline-filter-chip-clear" aria-label="Clear filter">✕</button>
	</div>
	<div class="timeline">
		{
			before.map(({ entry, idx }) => (
				<TimelineNode
					entry={entry}
					continuation={continuations[idx]}
					mentorLabel={idx === mentorLabelIdx ? MENTOR_ERA.label : undefined}
					mentorDates={idx === mentorLabelIdx ? MENTOR_ERA.dateRange : undefined}
				/>
			))
		}
		{
			contained.length > 0 && (
				<MentorContainer>
					{contained.map(({ entry, idx }) => (
						<TimelineNode
							entry={entry}
							continuation={continuations[idx]}
							mentorLabel={idx === mentorLabelIdx ? MENTOR_ERA.label : undefined}
							mentorDates={idx === mentorLabelIdx ? MENTOR_ERA.dateRange : undefined}
						/>
					))}
				</MentorContainer>
			)
		}
		{
			after.map(({ entry, idx }) => (
				<TimelineNode
					entry={entry}
					continuation={continuations[idx]}
					mentorLabel={idx === mentorLabelIdx ? MENTOR_ERA.label : undefined}
					mentorDates={idx === mentorLabelIdx ? MENTOR_ERA.dateRange : undefined}
				/>
			))
		}
	</div>
</Section>

<style>
	.filter-chip {
		position: sticky;
		top: 5.5rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		align-self: center;
		margin-bottom: 1.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border-radius: 999px;
		background: var(--bg-alt);
		border: 1px solid var(--accent-3);
		box-shadow: 0 0 16px 2px var(--accent-soft);
		font-size: 0.85rem;
		transition:
			opacity 220ms ease,
			transform 220ms ease;
	}

	.filter-chip[hidden] {
		display: flex;
		opacity: 0;
		transform: translateY(-10px);
		pointer-events: none;
	}

	.filter-chip:not([hidden]) {
		opacity: 1;
		transform: translateY(0);
	}

	.filter-chip-label strong {
		color: var(--accent-3);
	}

	.filter-chip-clear {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: none;
		background: var(--accent-soft);
		color: var(--fg);
		cursor: pointer;
		font-size: 0.75rem;
		line-height: 1;
	}

	.filter-chip-clear:hover {
		background: var(--accent-3);
		color: var(--bg);
	}

	/* Filter-collapse transition states — global because they target elements
	   rendered by CompanyBlock/ApartBlock/ProjectRow/MentorContainer, not just
	   direct children here. Driven by src/scripts/timelineFilter.client.ts. */
	:global(.tf-hidden) {
		display: none !important;
	}

	:global(.tf-leaving) {
		opacity: 0 !important;
		transform: scale(0.92) !important;
		transition:
			opacity 200ms cubic-bezier(0.4, 0, 1, 1),
			transform 200ms cubic-bezier(0.4, 0, 1, 1) !important;
		pointer-events: none;
	}

	:global(.tf-enter-from) {
		opacity: 0;
		transform: scale(0.92);
	}

	:global(.card),
	:global(.node),
	:global(.project-row),
	:global(.track-row),
	:global(.company),
	:global(.track-company),
	:global(.apart),
	:global(.mentor-container) {
		transition:
			opacity 260ms ease,
			transform 260ms ease;
	}

	:global(.apart.apart--single) {
		grid-template-columns: 1fr;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		max-width: 1200px;
		width: 100%;
	}
</style>
