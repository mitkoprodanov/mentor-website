---
import Section from '../Section.astro';
import { timeline, MENTOR_ERA, type TimelineEntry } from '../../data/timeline';
import CompanyBlock from './CompanyBlock.astro';
import ApartBlock from './ApartBlock.astro';
import ForkConnector from './ForkConnector.astro';
import MentorContainer from './MentorContainer.astro';

type Node =
	| { type: 'connector'; direction: 'split' | 'merge' }
	| { type: 'entry'; entry: TimelineEntry };

function entryHasMentor(entry: TimelineEntry): boolean {
	if (entry.kind === 'together') return entry.company.underMentor === true;
	return [...entry.mitko, ...entry.adam].some((c) => c.underMentor === true);
}

// Flatten entries + the connectors between them (same logic as before: a
// connector appears wherever `kind` changes between consecutive entries)
// into one ordered list of renderable nodes.
const nodes: Node[] = [];
timeline.forEach((entry, index) => {
	const previous = timeline[index - 1];
	if (previous && previous.kind !== entry.kind) {
		nodes.push({ type: 'connector', direction: entry.kind === 'apart' ? 'split' : 'merge' });
	}
	nodes.push({ type: 'entry', entry });
});

// The Mentor Game Studio container wraps everything from the fork right
// before the first underMentor entry through the last underMentor entry —
// derived from the data, not hand-maintained.
const mentorEntryIndexes = nodes
	.map((n, i) => (n.type === 'entry' && entryHasMentor(n.entry) ? i : -1))
	.filter((i) => i >= 0);

const firstMentorIndex = mentorEntryIndexes[0];
const containerStart =
	mentorEntryIndexes.length === 0
		? -1
		: nodes[firstMentorIndex - 1]?.type === 'connector'
			? firstMentorIndex - 1
			: firstMentorIndex;
const containerEnd = mentorEntryIndexes.length ? mentorEntryIndexes[mentorEntryIndexes.length - 1] : -1;

const before = containerStart >= 0 ? nodes.slice(0, containerStart) : nodes;
const contained = containerStart >= 0 ? nodes.slice(containerStart, containerEnd + 1) : [];
const after = containerStart >= 0 ? nodes.slice(containerEnd + 1) : [];
---

<Section id="timeline" title="Timeline" compact>
	<div class="filter-chip" id="timeline-filter-chip" hidden>
		<span class="filter-chip-label">Filtered by: <strong id="timeline-filter-chip-skill"></strong></span>
		<button type="button" class="filter-chip-clear" id="timeline-filter-chip-clear" aria-label="Clear filter">✕</button>
	</div>
	<div class="timeline">
		{
			before.map((node) =>
				node.type === 'connector' ? (
					<ForkConnector direction={node.direction} />
				) : node.entry.kind === 'together' ? (
					<CompanyBlock company={node.entry.company} />
				) : (
					<ApartBlock mitko={node.entry.mitko} adam={node.entry.adam} />
				),
			)
		}
		{
			contained.length > 0 && (
				<MentorContainer label={MENTOR_ERA.label} dateRange={MENTOR_ERA.dateRange}>
					{contained.map((node) =>
						node.type === 'connector' ? (
							<ForkConnector direction={node.direction} />
						) : node.entry.kind === 'together' ? (
							<CompanyBlock company={node.entry.company} />
						) : (
							<ApartBlock mitko={node.entry.mitko} adam={node.entry.adam} />
						),
					)}
				</MentorContainer>
			)
		}
		{
			after.map((node) =>
				node.type === 'connector' ? (
					<ForkConnector direction={node.direction} />
				) : node.entry.kind === 'together' ? (
					<CompanyBlock company={node.entry.company} />
				) : (
					<ApartBlock mitko={node.entry.mitko} adam={node.entry.adam} />
				),
			)
		}
	</div>
</Section>

<style>
	.filter-chip {
		position: sticky;
		top: 5.5rem;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		align-self: center;
		margin-bottom: 1.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border-radius: 999px;
		background: var(--bg-alt);
		border: 1px solid var(--accent-3);
		box-shadow: 0 0 16px 2px var(--accent-soft);
		font-size: 0.85rem;
		transition:
			opacity 220ms ease,
			transform 220ms ease;
	}

	.filter-chip[hidden] {
		display: flex;
		opacity: 0;
		transform: translateY(-10px);
		pointer-events: none;
	}

	.filter-chip:not([hidden]) {
		opacity: 1;
		transform: translateY(0);
	}

	.filter-chip-label strong {
		color: var(--accent-3);
	}

	.filter-chip-clear {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: none;
		background: var(--accent-soft);
		color: var(--fg);
		cursor: pointer;
		font-size: 0.75rem;
		line-height: 1;
	}

	.filter-chip-clear:hover {
		background: var(--accent-3);
		color: var(--bg);
	}

	/* Filter-collapse transition states — global because they target elements
	   rendered by CompanyBlock/ApartBlock/ProjectRow/ForkConnector/MentorContainer,
	   not just direct children here. Driven by src/scripts/timelineFilter.client.ts. */
	:global(.tf-hidden) {
		display: none !important;
	}

	:global(.tf-leaving) {
		opacity: 0 !important;
		transform: scale(0.92) !important;
		transition:
			opacity 200ms cubic-bezier(0.4, 0, 1, 1),
			transform 200ms cubic-bezier(0.4, 0, 1, 1) !important;
		pointer-events: none;
	}

	:global(.tf-enter-from) {
		opacity: 0;
		transform: scale(0.92);
	}

	:global(.card),
	:global(.node),
	:global(.company),
	:global(.track-company),
	:global(.apart),
	:global(.mentor-container),
	:global(.fork-connector) {
		transition:
			opacity 260ms ease,
			transform 260ms ease;
	}

	:global(.apart.apart--single) {
		grid-template-columns: 1fr;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		max-width: 1200px;
		width: 100%;
		/* Reserved so MentorContainer's rail has a consistent gutter to sit in
		   without ever shifting the actual timeline content — see MentorContainer.astro. */
		padding-left: 2rem;
	}
</style>
