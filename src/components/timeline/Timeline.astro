---
import Section from '../Section.astro';
import { timeline, type TimelineEntry } from '../../data/timeline';
import type { Continuation } from './continuation';
import TimelineNode from './TimelineNode.astro';
import MentorContainer from './MentorContainer.astro';
import TrackConnector from './TrackConnector.astro';

function entryHasMentor(entry: TimelineEntry): boolean {
	if (entry.kind === 'together') return entry.company.underMentor === true;
	return [...entry.mitko, ...entry.adam].some((c) => c.underMentor === true);
}

/**
 * Some real employers appear as two separate CompanyDef objects because the
 * fork/merge boundary falls mid-employment (see the big comment in
 * data/timeline.ts — Black Hole Entertainment, Primal Game Studio). Detect
 * those same-name pairs across consecutive entries so the box that continues
 * can stay top-aligned in its fork row, skip a redundant join/leave-year
 * label, and get a TrackConnector bridging it to the box across the seam —
 * see ./continuation.ts for the shape produced here.
 */
function edgeCompanyNames(entry: TimelineEntry, edge: 'start' | 'end'): { mitko?: string; adam?: string; together?: string } {
	if (entry.kind === 'together') return { together: entry.company.name };
	const mitkoCo = edge === 'start' ? entry.mitko[0] : entry.mitko[entry.mitko.length - 1];
	const adamCo = edge === 'start' ? entry.adam[0] : entry.adam[entry.adam.length - 1];
	return { mitko: mitkoCo?.name, adam: adamCo?.name };
}

// The Mentor Game Studio container wraps every entry from the first
// underMentor entry through the last — derived from the data, not
// hand-maintained.
const mentorEntryIndexes = timeline.map((entry, i) => (entryHasMentor(entry) ? i : -1)).filter((i) => i >= 0);

const containerStart = mentorEntryIndexes.length ? mentorEntryIndexes[0] : -1;
const containerEnd = mentorEntryIndexes.length ? mentorEntryIndexes[mentorEntryIndexes.length - 1] : -1;

const continuations: Continuation[] = timeline.map(() => ({}));

timeline.forEach((entry, i) => {
	const prev = timeline[i - 1];
	if (!prev || prev.kind === entry.kind) return;

	const prevNames = edgeCompanyNames(prev, 'end');
	const currNames = edgeCompanyNames(entry, 'start');

	// Fork (shared company → two tracks): whichever track keeps the same
	// employer as the box above runs straight up into it.
	if (prev.kind === 'together' && entry.kind === 'apart') {
		if (prevNames.together && prevNames.together === currNames.mitko) {
			continuations[i].mitkoAbove = true;
		}
		if (prevNames.together && prevNames.together === currNames.adam) {
			continuations[i].adamAbove = true;
		}
	}

	// Merge (two tracks → shared company): the track that keeps the same
	// employer flows down into the merged box.
	if (prev.kind === 'apart' && entry.kind === 'together') {
		if (prevNames.mitko && prevNames.mitko === currNames.together) {
			continuations[i - 1].mitkoBelow = true;
		}
		if (prevNames.adam && prevNames.adam === currNames.together) {
			continuations[i - 1].adamBelow = true;
		}
	}
});

// The Mentor Game Studio era is one continuous studio, so its column threads
// straight into the reunion (Together Again) even though that box is a
// different legal entity than Mitko's last solo-era employer — a seam plain
// name-matching won't catch. Force it: Mitko's mentor column flows down into
// Together Again (a TrackConnector bridges them; see the markup below).
if (containerStart >= 0 && timeline[containerEnd]?.kind === 'together' && timeline[containerEnd - 1]?.kind === 'apart') {
	continuations[containerEnd - 1].mitkoBelow = true;
}

// Mirror each apart entry's mitkoAbove/mitkoBelow/adamAbove/adamBelow onto
// the together entry on the other side of that same seam, as a squared
// corner (see continuation.ts) — CompanyBlock only ever gets a single
// corner's radius zeroed, since (unlike ApartBlock's single-column boxes)
// there's no side of its full-width box that can be left completely alone.
timeline.forEach((entry, i) => {
	if (entry.kind !== 'together') return;
	const prev = timeline[i - 1];
	const next = timeline[i + 1];
	if (prev?.kind === 'apart') {
		if (continuations[i - 1].mitkoBelow) continuations[i].squareTopLeft = true;
		if (continuations[i - 1].adamBelow) continuations[i].squareTopRight = true;
	}
	if (next?.kind === 'apart') {
		if (continuations[i + 1]?.mitkoAbove) continuations[i].squareBottomLeft = true;
		if (continuations[i + 1]?.adamAbove) continuations[i].squareBottomRight = true;
	}
});

function withIdx(entries: TimelineEntry[], offset: number) {
	return entries.map((entry, i) => ({ entry, idx: offset + i }));
}

const before = containerStart >= 0 ? withIdx(timeline.slice(0, containerStart), 0) : withIdx(timeline, 0);
const contained = containerStart >= 0 ? withIdx(timeline.slice(containerStart, containerEnd + 1), containerStart) : [];
const after = containerStart >= 0 ? withIdx(timeline.slice(containerEnd + 1), containerEnd + 1) : [];

// The entry that opens the Mentor Game Studio era heads its "Mentor Game
// Studio" / date-range label (see ApartBlock's showMentorHeader).
const mentorLabelIdx = containerStart >= 0 && timeline[containerStart]?.kind === 'apart' ? containerStart : -1;

/**
 * Flattens a run of entries into render items, inserting a TrackConnector
 * wherever a continuation flag says one box flows straight into the next —
 * before a node if *it* continues from what's above it, after a node if
 * what continues is flowing into whatever's *next*. Kept generic (rather
 * than hardcoding specific boundary indexes) so it works the same whether
 * the pair happens to straddle the before/MentorContainer split or not.
 */
type RenderItem = { kind: 'node'; entry: TimelineEntry; idx: number } | { kind: 'connector'; side: 'left' | 'right'; emphasized: boolean };

function isEmphasized(entry: TimelineEntry, side: 'left' | 'right'): boolean {
	if (entry.kind === 'together') return entry.company.underMentor === true;
	const companies = side === 'left' ? entry.mitko : entry.adam;
	return companies.some((c) => c.underMentor === true);
}

function buildRenderList(items: { entry: TimelineEntry; idx: number }[]): RenderItem[] {
	const out: RenderItem[] = [];
	for (const { entry, idx } of items) {
		const c = continuations[idx];
		if (c.mitkoAbove) out.push({ kind: 'connector', side: 'left', emphasized: isEmphasized(entry, 'left') });
		if (c.adamAbove) out.push({ kind: 'connector', side: 'right', emphasized: isEmphasized(entry, 'right') });
		out.push({ kind: 'node', entry, idx });
		if (c.mitkoBelow) out.push({ kind: 'connector', side: 'left', emphasized: isEmphasized(entry, 'left') });
		if (c.adamBelow) out.push({ kind: 'connector', side: 'right', emphasized: isEmphasized(entry, 'right') });
	}
	return out;
}

const beforeItems = buildRenderList(before);
const containedItems = buildRenderList(contained);
const afterItems = buildRenderList(after);
---

<Section id="timeline" compact>
	<div class="timeline-header">
		<h2 class="section-title brand-heading">
			<button
				type="button"
				class="title-toggle btn-sheen"
				aria-label="Reverse timeline direction"
				aria-pressed="true"
				data-timeline-direction-toggle
			>
				<span class="title-toggle__text">Timeline</span>
				<span class="title-toggle__slot" aria-hidden="true">
					<span class="title-toggle__reel">
						{/* Down arrow — time flows top→bottom, oldest first (forward direction). */}
						<svg class="title-toggle__icon" viewBox="0 0 24 24" width="1em" height="1em">
							<path d="M12 4v14M12 18l-5-5M12 18l5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
						{/* Up arrow — time flows bottom→top, latest first (reversed direction). */}
						<svg class="title-toggle__icon" viewBox="0 0 24 24" width="1em" height="1em">
							<path d="M12 20V6M12 6l-5 5M12 6l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</span>
				</span>
			</button>
		</h2>
	</div>
	<div class="timeline" data-timeline data-reversed="true">
		<div class="timeline-shimmer" aria-hidden="true"></div>
		{
			beforeItems.map((item) =>
				item.kind === 'node' ? <TimelineNode entry={item.entry} continuation={continuations[item.idx]} /> : <TrackConnector side={item.side} emphasized={item.emphasized} />,
			)
		}
		{
			containedItems.length > 0 && (
				<MentorContainer>
					{containedItems.map((item) =>
						item.kind === 'node' ? (
							<TimelineNode entry={item.entry} continuation={continuations[item.idx]} showMentorHeader={item.idx === mentorLabelIdx} />
						) : (
							<TrackConnector side={item.side} emphasized={item.emphasized} />
						),
					)}
				</MentorContainer>
			)
		}
		{
			afterItems.map((item) =>
				item.kind === 'node' ? <TimelineNode entry={item.entry} continuation={continuations[item.idx]} /> : <TrackConnector side={item.side} emphasized={item.emphasized} />,
			)
		}
	</div>
</Section>

<style>
	.timeline-header {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 1360px;
		margin-bottom: 3rem;
	}

	.timeline-header .section-title {
		margin: 0;
		text-align: center;
	}

	/* The entire section title is the direction toggle — a single wide pill
	   in the site's clickable warm-accent language: soft tinted bg, slim
	   colored border, drifting sheen (see `.btn-sheen` in Layout.astro),
	   glowing halo on hover. Same visual vocabulary as the timeline's own
	   `.track-row--boxed` cards, sized up to match the section heading. */
	.title-toggle {
		--row-fill: color-mix(in oklab, var(--accent) 6%, var(--bg));
		--row-fill-hover: color-mix(in oklab, var(--accent) 12%, var(--bg-alt));
		--row-line: color-mix(in oklab, var(--accent) 32%, var(--border));
		--row-line-hover: color-mix(in oklab, var(--accent) 70%, var(--border));
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.10;
		display: inline-flex;
		align-items: center;
		gap: 0.8em;
		padding: 0.55em 1.4em;
		font: inherit;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		color: inherit;
		background: var(--row-fill);
		border: 1px solid var(--row-line);
		border-radius: 999px;
		cursor: pointer;
		isolation: isolate;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.title-toggle:hover,
	.title-toggle:focus-visible {
		background: var(--row-fill-hover);
		border-color: var(--row-line-hover);
		outline: none;
		box-shadow:
			0 10px 28px -14px rgba(0, 0, 0, 0.7),
			0 0 22px -2px rgba(255, 122, 0, 0.45),
			0 0 0 1px color-mix(in oklab, var(--accent) 55%, transparent);
	}

	.title-toggle__text {
		line-height: 1;
	}

	/* A fixed-size window into the two-icon reel; the reel translates inside
	   it to reveal whichever icon matches the current direction. Inline-block
	   (not inline-flex) so the reel inside is free to stack both icons to
	   its own natural height, and slot's overflow:hidden clips down to one. */
	.title-toggle__slot {
		display: inline-block;
		width: 0.85em;
		height: 0.85em;
		overflow: hidden;
		flex-shrink: 0;
		align-self: center;
		line-height: 0;
	}

	.title-toggle__reel {
		display: block;
		width: 100%;
		transform: translateY(0);
		transition: transform 0.4s cubic-bezier(0.5, 0, 0.2, 1);
	}

	/* Latest-first (reversed) — reveal the second (up-arrow) icon in the reel. */
	:global(html[data-reversed='true']) .title-toggle__reel {
		transform: translateY(-100%);
	}

	.title-toggle__icon {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		color: var(--accent-3);
	}

	/* On hover, the reel keeps cycling between the two icons — a soft ticker
	   telling the reader "this is a toggle: click me to swap." The animation
	   overrides the transform above via specificity from `.title-toggle:hover`,
	   so on unhover the reel eases straight back to whichever direction is
	   currently active. */
	.title-toggle:hover .title-toggle__reel,
	.title-toggle:focus-visible .title-toggle__reel {
		animation: title-toggle-reel 1.6s ease-in-out infinite;
	}

	@keyframes title-toggle-reel {
		0%, 40% {
			transform: translateY(0);
		}
		50%, 90% {
			transform: translateY(-100%);
		}
		100% {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.title-toggle,
		.title-toggle__reel {
			transition: none;
		}
		.title-toggle:hover .title-toggle__reel,
		.title-toggle:focus-visible .title-toggle__reel {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		.title-toggle {
			padding: 0.5em 1em;
			gap: 0.6em;
		}
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		/* Slightly wider than the rest of the site so single-person items
		   (an ApartBlock track, or a person-attributed media card) can offset
		   toward their own side and still leave breathing room on the other. */
		max-width: 1360px;
		width: 100%;
		position: relative;
	}

	.timeline[data-reversed='true'] {
		flex-direction: column-reverse;
	}

	/* Reverse the Mentor Game Studio era's inner run so the whole timeline
	   reads bottom-up as one unit, not one unit with a right-side-up island. */
	.timeline[data-reversed='true'] :global(.mentor-content) {
		flex-direction: column-reverse;
	}

	/* ---- Reversed-order seam fixes ---------------------------------------
	   The original polished layout squares off the corner where a
	   TrackConnector meets each box (see CompanyBlock's square-*-* and
	   ApartBlock's continues-above/below). Reversing the visual order flips
	   which edge the connector sits against, so every "top" cue needs to
	   act as a "bottom" cue and vice versa. These overrides swap the paired
	   sides purely visually — the data-side continuation flags stay put, and
	   the polished original direction remains the source of truth. */

	/* CompanyBlock corners: a top-squared corner is now the box's bottom
	   corner (the connector sits below it in reversed order) — and vice
	   versa. Restore the previously-flat corner's radius and drop the new
	   touching corner's. */
	.timeline[data-reversed='true'] :global(.company.square-top-left) {
		border-top-left-radius: 20px;
		border-bottom-left-radius: 0;
	}
	.timeline[data-reversed='true'] :global(.company.square-top-right) {
		border-top-right-radius: 20px;
		border-bottom-right-radius: 0;
	}
	.timeline[data-reversed='true'] :global(.company.square-bottom-left) {
		border-bottom-left-radius: 20px;
		border-top-left-radius: 0;
	}
	.timeline[data-reversed='true'] :global(.company.square-bottom-right) {
		border-bottom-right-radius: 20px;
		border-top-right-radius: 0;
	}

	/* When the .company sits inside a painted `.mentor-envelope--on` (see
	   CompanyBlock.astro), the seam rides on the envelope's own corners
	   instead of the .company's — swap top ↔ bottom on the envelope, same
	   pattern as the .company overrides above. */
	.timeline[data-reversed='true'] :global(.mentor-envelope--on.square-top-left) {
		border-top-left-radius: 24px;
		border-top: 1px solid var(--mentor-border);
		border-bottom-left-radius: 0;
		border-bottom: none;
	}
	.timeline[data-reversed='true'] :global(.mentor-envelope--on.square-top-right) {
		border-top-right-radius: 24px;
		border-top: 1px solid var(--mentor-border);
		border-bottom-right-radius: 0;
		border-bottom: none;
	}
	.timeline[data-reversed='true'] :global(.mentor-envelope--on.square-bottom-left) {
		border-bottom-left-radius: 24px;
		border-bottom: 1px solid var(--mentor-border);
		border-top-left-radius: 0;
		border-top: none;
	}
	.timeline[data-reversed='true'] :global(.mentor-envelope--on.square-bottom-right) {
		border-bottom-right-radius: 24px;
		border-bottom: 1px solid var(--mentor-border);
		border-top-right-radius: 0;
		border-top: none;
	}

	/* ApartBlock's own-column boxes: a `continues-above` box (border+radius
	   removed on its top, padding-top zeroed) is now meeting its connector on
	   its BOTTOM edge — swap the two sides. */
	.timeline[data-reversed='true'] :global(.track-company.continues-above) {
		border-top: 1px solid var(--border);
		border-top-left-radius: 16px;
		border-top-right-radius: 16px;
		padding-top: 1rem;
		border-bottom: none;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}
	.timeline[data-reversed='true'] :global(.track-company.continues-above .track-header) {
		padding-top: 0.25rem;
	}
	.timeline[data-reversed='true'] :global(.track-company.continues-below) {
		border-bottom: 1px solid var(--border);
		border-bottom-left-radius: 16px;
		border-bottom-right-radius: 16px;
		border-top: none;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	/* The Mentor envelope's own edges — same swap. */
	.timeline[data-reversed='true'] :global(.track.under-mentor.continues-above) {
		border-top: 1px solid var(--mentor-border);
		border-top-left-radius: 24px;
		border-top-right-radius: 24px;
		border-bottom: none;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}
	.timeline[data-reversed='true'] :global(.track.under-mentor.continues-below) {
		border-bottom: 1px solid var(--mentor-border);
		border-bottom-left-radius: 24px;
		border-bottom-right-radius: 24px;
		border-top: none;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	/* Reverse the internal run of each apart-block track so the companies
	   inside one person's column read bottom-up in step with the outer
	   timeline. This makes chronologically-latest boxes sit at the top —
	   Kreator Studios above Imagic above Flying Wild Hog inside Mitko's
	   Mentor envelope, Personal Project (Hypha/Biobot) above Primal
	   Continued (Mandragora) on Ádám's side — so the box that meets each
	   seam is the one the seam is actually about: Mandragora into Primal
	   2012–2021 below it, Kreator into Together Again above it.
	   `justify-content` (see the base rules in ApartBlock) then naturally
	   inverts under column-reverse — `flex-start` becomes "pack at bottom"
	   and `flex-end` becomes "pack at top" — which happens to be exactly
	   what each track needs in reversed: `.track.align-top` (a track that
	   continues from its neighbour) packs at the bottom to meet the seam
	   which is now below it, and default short tracks pack at the top toward
	   whatever's now above them. No extra override needed there. */
	.timeline[data-reversed='true'] :global(.track) {
		flex-direction: column-reverse;
	}

	/* Mitko's Mentor envelope is the exception: its base `flex-start`
	   (packing content at the envelope's top so it meets the "MENTOR GAME
	   STUDIO" heading) would flip to "pack at bottom" under column-reverse,
	   leaving a dead band above Kreator inside the envelope where the
	   connector to Together Again now enters. `flex-end` packs the content
	   flush against the (now-open) top edge instead, so the connector meets
	   the topmost card without any interior gap. */
	.timeline[data-reversed='true'] :global(.track.under-mentor) {
		justify-content: flex-end;
	}

	/* `.track.under-mentor` originally has a top nudge (`margin-top: 3rem`,
	   see ApartBlock) and a smaller `padding-top: 1rem` (leaving room for the
	   in-envelope "MENTOR GAME STUDIO" heading) than its `padding-bottom:
	   1.5rem`. Reversed, the seam moves to the top and the breathing room
	   moves to the bottom — swap both. The in-envelope heading is hidden
	   here anyway (the container-level `.mentor-era-heading--reversed`
	   carries the label), so the top padding no longer needs to reserve
	   space for it. */
	.timeline[data-reversed='true'] :global(.track.under-mentor) {
		margin-top: 0;
		margin-bottom: 3rem;
		padding-top: 1.5rem;
		padding-bottom: 1rem;
	}

	/* Mentor Game Studio label: in the polished forward direction the era's
	   opening entry (Mitko's Flying Wild Hog envelope) heads the label — see
	   ApartBlock's `.mentor-heading`. Reversed, the era opens on Together
	   Again instead, so hide the envelope-internal one and reveal the label
	   that lives inside the warm mentor envelope wrapping Together Again
	   (see CompanyBlock's `.mentor-envelope-heading`) — the label sits
	   *inside* the yellow envelope background, mirroring how the forward
	   label sits inside Mitko's own yellow envelope. */
	.timeline[data-reversed='true'] :global(.mentor-heading) {
		display: none;
	}
	.timeline[data-reversed='true'] :global(.mentor-envelope-heading) {
		display: flex;
	}

	.timeline-shimmer {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		z-index: 10;
		background: linear-gradient(
			110deg,
			transparent 0%,
			transparent 35%,
			rgba(255, 255, 255, 0.35) 48%,
			rgba(255, 255, 255, 0.7) 50%,
			rgba(255, 255, 255, 0.35) 52%,
			transparent 65%,
			transparent 100%
		);
		background-size: 300% 100%;
		background-position: 100% 0;
		mix-blend-mode: screen;
	}

	.timeline.is-flipping .timeline-shimmer {
		animation: timeline-glint 600ms ease-in-out;
	}

	@keyframes timeline-glint {
		0% {
			opacity: 0;
			background-position: 100% 0;
		}
		20% {
			opacity: 1;
		}
		80% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			background-position: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline.is-flipping .timeline-shimmer {
			animation: none;
		}
		.direction-toggle svg,
		.direction-toggle {
			transition: none;
		}
	}
</style>

<script>
	// The direction lives on <html> (so the skill-filter view, which sits
	// outside the timeline section, can react to the same flag) and is
	// mirrored onto the timeline element itself (so the timeline's scoped
	// CSS keeps its clean `.timeline[data-reversed]` selectors). The SSR
	// default in Layout.astro / Timeline.astro is "true" (latest first).
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-timeline-direction-toggle]');
	toggles.forEach((btn) => {
		const timeline = btn.closest('section')?.querySelector<HTMLElement>('[data-timeline]');
		if (!timeline) return;
		btn.addEventListener('click', () => {
			const nowReversed = document.documentElement.getAttribute('data-reversed') !== 'true';
			// Glint sweeps across; halfway through, swap the order so the
			// reordering happens under the brightest part of the sweep.
			timeline.classList.add('is-flipping');
			window.setTimeout(() => {
				const value = String(nowReversed);
				document.documentElement.setAttribute('data-reversed', value);
				timeline.setAttribute('data-reversed', value);
				btn.setAttribute('aria-pressed', value);
			}, 220);
			window.setTimeout(() => {
				timeline.classList.remove('is-flipping');
			}, 650);
		});
	});
</script>
