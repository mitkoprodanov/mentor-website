---
import type { CompanyDef } from '../../data/timeline';
import { parseDateRange, isOngoing } from './dateRange';
import ProjectRow from './ProjectRow.astro';

interface Props {
	company: CompanyDef;
	/** A TrackConnector bridges into exactly this one corner (see Timeline.astro/continuation.ts) — squaring off just its radius, leaving the rest of this full-width box's corners rounded as normal. Only the radius comes off, not the border line itself: that still runs the full width, since (unlike ApartBlock's single-column boxes) there's no clean way to remove just half of it without affecting the untouched side. */
	squareTopLeft?: boolean;
	squareTopRight?: boolean;
	squareBottomLeft?: boolean;
	squareBottomRight?: boolean;
}

const { company, squareTopLeft = false, squareTopRight = false, squareBottomLeft = false, squareBottomRight = false } = Astro.props;
const emphasized = company.underMentor === true;

const { start, end } = parseDateRange(company.dateRange);

/**
 * Join/leave events are shown per person: the company name + start year where
 * someone *joins*, the end year where they *leave*. A squared corner marks a
 * side that continues across the seam (see continuation.ts) — a squared top
 * means that person was already here (flowed in from the box above), so this
 * isn't where they joined; a squared bottom means they carry on past this box,
 * so it isn't where they left. Mitko is the left column, Ádám the right.
 */
const leftJoins = !squareTopLeft;
const rightJoins = !squareTopRight;
const ongoing = isOngoing(end);
const leftLeaves = !squareBottomLeft && !ongoing;
const rightLeaves = !squareBottomRight && !ongoing;

// An event shared by both sides sits centered across the full-width box; one
// that concerns a single person moves to that person's own column; null when
// neither side has the event (both continue across the seam — nothing to show).
// A Mentor-era together entry (Together Again) is a reunion in its own right,
// even though Mitko's mentor stream flows continuously into it from above —
// the moment reads narratively as both people meeting again, so the header
// sits centered like Primal 2012's start-together does, not off to Ádám's side
// alone.
const startSide = emphasized ? 'center' : leftJoins && rightJoins ? 'center' : leftJoins ? 'left' : rightJoins ? 'right' : null;
const endSide = leftLeaves && rightLeaves ? 'center' : leftLeaves ? 'left' : rightLeaves ? 'right' : null;
---

<div
	class="mentor-envelope"
	class:list={{
		/* The warm-tinted wrapper only paints when this is a Mentor-era
		   together entry (currently just Together Again). For every other
		   company the wrapper collapses to a bare passthrough — no bg, no
		   border, no padding (see the CSS below) — so nothing changes for
		   non-Mentor entries. */
		'mentor-envelope--on': emphasized,
		/* A TrackConnector bridges into this outer envelope, not the inner
		   .company box (which stays fully rounded like every other neutral
		   card) — so the square-*-* class rides on the wrapper here (see
		   .mentor-envelope--on.square-* below). Reversed-mode swaps these
		   sides via the overrides in Timeline.astro, the same way it does
		   for the plain .company class. */
		'square-top-left': emphasized && squareTopLeft,
		'square-top-right': emphasized && squareTopRight,
		'square-bottom-left': emphasized && squareBottomLeft,
		'square-bottom-right': emphasized && squareBottomRight,
	}}
	hidden={false}
>
<div
	class="company"
	data-company-id={company.id}
	class:list={{
		emphasized,
		/* When the mentor envelope carries the seam (see above), the inner
		   .company stays fully rounded — nothing squares off here. */
		'square-top-left': !emphasized && squareTopLeft,
		'square-top-right': !emphasized && squareTopRight,
		'square-bottom-left': !emphasized && squareBottomLeft,
		'square-bottom-right': !emphasized && squareBottomRight,
	}}
>
	{
		startSide && (
			<div class:list={['company-header', `company-header--${startSide}`]}>
				<span class="company-year">{start}</span>
				<h3 class:list={{ emphasized }}>{company.name}</h3>
			</div>
		)
	}
	<div class="company-projects">
		{company.projects.map((project) => <ProjectRow project={project} emphasized={emphasized} dateRange={company.dateRange} />)}
	</div>
	{
		endSide && (
			<div class:list={['company-footer', `company-footer--${endSide}`]}>
				<span class="company-year">{end}</span>
			</div>
		)
	}
</div>
</div>

<style>
	/* By default the wrapper is a bare passthrough — no bg, no border, no
	   padding — so every non-Mentor company renders exactly as before.
	   `mentor-envelope--on` paints the warm-tinted outer envelope around the
	   inner .company card, mirroring the way `.track.under-mentor` in
	   ApartBlock encloses Mitko's Mentor-era employers (Flying Wild Hog etc.)
	   in their own warm envelope with a neutral card inside. */
	.mentor-envelope {
		width: 100%;
	}

	.mentor-envelope--on {
		background: var(--mentor-bg);
		border: 1px solid var(--mentor-border);
		border-radius: 24px;
		padding: 1rem;
	}

	/* A TrackConnector meets the envelope, not the inner card — square off
	   just the envelope's touching corner and remove that side's border line
	   so the connector fills flush. Reversed-mode swaps top ↔ bottom via the
	   overrides in Timeline.astro. */
	.mentor-envelope--on.square-top-left {
		border-top-left-radius: 0;
		border-top: none;
	}
	.mentor-envelope--on.square-top-right {
		border-top-right-radius: 0;
		border-top: none;
	}
	.mentor-envelope--on.square-bottom-left {
		border-bottom-left-radius: 0;
		border-bottom: none;
	}
	.mentor-envelope--on.square-bottom-right {
		border-bottom-right-radius: 0;
		border-bottom: none;
	}

	.company {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--bg-alt);
		padding: 1.25rem 1.5rem 1.5rem;
	}

	/* A Mentor-era together entry (Together Again) belongs to the Mentor
	   Game Studio container above it — it should read as one of the studio's
	   employers, not as the studio itself. Same pattern as Flying Wild Hog's
	   `.track-company` inside the Mitko-side under-mentor envelope (see
	   ApartBlock.astro): drop the box back to the neutral card background,
	   let the warm mentor tint stay on the heading text only (see the h3
	   rule below). */
	.company.emphasized {
		background: var(--bg-alt);
		border-color: var(--border);
	}

	.company.square-top-left {
		border-top-left-radius: 0;
	}

	.company.square-top-right {
		border-top-right-radius: 0;
	}

	.company.square-bottom-left {
		border-bottom-left-radius: 0;
	}

	.company.square-bottom-right {
		border-bottom-right-radius: 0;
	}

	/* The company name + start year mark where someone *joins* this shared
	   company; the end year at the bottom marks where they *leave*. A join or
	   leave shared by both people sits centered across the full-width box; one
	   that concerns a single person (the other was already here / carries on
	   past) aligns to that person's own column — left for Mitko, right for
	   Ádám. See the startSide/endSide logic above. */
	.company-header {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.25rem 0 1.5rem;
	}

	.company-footer {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 1.5rem 0 0.25rem;
	}

	.company-header--center {
		align-items: center;
		text-align: center;
	}

	.company-header--left {
		align-items: flex-start;
		text-align: left;
	}

	.company-header--right {
		align-items: flex-end;
		text-align: right;
	}

	.company-footer--center {
		align-items: center;
	}

	.company-footer--left {
		align-items: flex-start;
	}

	.company-footer--right {
		align-items: flex-end;
	}

	.company-year {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.05em;
		color: var(--fg-muted);
	}

	.company-header h3 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.85rem;
		color: var(--fg);
	}

	.company-header h3.emphasized {
		color: var(--mentor);
		text-shadow: 0 0 14px var(--mentor-soft);
	}

	/* Two-column grid so a solo project can sit in just its person's column,
	   and two opposite-side solo projects from the same period pack side by
	   side (grid-auto-flow: dense), top-aligned. Full-width projects span
	   both columns. */
	.company-projects {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: start;
		grid-auto-flow: dense;
		gap: 1.5rem 1.25rem;
	}

	@media (max-width: 900px) {
		.company-projects {
			grid-template-columns: 1fr;
		}
	}
</style>
