---
import type { CompanyDef } from '../../data/timeline';
import ProjectRow from './ProjectRow.astro';

interface Props {
	company: CompanyDef;
	/** This company is the same real employer as the entry immediately above/below a fork or merge (see data/timeline.ts) — style the seam as one continuing entity rather than two unrelated companies. */
	continuesAbove?: boolean;
	continuesBelow?: boolean;
}

const { company, continuesAbove = false, continuesBelow = false } = Astro.props;
const emphasized = company.underMentor === true;
---

<div class="company" class:list={{ 'continues-above': continuesAbove, 'continues-below': continuesBelow }}>
	<div class="company-header">
		<h3 class:list={{ emphasized }}>{company.name}</h3>
		<p class="company-dates">
			{company.dateRange}
			{continuesAbove && <span class="continued-tag">continued</span>}
		</p>
	</div>
	<div class="company-projects">
		{company.projects.map((project) => <ProjectRow project={project} emphasized={emphasized} />)}
	</div>
</div>

<style>
	.company {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--bg-alt);
		padding: 1.5rem 1.5rem 2rem;
	}

	.company.continues-above {
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	.company.continues-below {
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.company-header {
		text-align: center;
		padding: 0.5rem 0 1.75rem;
	}

	.company-header h3 {
		margin: 0 0 0.15rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.85rem;
		color: var(--fg);
	}

	.company-header h3.emphasized {
		color: var(--accent-3);
		text-shadow: 0 0 12px var(--accent-soft);
	}

	.company-dates {
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		color: var(--fg-muted);
	}

	.continued-tag {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-3);
		border: 1px solid var(--accent-3);
		border-radius: 999px;
		padding: 0.1rem 0.45rem;
	}

	.company-projects {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
</style>
