---
import { getEntry, render } from 'astro:content';
import { getPerson, type PersonId } from '../../data/people';
import { getTag, sortTagIdsByIndex } from '../../data/tags';
import { PLACEHOLDER_MEDIA } from '../../data/projects';
import { MENTOR_ERA, type CompanyDef } from '../../data/timeline';
import { parseDateRange, isOngoing } from './dateRange';
import ExperienceCard from './ExperienceCard.astro';
import ProjectModal from '../projects/ProjectModal.astro';

interface Props {
	mitko: CompanyDef[];
	adam: CompanyDef[];
	/** This track's first/last company is the same real employer as the entry immediately above/below the fork or merge bounding this apart block (see data/timeline.ts) — a TrackConnector bridges the gap, and this box's own touching edge is squared off flush so the two read as one continuous card. */
	mitkoContinuesAbove?: boolean;
	mitkoContinuesBelow?: boolean;
	adamContinuesAbove?: boolean;
	adamContinuesBelow?: boolean;
	/** Set only on the entry that opens the Mentor Game Studio era — heads
	 * the "Mentor Game Studio" / date-range label at the top of whichever
	 * track is wholly under the Mentor banner here (see .track.under-mentor
	 * below; currently always Mitko's, since Ádám's Mentor-era work — if
	 * any — lives in its own separate entry, see data/timeline.ts). */
	showMentorHeader?: boolean;
}

const {
	mitko,
	adam,
	mitkoContinuesAbove = false,
	mitkoContinuesBelow = false,
	adamContinuesAbove = false,
	adamContinuesBelow = false,
	showMentorHeader = false,
} = Astro.props;

const sides = [
	{ person: 'mitko' as PersonId, side: 'left' as const, companies: mitko, continuesAbove: mitkoContinuesAbove, continuesBelow: mitkoContinuesBelow },
	{ person: 'adam' as PersonId, side: 'right' as const, companies: adam, continuesAbove: adamContinuesAbove, continuesBelow: adamContinuesBelow },
];

const tracks = await Promise.all(
	sides.map(async (side) => {
		const companies = await Promise.all(
			side.companies.map(async (company) => {
				const projects = await Promise.all(
					company.projects.map(async (project) => {
						const cards = await Promise.all(
							project.experiences.map(async (ref) => {
								const entry = await getEntry('experiences', ref.slug);
								if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
								const { Content } = await render(entry);
								return {
									person: getPerson(ref.person),
									Content,
									tagIds: ref.tagIds ?? [],
									link: entry.data.link,
									previewImage: entry.data.previewImage,
								};
							}),
						);
						// Detail-modal data (see ProjectRow.astro for the same shape) —
						// only named projects render a clickable node/modal.
						return {
							project,
							cards,
							modalId: `tl-${project.id}`,
							modalDateRange: project.dateRange ?? company.dateRange,
							peopleLabel: cards.map((c) => c.person.name).join(' & '),
							// Ordered by each tag's canonical index in data/tags.ts so the
							// pill row always reads in that order regardless of which
							// experience contributed the tag.
							modalTagLabels: sortTagIdsByIndex([...new Set(cards.flatMap((c) => c.tagIds))]).map((id) => getTag(id).label),
							modalMedia: project.media ?? PLACEHOLDER_MEDIA,
						};
					}),
				);
				return { company, projects };
			}),
		);
		return { ...side, companies };
	}),
);
---

<div
	class:list={[
		'apart',
		{
			/* One side of this apart row is structurally empty (e.g.
			   Mandragora-only, or Mentor-only) — the sole present track
			   extends its inner edge to the site's centre line, so a lone
			   company card doesn't sit floating off in its own outer column. */
			'apart--solo-left': mitko.length > 0 && adam.length === 0,
			'apart--solo-right': adam.length > 0 && mitko.length === 0,
		},
	]}
>
	{
		tracks.map((track) => {
			const underMentor = track.companies.length > 0 && track.companies.every((c) => c.company.underMentor === true);
			return (
			<div
				class:list={[
					'track',
					`track-${track.side}`,
					{
						'under-mentor': underMentor,
						/* A track that continues up from the shared company above stays
						   top-aligned so it meets that seam; any other short track sinks
						   to the bottom of the fork, next to whatever follows it (e.g.
						   Ericsson dropping down toward Black Hole). A track can also be
						   structurally empty (e.g. Ádám's side of the Mandragora-only
						   entry, or Mitko's side of the Mentor-only entry) — it just
						   renders nothing and takes no space, leaving the other track in
						   its own proper column against the plain page background. */
						'align-top': track.continuesAbove,
						/* When this track is its own enclosed envelope, the envelope
						   itself — not the individual card inside it — is what visually
						   flows into the neighbour via a TrackConnector, so it's the
						   envelope's own edge that squares off here (see the individual
						   track-company below, which stays a normal, fully-rounded,
						   self-contained card in that case). */
						'continues-above': underMentor && track.continuesAbove,
						'continues-below': underMentor && track.continuesBelow,
					},
				]}
			>
				{underMentor && showMentorHeader && track.person === 'mitko' && (
					<div class="mentor-heading">
						<span class="mentor-dates">{MENTOR_ERA.start} – {MENTOR_ERA.end}</span>
						<span class="mentor-name">{MENTOR_ERA.label}</span>
					</div>
				)}
				{/* The Mentor era's START year (2022) at the era's visual
				    bottom in the current reversed timeline — inside the yellow
				    envelope, right below whichever mentor company sits last
				    (currently Flying Wild Hog), mirroring how the era's END
				    year ("Present") + MENTOR GAME STUDIO label sit inside
				    Together Again's envelope at the visual top of the era.
				    Placed at DOM top of `.track.under-mentor` so it renders
				    visually last under the reversed-mode `flex-direction:
				    column-reverse` on `.track` (see Timeline.astro). Hidden
				    by default; revealed by the reversed override there. */}
				{underMentor && showMentorHeader && track.person === 'mitko' && (
					<div class="mentor-era-start-year" aria-hidden="true">
						<span class="mentor-dates">{MENTOR_ERA.start}</span>
					</div>
				)}
				{track.companies.map(({ company, projects }, companyIndex) => {
					// An apart track is one person's alone, so every join/leave here is
					// theirs — shown on their own side. The exception is the seam into a
					// neighbouring box that's the same real employer (the first company
					// continuing up from a shared box above, or the last continuing down
					// into one below — see continuation.ts): no join/leave happened there,
					// so that marker is suppressed. An ongoing ("Present") stint has no
					// leave event yet either.
					const { start, end } = parseDateRange(company.dateRange);
					// Each company card is self-describing: it always shows its
					// own LEAVE year (end, at the visual top of the card alongside
					// the company name) and JOIN year (start, at the visual
					// bottom), rendered straight from its own dateRange without
					// being suppressed by adjacency to a same-employer neighbour
					// across a fork/merge seam. That way Kreator's `2025 – 2026`
					// shows 2026 at its own edge even though Mitko continues into
					// Together Again below it, matching how the Mentor era's
					// envelope anchors its own start and end years to its own
					// edges (see MENTOR_ERA in data/timeline.ts). An ongoing
					// ("Present") stint still suppresses its end label — there's
					// no leave event yet.
					const showStart = true;
					const showEnd = !isOngoing(end);
					return (
					<div
						class="track-company"
						data-company-id={company.id}
						data-stretch-to-middle-of={company.stretchToMiddleOf}
						data-stretch-near-top-of={company.stretchNearTopOf?.id}
						data-stretch-gap={company.stretchNearTopOf?.gap}
						data-align-bottom-to={company.alignBottomTo}
						class:list={{
							emphasized: company.underMentor === true,
							/* Each company is always its own separate, fully-rounded,
							   self-contained box — consecutive companies within the same
							   track get their own normal spacing rather than being fused
							   into one continuous card. The edge seam into a TrackConnector
							   (first/last company, matching the entry outside this
							   ApartBlock — see Timeline.astro) only squares this individual
							   card off when there's no enclosing envelope to do it instead
							   (see under-mentor above) — an under-mentor track's envelope is
							   what flows into the connector, not the card sitting inside it. */
							'continues-above': !underMentor && companyIndex === 0 && track.continuesAbove,
							'continues-below': !underMentor && companyIndex === track.companies.length - 1 && track.continuesBelow,
						}}
					>
						{/* Top of the card (visually top in the current reversed
						    timeline): the company NAME + the LEAVE year (end).
						    The name is the card's title and always shows; the
						    year is omitted when this box is ongoing ("Present") or
						    flows via a same-employer seam into the box beside it
						    — see showEnd above. */}
						<div class={`track-header track-header--${track.side}`}>
							{showEnd && <span class="track-year">{end}</span>}
							<h4 class:list={{ emphasized: company.underMentor === true }}>{company.name}</h4>
						</div>
						<div class="track-projects">
							{projects.map(({ project, cards, modalId, modalDateRange, peopleLabel, modalTagLabels, modalMedia }) => (
								<div
								class="track-row"
								class:list={{
									'track-row--boxed': Boolean(project.name),
									'btn-sheen': Boolean(project.name),
									/* A boxed row that's the one being stretched (see
									   CompanyDef.stretchToMiddleOf/stretchNearTopOf/
									   alignBottomTo) has its own bottom padding stacking on
									   top of .track-company's, leaving noticeably more dead
									   space below the card than an unboxed company's single
									   layer of padding — see .track-row--fill-stretch below. */
									'track-row--fill-stretch': Boolean(company.stretchToMiddleOf || company.stretchNearTopOf || company.alignBottomTo),
								}}
							>
									{
										project.name && (
											<div class="node">
												<div class="node-text">
													<h5 class="node-label">{project.name}</h5>
													{project.info && <p class="node-info">{project.info}</p>}
												</div>
											</div>
										)
									}
									<div class="cards">
										{cards.map((card) => (
											<ExperienceCard
												personId={card.person.id}
												tagIds={card.tagIds}
												color={`var(--${card.person.id}-color)`}
												side={track.side}
												link={card.link}
												previewImage={card.previewImage}
												interactive={Boolean(project.name)}
											>
												<card.Content />
											</ExperienceCard>
										))}
									</div>
									{
										project.name && (
											<button
												type="button"
												class="row-open"
												data-project-open={modalId}
												aria-haspopup="dialog"
												aria-label={`Open details for ${project.name}`}
											/>
										)
									}
									{
										project.name && (
											<ProjectModal
												modalId={modalId}
												title={project.name}
												subtitle={project.info}
												dateRange={modalDateRange}
												people={cards.length > 1 ? peopleLabel : undefined}
												personIds={cards.map((c) => c.person.id)}
												tags={modalTagLabels}
												media={modalMedia}
											>
												{cards.map((c) => (
													<div class="modal-exp" data-person={c.person.id}>
														<c.Content />
													</div>
												))}
											</ProjectModal>
										)
									}
								</div>
							))}
						</div>
						{/* Bottom of the card (visually bottom in the current
						    reversed timeline): the JOIN year (start), on this
						    person's own side. */}
						{showStart && (
							<div class={`track-footer track-footer--${track.side}`}>
								<span class="track-year">{start}</span>
							</div>
						)}
					</div>
					);
				})}
			</div>
			);
		})
	}
</div>

<style>
	.apart {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2rem;
	}

	/* When only one person has a company in this row (the other side is
	   structurally empty — Mandragora-only or Mentor-only, see the
	   file-level comment in data/timeline.ts), the lone track extends
	   inward to the site's centre line so its inner edge sits exactly at
	   the middle instead of floating off in its own outer column. */
	.apart--solo-left .track-left {
		grid-column: 1 / -1;
		padding-right: 50%;
	}

	.apart--solo-right .track-right {
		grid-column: 1 / -1;
		padding-left: 50%;
	}

	.track {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
		/* Short tracks sink to the bottom of the fork so they sit next to
		   whatever follows (Ericsson dropping toward Black Hole); a track that
		   continues up from the company above overrides this to stay at the top. */
		justify-content: flex-end;
	}

	.track.align-top {
		justify-content: flex-start;
	}

	/* A track that's wholly under the Mentor Game Studio banner (every
	   company in it) gets its own enclosing envelope, confined to just this
	   column — the other person's column (e.g. Ádám's Primal Game Studio/
	   Mandragora, sharing this same row) stays plain page background rather
	   than sharing one full-width tinted box, since they're not part of
	   Mentor Game Studio during this stretch. .apart's grid stretches both
	   tracks to the row's full height by default, so this always top-aligns
	   regardless of continuesAbove — a headed, enveloped section should
	   start from its own top, not wherever flex-end's default would land it
	   — which is what keeps its date level with whatever's sharing its row. */
	.track.under-mentor {
		justify-content: flex-start;
		/* Nudges the whole envelope down a bit from the very top of the row,
		   off of being perfectly flush with Ádám's side. */
		margin-top: 3rem;
		background: var(--mentor-bg);
		border: 1px solid var(--mentor-border);
		border-radius: 24px;
		padding: 1rem 1.5rem 1.5rem;
	}

	/* Edge seam into a TrackConnector (see Timeline.astro): the envelope is
	   a single column with nothing on the other side to preserve, so — like
	   ApartBlock's plain track-company boxes, unlike CompanyBlock's shared
	   full-width box — the whole touching border/corner can safely come
	   off, leaving a fully open edge for the connector to fill. The
	   individual card(s) inside stay untouched, fully rounded and closed. */
	.track.under-mentor.continues-above {
		border-top: none;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	.track.under-mentor.continues-below {
		border-bottom: none;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.mentor-heading {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0 0 0.25rem;
	}

	/* The Mentor era's START year label at the visual bottom of Mitko's
	   under-mentor envelope in the current reversed timeline (see the markup
	   above for why it's at DOM top). Hidden by default; the reversed
	   override in Timeline.astro turns it on. Padding goes above the year
	   (visually) so it sits close to the yellow envelope's bottom edge. */
	.mentor-era-start-year {
		display: none;
		padding: 0.5rem 0 0;
	}

	.mentor-name {
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--mentor);
		text-shadow: 0 0 14px var(--mentor-soft);
	}

	.mentor-dates {
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.05em;
		color: var(--fg-muted);
	}

	.track-company {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--bg-alt);
		padding: 1rem 1rem 1.25rem;
	}

	/* Mentor-era companies live inside the warm-tinted `.track.under-mentor`
	   envelope, so the inner company box drops back to the neutral
	   default — the envelope carries the studio's colour; the inner card
	   reads like any other company slot within it. */
	.track-company.emphasized {
		background: var(--bg-alt);
		border-color: var(--border);
	}

	/* Date range (with the name) at the top, aligned to this person's own
	   side — every company always shows its own, even ones that flow
	   straight out of the box above via a TrackConnector. */
	.track-year {
		display: block;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.05em;
		color: var(--fg-muted);
	}

	/* Edge seam into a TrackConnector (see Timeline.astro): this box is a
	   single column with nothing on the other side to preserve, so — unlike
	   CompanyBlock's full-width box — the whole touching border/corner can
	   safely come off, leaving a fully open edge for the connector to fill.
	   With no border-top framing it anymore, the box's normal top padding
	   reads as extra empty space above the date/name (e.g. Primal Game
	   Studio flowing into Ádám's Mandragora box) — trimmed down here to sit
	   closer to how a normal, fully-framed box like Together Again reads. */
	.track-company.continues-above {
		border-top: none;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
		padding-top: 0;
	}

	/* .track-header's own top padding stacks on top of the box's — trimmed
	   too so the date/name sit right near the top of a continues-above box. */
	.track-company.continues-above .track-header {
		padding-top: 0;
	}

	.track-company.continues-below {
		border-bottom: none;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.track-header {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.25rem 0 0.5rem;
	}

	.track-header--left {
		align-items: flex-start;
		text-align: left;
	}

	.track-header--right {
		align-items: flex-end;
		text-align: right;
	}

	/* The end year sits at the very bottom of the card, on this person's own
	   side — the leave event for this stint. .track-projects' flex:1 (above)
	   pushes it flush to the bottom edge even when the box is stretched taller
	   than its content (see CompanyDef.stretchToMiddleOf). */
	.track-footer {
		display: flex;
		padding: 0.75rem 0 0;
	}

	.track-footer--left {
		justify-content: flex-start;
	}

	.track-footer--right {
		justify-content: flex-end;
	}

	.track-header h4 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: var(--fg);
	}

	.track-header h4.emphasized {
		color: var(--mentor);
		text-shadow: 0 0 14px var(--mentor-soft);
	}

	/* A company stretched taller than its own content by
	   syncApartHeights.client.ts (see CompanyDef.stretchToMiddleOf) would
	   otherwise just leave that extra height as blank space below its
	   content, inside .track-company's own border — flex:1 the whole way
	   down this chain (.track-projects → .track-row → .cards → .card, the
	   last of those in ExperienceCard.astro) lets the actual card grow to
	   fill it instead. A no-op for every other, naturally-sized company:
	   flex-grow only has anything to distribute when a min-height above it
	   actually created leftover space. */
	.track-projects {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 1.25rem;
	}

	.track-row {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.85rem;
		/* A clickable boxed row (one person's own detailed project) reads as an
		   action surface, exactly like the shared `together` rows in
		   ProjectRow.astro: soft warm-accent tint + colored slim border, plus
		   the drifting sheen below. An apart track belongs to one person by
		   construction (the whole track is Mitko-only or Ádám-only — see
		   .track-left / .track-right below), so the row's tint locks to that
		   person's own color regardless of era. The Mentor Game Studio
		   envelope keeps the studio's warm gold identity (see
		   .track.under-mentor above); the inner project boxes still belong to
		   Mitko and read as his color, not the studio's. */
		--row-accent: var(--accent);
		--row-fill: color-mix(in oklab, var(--row-accent) 6%, var(--bg));
		--row-fill-hover: color-mix(in oklab, var(--row-accent) 11%, var(--bg-alt));
		--row-line: color-mix(in oklab, var(--row-accent) 32%, var(--border));
		--row-line-hover: color-mix(in oklab, var(--row-accent) 70%, var(--border));
		--row-glow: color-mix(in oklab, var(--row-accent) 45%, transparent);
		--row-ring: color-mix(in oklab, var(--row-accent) 55%, transparent);
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.07;
	}

	.track-left .track-row {
		--row-accent: var(--mitko-color);
	}

	.track-right .track-row {
		--row-accent: var(--adam-color);
	}

	.track-row--boxed {
		border: 1px solid var(--row-line);
		border-radius: 14px;
		background: var(--row-fill);
		padding: 1rem;
	}

	.cards {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.85rem;
	}

	/* The project name (and its dot) sits centered in the row — see the
	   matching block in ProjectRow.astro. */
	.node {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 0.6rem;
	}

	.node-text {
		text-align: center;
	}

	/* The whole boxed row is the click target: a transparent <button> stretched
	   over the row (below each experience card's own Showcase controls, which
	   are lifted above it) so clicking anywhere over the node OR the cards opens
	   the modal. See the matching block in ProjectRow.astro. */
	.track-row--boxed {
		position: relative;
		isolation: isolate;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	/* Same bright, glowing hover as the `together` project rows (see
	   .project-row--boxed:hover in ProjectRow.astro) — a warm accent halo and
	   crisp ring on top of the lift shadow — so every clickable timeline card
	   lights up identically no matter which track it sits in. */
	.track-row--boxed:hover {
		border-color: var(--row-line-hover);
		box-shadow:
			0 10px 28px -14px rgba(0, 0, 0, 0.7),
			0 0 22px -2px var(--row-glow),
			0 0 0 1px var(--row-ring);
		background: var(--row-fill-hover);
	}

	.row-open {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		border-radius: inherit;
		cursor: pointer;
	}

	.row-open:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	.cards :global(.showcase) {
		position: relative;
		z-index: 2;
	}

	.node-hint {
		flex-shrink: 0;
		margin-left: auto;
		align-self: center;
		font-size: 0.72rem;
		color: var(--fg-muted);
		opacity: 0.7;
		transition:
			color 0.2s ease,
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.track-row--boxed:hover .node-hint {
