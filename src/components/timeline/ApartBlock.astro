---
import { getEntry, render } from 'astro:content';
import { getPerson, type PersonId } from '../../data/people';
import type { CompanyDef } from '../../data/timeline';
import { splitYears } from './dates';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
	mitko: CompanyDef[];
	adam: CompanyDef[];
	/** This track's first/last company is the same real employer as the entry immediately above/below the fork or merge bounding this apart block (see data/timeline.ts) — style that seam as one continuing entity. */
	mitkoContinuesAbove?: boolean;
	mitkoContinuesBelow?: boolean;
	adamContinuesAbove?: boolean;
	adamContinuesBelow?: boolean;
	/** When this apart block opens the Mentor Game Studio era, its label/dates head Mitko's (left) mentor column — placed inside the column so the other track stays free to connect straight up to the shared company above (see Timeline.astro). */
	mentorLabel?: string;
	mentorDates?: string;
}

const {
	mitko,
	adam,
	mitkoContinuesAbove = false,
	mitkoContinuesBelow = false,
	adamContinuesAbove = false,
	adamContinuesBelow = false,
	mentorLabel,
	mentorDates,
} = Astro.props;

const sides = [
	{ person: 'mitko' as PersonId, side: 'left' as const, companies: mitko, continuesAbove: mitkoContinuesAbove, continuesBelow: mitkoContinuesBelow },
	{ person: 'adam' as PersonId, side: 'right' as const, companies: adam, continuesAbove: adamContinuesAbove, continuesBelow: adamContinuesBelow },
];

const tracks = await Promise.all(
	sides.map(async (side) => {
		const companies = await Promise.all(
			side.companies.map(async (company) => {
				const projects = await Promise.all(
					company.projects.map(async (project) => {
						const cards = await Promise.all(
							project.experiences.map(async (ref) => {
								const entry = await getEntry('experiences', ref.slug);
								if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
								const { Content } = await render(entry);
								return {
									person: getPerson(ref.person),
									Content,
									tagIds: ref.tagIds ?? [],
									link: entry.data.link,
									previewImage: entry.data.previewImage,
								};
							}),
						);
						return { project, cards };
					}),
				);
				return { company, projects };
			}),
		);
		return { ...side, companies };
	}),
);
---

<div class="apart">
	{
		tracks.map((track) => (
			<div
				class:list={[
					'track',
					`track-${track.side}`,
					{
						'under-mentor': track.companies.length > 0 && track.companies.every((c) => c.company.underMentor === true),
						/* A track that continues up from the shared company above stays
						   top-aligned so it meets that seam; any other short track sinks
						   to the bottom of the fork, next to whatever follows it (e.g.
						   Ericsson dropping down toward Black Hole). */
						'align-top': track.continuesAbove,
					},
				]}
			>
				{track.person === 'mitko' && mentorLabel && (
					<div class="mentor-track-label">
						<span class="mentor-track-name">{mentorLabel}</span>
						{mentorDates && <span class="mentor-track-dates">{mentorDates}</span>}
					</div>
				)}
				{track.companies.map(({ company, projects }, companyIndex) => {
					const { start, end } = splitYears(company.dateRange);
					// Show the join year unless this card flows straight out of the
					// same employer above (that transition year already sits on the
					// card above); likewise the leave year at the bottom.
					const showJoin = !(companyIndex === 0 && track.continuesAbove);
					const showLeave = !(companyIndex === track.companies.length - 1 && track.continuesBelow);
					const yearSide = track.side === 'left' ? 'year--left' : 'year--right';
					return (
					<div
						class="track-company"
						class:list={{
							emphasized: company.underMentor === true,
							/* Edge seams (first/last company in the track) merge only when
							   they're the same real employer as the entry outside this
							   ApartBlock (see Timeline.astro). Internal seams — consecutive
							   companies within the same track — are always merged: they're
							   sequential employment for the same person by construction, so
							   they read as one continuous run rather than separate cards. */
							'continues-above': companyIndex === 0 && track.continuesAbove,
							'merged-above': companyIndex > 0,
							'continues-below': companyIndex === track.companies.length - 1 && track.continuesBelow,
							'merged-below': companyIndex < track.companies.length - 1,
						}}
					>
						{showJoin && (
							<div class={`track-header track-header--${track.side}`}>
								<span class="track-year">{start}</span>
								<h4 class:list={{ emphasized: company.underMentor === true }}>{company.name}</h4>
							</div>
						)}
						<div class="track-projects">
							{projects.map(({ project, cards }) => (
								<div class="track-row" class:list={{ 'track-row--boxed': Boolean(project.name) }}>
									{
										project.name && (
											<div class="node">
												<span class="dot" class:list={{ emphasized: company.underMentor === true }} />
												<div class="node-text">
													<h5 class="node-label">{project.name}</h5>
													{project.info && <p class="node-info">{project.info}</p>}
												</div>
											</div>
										)
									}
									<div class="cards">
										{cards.map((card) => (
											<ExperienceCard
												personId={card.person.id}
												tagIds={card.tagIds}
												color={company.underMentor ? 'var(--mentor)' : `var(--${card.person.id}-color)`}
												side={track.side}
												link={card.link}
												previewImage={card.previewImage}
											>
												<card.Content />
											</ExperienceCard>
										))}
									</div>
								</div>
							))}
						</div>
						{showLeave && <span class={`track-year track-year--bottom ${yearSide}`}>{end}</span>}
					</div>
					);
				})}
			</div>
		))
	}
</div>

<style>
	.apart {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2rem;
	}

	.track {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
		/* Short tracks sink to the bottom of the fork so they sit next to
		   whatever follows (Ericsson dropping toward Black Hole); a track that
		   continues up from the company above overrides this to stay at the top. */
		justify-content: flex-end;
	}

	.track.align-top {
		justify-content: flex-start;
	}

	/* Heads Mitko's mentor column (see `mentorLabel` prop). Living inside the
	   left column — rather than as a full-width banner above the fork — is
	   what lets the right column run straight up into the shared company
	   above without the label interrupting that seam. */
	.mentor-track-label {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.15rem 0 0.35rem;
	}

	.mentor-track-name {
		font-size: 0.9rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--mentor);
		text-shadow: 0 0 16px var(--mentor-soft);
	}

	.mentor-track-dates {
		font-size: 0.72rem;
		color: var(--fg-muted);
	}

	.track-company {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--bg-alt);
		padding: 1rem 1rem 1.25rem;
	}

	/* Mentor-era stints fill with the lighter, warm-tinted panel — the region
	   is carried by the card background, not only the rail beside it. */
	.track-company.emphasized {
		background: var(--mentor-bg);
		border-color: var(--mentor-border);
	}

	/* Join year (with the name) at the top, leave year at the bottom, aligned
	   to this person's own side. Suppressed where a card flows straight out of
	   the same employer (see showJoin/showLeave). */
	.track-year {
		display: block;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.05em;
		color: var(--fg-muted);
	}

	.year--left {
		text-align: left;
	}

	.year--right {
		text-align: right;
	}

	.track-year--bottom {
		margin-top: 0.6rem;
	}

	/* Continuation seam: pulled flush against the box above (cancelling the
	   outer .timeline row gap) with the shared edge's radius and border
	   removed, so this track-company reads as one continuous card with the
	   box it continues from — only on the side that actually continues,
	   leaving the other track's normal spacing untouched. */
	.track-company.continues-above {
		margin-top: -2rem;
	}

	/* Internal seam: this company directly follows another company in the
	   same track (sequential employment for the same person) — always
	   pulled flush against it, cancelling .track's own internal gap instead
	   of the outer .timeline gap. */
	.track-company.merged-above {
		margin-top: -1.5rem;
	}

	.track-company.continues-above,
	.track-company.merged-above {
		border-top: none;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	.track-company.continues-below,
	.track-company.merged-below {
		border-bottom: none;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.track-header {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.25rem 0 0.5rem;
	}

	.track-header--left {
		align-items: flex-start;
		text-align: left;
	}

	.track-header--right {
		align-items: flex-end;
		text-align: right;
	}

	.track-header h4 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: var(--fg);
	}

	.track-header h4.emphasized {
		color: var(--mentor);
		text-shadow: 0 0 14px var(--mentor-soft);
	}

	.track-projects {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.track-row {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.track-row--boxed {
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--bg);
		padding: 1rem;
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.node {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.dot {
		flex-shrink: 0;
		margin-top: 0.4rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent-soft);
	}

	.dot.emphasized {
		background: var(--mentor);
		box-shadow: 0 0 12px 3px var(--mentor-soft);
	}

	.node-text {
		min-width: 0;
	}

	.node-label {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--fg);
	}

	.node-info {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--fg-muted);
	}

	@media (max-width: 900px) {
		.apart {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
	}
</style>
