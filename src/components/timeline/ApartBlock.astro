---
import { getEntry, render } from 'astro:content';
import { getPerson, type PersonId } from '../../data/people';
import type { CompanyDef } from '../../data/timeline';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
	mitko: CompanyDef[];
	adam: CompanyDef[];
	/** This track's first/last company is the same real employer as the entry immediately above/below the fork or merge bounding this apart block (see data/timeline.ts) — style that seam as one continuing entity. */
	mitkoContinuesAbove?: boolean;
	mitkoContinuesBelow?: boolean;
	adamContinuesAbove?: boolean;
	adamContinuesBelow?: boolean;
}

const { mitko, adam, mitkoContinuesAbove = false, mitkoContinuesBelow = false, adamContinuesAbove = false, adamContinuesBelow = false } =
	Astro.props;

const sides = [
	{ person: 'mitko' as PersonId, side: 'left' as const, companies: mitko, continuesAbove: mitkoContinuesAbove, continuesBelow: mitkoContinuesBelow },
	{ person: 'adam' as PersonId, side: 'right' as const, companies: adam, continuesAbove: adamContinuesAbove, continuesBelow: adamContinuesBelow },
];

const tracks = await Promise.all(
	sides.map(async (side) => {
		const companies = await Promise.all(
			side.companies.map(async (company) => {
				const projects = await Promise.all(
					company.projects.map(async (project) => {
						const cards = await Promise.all(
							project.experiences.map(async (ref) => {
								const entry = await getEntry('experiences', ref.slug);
								if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
								const { Content } = await render(entry);
								return {
									person: getPerson(ref.person),
									Content,
									tagIds: ref.tagIds ?? [],
									link: entry.data.link,
									previewImage: entry.data.previewImage,
								};
							}),
						);
						return { project, cards };
					}),
				);
				return { company, projects };
			}),
		);
		return { ...side, companies };
	}),
);
---

<div class="apart">
	{
		tracks.map((track) => (
			<div
				class={`track track-${track.side}`}
				class:list={{
					'under-mentor': track.companies.length > 0 && track.companies.every((c) => c.company.underMentor === true),
				}}
			>
				{track.companies.map(({ company, projects }, companyIndex) => (
					<div
						class="track-company"
						class:list={{
							'continues-above': companyIndex === 0 && track.continuesAbove,
							'continues-below': companyIndex === track.companies.length - 1 && track.continuesBelow,
						}}
					>
						<div class="track-header">
							<h4 class:list={{ emphasized: company.underMentor === true }}>{company.name}</h4>
							<p class="track-dates">
								{company.dateRange}
								{companyIndex === 0 && track.continuesAbove && <span class="continued-tag">continued</span>}
							</p>
						</div>
						<div class="track-projects">
							{projects.map(({ project, cards }) => (
								<div class="track-row" class:list={{ 'track-row--boxed': Boolean(project.name) }}>
									{
										project.name && (
											<div class="node">
												<span class="dot" class:list={{ emphasized: company.underMentor === true }} />
												<div class="node-text">
													<h5 class="node-label">{project.name}</h5>
													{project.info && <p class="node-info">{project.info}</p>}
												</div>
											</div>
										)
									}
									<div class="cards">
										{cards.map((card) => (
											<ExperienceCard
												personId={card.person.id}
												tagIds={card.tagIds}
												color={company.underMentor ? 'var(--accent-3)' : `var(--${card.person.id}-color)`}
												side={track.side}
												link={card.link}
												previewImage={card.previewImage}
											>
												<card.Content />
											</ExperienceCard>
										))}
									</div>
								</div>
							))}
						</div>
					</div>
				))}
			</div>
		))
	}
</div>

<style>
	.apart {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 2rem;
	}

	.track {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-width: 0;
	}

	/* A visual boundary independent of DOM nesting — makes it unambiguous that
	   only this track is inside the Mentor Game Studio container, regardless
	   of what its sibling track (the other person, not under Mentor) is doing. */
	.track.under-mentor::before {
		content: '';
		position: absolute;
		inset: -0.75rem -1rem;
		border: 1px dashed var(--accent-3);
		border-radius: 16px;
		background: var(--accent-soft);
		z-index: -1;
	}

	.track-company {
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--bg-alt);
		padding: 1.25rem 1rem 1.5rem;
	}

	.track-company.continues-above {
		border-top-left-radius: 0;
		border-top-right-radius: 0;
	}

	.track-company.continues-below {
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.track-header {
		text-align: center;
		padding: 0.5rem 0 0.5rem;
	}

	.track-header h4 {
		margin: 0 0 0.15rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.8rem;
		color: var(--fg);
	}

	.track-header h4.emphasized {
		color: var(--accent-3);
		text-shadow: 0 0 12px var(--accent-soft);
	}

	.track-dates {
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		font-size: 0.72rem;
		color: var(--fg-muted);
	}

	.continued-tag {
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-3);
		border: 1px solid var(--accent-3);
		border-radius: 999px;
		padding: 0.08rem 0.4rem;
	}

	.track-projects {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.track-row {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.track-row--boxed {
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--bg);
		padding: 1rem;
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.node {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
	}

	.dot {
		flex-shrink: 0;
		margin-top: 0.4rem;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent-soft);
	}

	.dot.emphasized {
		background: var(--accent-3);
		box-shadow: 0 0 12px 3px var(--accent-soft);
	}

	.node-text {
		min-width: 0;
	}

	.node-label {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--fg);
	}

	.node-info {
		margin: 0.3rem 0 0;
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--fg-muted);
	}

	@media (max-width: 900px) {
		.apart {
			grid-template-columns: 1fr;
			row-gap: 2.5rem;
		}
	}
</style>
