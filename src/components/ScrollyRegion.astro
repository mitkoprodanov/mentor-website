---
/**
 * Personal + Timeline + Contact, in one scroll.
 *
 * Both people sit in a sticky bar at the top, one card anchored to each edge
 * with the timeline visible in the gap between them — the cards are capped in
 * width and carry their own background, so revealing their skills never covers
 * the whole timeline, only the sides.
 *
 * Each card collapses to name + role + CV + a "Skills" button; the skills and
 * filter tags reveal on hover (both cards together) or via the button on
 * touch (see panelToggle.client.ts). Filtering is modal (filterModal).
 *
 * Near the page's end the bar shifts into "contact mode" (see
 * contactMode.client.ts): each card swaps its Skills button for a LinkedIn
 * link (the CV stays), and the studio's contact card slides up into the
 * centre between them — so the same two cards become the contact cards in
 * place, with no duplicated second set.
 */
import { getPerson } from '../data/people';
import PersonHeader from './personal/PersonHeader.astro';
import PersonCard from './personal/PersonCard.astro';
import CvDownloadLink from './personal/CvDownloadLink.astro';
import ExternalLink from './common/ExternalLink.astro';
import Timeline from './timeline/Timeline.astro';
import Contact from './sections/Contact.astro';

const mitko = getPerson('mitko');
const adam = getPerson('adam');
---

<div id="personal" class="scrolly">
	<!-- Dimmed backdrop behind the filter modal — clicking it clears the
	     filter (see filterModal.client.ts). Fixed, so its DOM position here
	     doesn't matter. -->
	<div class="filter-backdrop" aria-hidden="true"></div>

	<!-- Modal backdrop for the person cards: blurs and desaturates the rest of
	     the page whenever a card's skills are revealed (hover, keyboard focus,
	     or the touch toggle), the same way the project detail modal dims its
	     background — driven purely by :has() below. Sits under the sticky bar so
	     the cards stay crisp on top. Fixed, so its DOM position here doesn't
	     matter. -->
	<div class="person-backdrop" aria-hidden="true"></div>

	<div class="person-bar">
		<div class="person-bar-inner">
			{
				[
					{ person: mitko, side: 'left' as const },
					{ person: adam, side: 'right' as const },
				].map((entry) => (
					<div class:list={['person-slot', `person-slot--${entry.side}`]} style={`--person-color: var(--${entry.person.id}-color)`}>
						<div class="side-panel">
							<PersonHeader person={entry.person} />
							<div class="side-panel-cv">
								<CvDownloadLink person={entry.person} />
							</div>
							<div class="side-panel-action">
								<button class="panel-toggle" type="button" aria-expanded="false">
									<span class="panel-toggle-label">Skills</span>
									<span class="panel-toggle-chev" aria-hidden="true">▾</span>
								</button>
								<div class="side-panel-linkedin">
									<ExternalLink href={entry.person.linkedin}>LinkedIn</ExternalLink>
								</div>
							</div>
							<div class="side-panel-stack">
								<PersonCard person={entry.person} />
							</div>
							<div class="card-filter" hidden>
								<button type="button" class="card-filter-tag" data-card-filter-label />
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<div class="timeline-area" id="timeline-area">
		<Timeline />
	</div>

	<Contact />
</div>

<script>
	import '../scripts/tagFilter.client';
	import '../scripts/experienceCard.client';
	import '../scripts/projectModal.client';
	import '../scripts/panelToggle.client';
	import '../scripts/filterModal.client';
	import '../scripts/contactMode.client';
	import '../scripts/contactSnap.client';
	import '../scripts/navScroll.client';
</script>

<style>
	.scrolly {
		width: 100%;
		padding: 2rem 1.5rem 4rem;
	}

	/* Transparent, so the timeline shows through the gap between the two
	   edge-anchored cards; each card carries its own opaque background. */
	.person-bar {
		position: sticky;
		top: 3rem;
		z-index: 4;
	}

	.person-bar-inner {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 1.5rem;
		max-width: 1600px;
		margin: 0 auto;
		padding: 0.6rem 1.5rem;
	}

	/* Capped width and anchored to each edge — leaving the centre open for the
	   timeline even when the skills are expanded. */
	.person-slot {
		position: relative;
		flex: 0 1 340px;
		min-width: 0;
	}

	/* Each resting card carries its own soft "modal" halo: a band just outside
	   its border that blurs and desaturates whatever shows through the sticky
	   bar behind it (usually the timeline), fading gradually to nothing at its
	   outer edge — so even an un-hovered card reads as lifted off its
	   background, a lighter echo of the full-page backdrop that drops in on
	   hover. Lives on the slot (not the panel, which clips overflow) and sits
	   behind the opaque card, so only the ring around it is ever visible. */
	.person-slot::before {
		content: '';
		position: absolute;
		inset: -18px;
		z-index: -1;
		border-radius: 28px;
		-webkit-backdrop-filter: blur(8px) saturate(0.5);
		backdrop-filter: blur(8px) saturate(0.5);
		/* Feather the blur out to nothing across the ring *outside* the card:
		   fully applied at the card edge, transparent at the outer edge, on all
		   four sides. Two linear gradients (one per axis) intersected so the
		   corners fade too — a plain radial mask can't ring a non-square box
		   without cutting off the long sides. */
		-webkit-mask:
			linear-gradient(to right, transparent, #000 18px, #000 calc(100% - 18px), transparent),
			linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 18px), transparent);
		-webkit-mask-composite: source-in;
		mask:
			linear-gradient(to right, transparent, #000 18px, #000 calc(100% - 18px), transparent),
			linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 18px), transparent);
		mask-composite: intersect;
		opacity: 1;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	/* Once the skills are revealed, the full-page .person-backdrop takes over
	   the blur/desaturate, so each card's own halo would only double the edge —
	   fade it out then. */
	.person-bar-inner.reveal .person-slot::before,
	.person-bar-inner:has(.side-panel.is-open) .person-slot::before {
		opacity: 0;
	}

	/* Each card is its own opaque, bordered box so it cleanly covers the
	   timeline only where it sits. When its skills are revealed it behaves like
	   a modal — a blurred/desaturated backdrop drops over the rest of the page
	   (see .person-backdrop) and the card itself scrolls if its content
	   overflows the viewport (see .side-panel-stack) rather than the page. */
	.side-panel {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding-bottom: 0.7rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	/* Brighter, glowing silhouette when the card is hovered. */
	.side-panel:hover {
		border-color: color-mix(in srgb, var(--person-color) 55%, var(--border));
		box-shadow: 0 0 26px -2px color-mix(in srgb, var(--person-color) 38%, transparent);
	}

	/* Hovering one card reveals both (they're a paired unit), so the *other*
	   card is part of the same modal even though the pointer isn't on it — give
	   it the same lifted border/glow so it stands off the blurred, desaturated
	   backdrop exactly like the hovered one, rather than sitting flat with just
	   its faint idle border. Also applies to the touch-opened card. */
	.person-bar-inner.reveal .side-panel,
	.side-panel.is-open {
		border-color: color-mix(in srgb, var(--person-color) 55%, var(--border));
		box-shadow: 0 0 26px -2px color-mix(in srgb, var(--person-color) 38%, transparent);
	}

	/* Modal backdrop for a revealed card — blurs and desaturates the rest of the
	   page behind the cards, like the project detail modal's ::backdrop. Sits
	   below the sticky bar (z-index 4) so the opaque cards stay crisp on top.
	   Shown via :has() whenever any card's skills are revealed — hover
	   (.reveal), keyboard focus (:focus-within), or the touch toggle (.is-open)
	   — but never in contact mode, where the cards aren't showing skills. */
	.person-backdrop {
		position: fixed;
		inset: 0;
		z-index: 3;
		background: rgba(4, 6, 10, 0.5);
		-webkit-backdrop-filter: blur(5px) saturate(0.65);
		backdrop-filter: blur(5px) saturate(0.65);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	:global(body:not(.contact-mode):has(.person-bar-inner.reveal)) .person-backdrop,
	:global(body:not(.contact-mode):has(.person-bar-inner:focus-within)) .person-backdrop,
	:global(body:not(.contact-mode):has(.side-panel.is-open)) .person-backdrop {
		opacity: 1;
	}

	.side-panel :global(.person-header) {
		padding: 0.9rem 1rem 0.4rem;
	}

	/* Hidden while the card rests — the CV pill only reads as relevant once the
	   card is engaged, so it follows the same reveal as the skills panel: hover
	   (.reveal), keyboard focus, the touch toggle (.is-open), or contact mode
	   (further down). Otherwise the un-hovered card shows no CV button. */
	.side-panel-cv {
		display: none;
		justify-content: flex-start;
		padding: 0 1rem;
	}

	.side-panel.is-open .side-panel-cv {
		display: flex;
	}

	@media (hover: hover) and (pointer: fine) {
		.person-bar-inner.reveal .side-panel-cv,
		.person-bar-inner:focus-within .side-panel-cv {
			display: flex;
		}
	}

	/* Toggle and LinkedIn share one cell and crossfade between each other when
	   contact mode flips — no layout jump. */
	.side-panel-action {
		display: grid;
		padding: 0 1rem;
	}

	.side-panel-action > * {
		grid-area: 1 / 1;
		justify-self: start;
		transition: opacity 0.4s ease;
	}

	/* "Skills" button styled like the CV pill: person-tinted soft fill, bold,
	   same rounded silhouette. */
	.panel-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 1rem;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
		color: var(--person-color);
		background: color-mix(in srgb, var(--person-color) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--person-color) 45%, transparent);
		border-radius: 999px;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			opacity 0.4s ease;
	}

	.panel-toggle:hover,
	.panel-toggle:focus-visible {
		color: var(--bg);
		background: var(--person-color);
		border-color: var(--person-color);
		box-shadow: 0 0 18px 1px color-mix(in srgb, var(--person-color) 55%, transparent);
	}

	.panel-toggle-chev {
		transition: transform 0.2s ease;
	}

	.side-panel.is-open .panel-toggle-chev {
		transform: rotate(180deg);
	}

	/* LinkedIn shown only in contact mode (crossfaded in over the toggle). */
	.side-panel-linkedin {
		opacity: 0;
		pointer-events: none;
	}

	.side-panel-linkedin :global(.external-link) {
		font-weight: 600;
	}

	/* Collapsed by default; skills reveal via the JS `.reveal` class (hover,
	   both cards together) or the toggle's is-open (touch). When revealed and
	   taller than the viewport allows, the card scrolls its own content here
	   (capped height + contained overscroll) rather than letting the page
	   scroll behind it — the modal behaviour paired with .person-backdrop and
	   the wheel handling in panelToggle.client.ts. */
	.side-panel-stack {
		display: none;
		max-height: calc(100vh - 12rem);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	/* Slimmer take on the site-wide scrollbar (see Layout.astro) for the
	   revealed skills — a light bar inside the narrow card, same tinted thumb. */
	.side-panel-stack::-webkit-scrollbar {
		width: 8px;
	}

	.side-panel.is-open .side-panel-stack {
		display: block;
	}

	@media (hover: hover) and (pointer: fine) {
		.person-bar-inner.reveal .side-panel-stack,
		.person-bar-inner:focus-within .side-panel-stack {
			display: block;
		}
	}

	/* Right-hand card mirrors to the right edge. */
	.person-slot--right :global(.person-header) {
		text-align: right;
	}

	.person-slot--right .side-panel-cv {
		justify-content: flex-end;
	}

	.person-slot--right .side-panel-action > * {
		justify-self: end;
	}

	/* The active filter tag, echoed under the (collapsed) card while filtering
	   — a button that clears the filter on click. */
	.card-filter {
		padding: 0.15rem 1rem 0;
	}

	.person-slot--right .card-filter {
		text-align: right;
	}

	.card-filter-tag {
		font-family: inherit;
		cursor: pointer;
		border: none;
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.25rem 0.65rem;
		border-radius: 999px;
		background: var(--person-color);
		color: var(--bg);
		box-shadow: 0 0 14px 1px color-mix(in srgb, var(--person-color) 55%, transparent);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.card-filter-tag:hover,
	.card-filter-tag:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 0 20px 3px color-mix(in srgb, var(--person-color) 70%, transparent);
		outline: none;
	}

	/* ---- Contact mode: the person cards become contact cards, in place ----
	   As the reader scrolls into the closing Contact section (see
	   sections/Contact.astro, which is where the "Contact" title + studio card
	   live, in normal page flow), each person card swaps its Skills button for
	   its LinkedIn link — so the two people read as contact cards pinned above
	   that section. */
	:global(body.contact-mode) .panel-toggle {
		opacity: 0;
		pointer-events: none;
	}

	:global(body.contact-mode) .side-panel-linkedin {
		opacity: 1;
		pointer-events: auto;
	}

	/* No skills panel in contact mode. */
	:global(body.contact-mode) .side-panel-stack {
		display: none !important;
	}

	/* CV pill stays put in contact mode, where the cards read as contact cards
	   even though they aren't hover-revealed. */
	:global(body.contact-mode) .side-panel-cv {
		display: flex;
	}

	.timeline-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1600px;
		margin: 0 auto;
	}

	/* ---- Filter modal ---------------------------------------------------
	   Filtering doesn't collapse the page in place — it lifts the filtered
	   Timeline jobs/projects into a centered modal panel over a dimmed
	   backdrop, so the reader sees just the filtered results, not the whole
	   site. Dismiss by clicking the backdrop, the panel chip's ✕, or Escape
	   (see filterModal.client.ts / tagFilter.client.ts). */
	.filter-backdrop {
		position: fixed;
		inset: 0;
		z-index: 25;
		background: rgba(4, 6, 10, 0.74);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	:global(body.filter-active) .filter-backdrop {
		opacity: 1;
		pointer-events: auto;
	}

	/* In the filtered modal, drop every heading/label from the original page
	   layout — the "Timeline"/"Projects" section titles, the company/date
	   headers, and the Mentor-era label — so the panel reads as just the flat
	   collection of matching project cards, not a stripped-down copy of the
	   whole site. The filter chip ("Filtered by: …") and each project's own
	   name stay. */
	:global(body.filter-active .section-title),
	:global(body.filter-active .company-header),
	:global(body.filter-active .track-header),
	:global(body.filter-active .mentor-heading) {
		display: none !important;
	}

	:global(body.filter-active) .timeline-area {
		position: fixed;
		top: 4.5rem;
		left: 50%;
		transform: translateX(-50%);
		width: min(1200px, calc(100vw - 3rem));
		max-height: calc(100vh - 6rem);
		margin: 0;
		padding: 1.25rem clamp(1rem, 3vw, 2rem) 2rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		z-index: 26;
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
		border-radius: 20px;
		box-shadow: 0 24px 70px -12px rgba(0, 0, 0, 0.85);
		animation: filter-modal-in 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@keyframes filter-modal-in {
		from {
			opacity: 0;
			transform: translateX(-50%) translateY(14px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateX(-50%) translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(body.filter-active) .timeline-area {
			animation: none;
		}
	}

	@media (max-width: 900px) {
		.scrolly {
			padding: 1.5rem 1rem 3rem;
		}

		/* On a phone there's no room for two edge-anchored cards with the
		   timeline showing through a centre gap — two 50%-width cards would
		   leave only a sliver between them, and the sticky bar would sit
		   opaque over the (now full-width, single-column) timeline scrolling
		   behind it. So drop the sticky framing here: the bar becomes a normal
		   block that scrolls away, and the two people stack full-width above
		   the timeline like an ordinary intro. */
		.person-bar {
			position: static;
		}

		.person-bar-inner {
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
			max-width: 520px;
			padding: 0.5rem 0;
		}

		.person-slot {
			flex: 0 0 auto;
			width: 100%;
		}

		/* Stacked and full-width, both cards read top-to-bottom left-aligned —
		   the right card's mirrored (right-aligned) layout only makes sense when
		   it's anchored to the right edge on desktop. */
		.person-slot--right :global(.person-header),
		.person-slot--right .card-filter {
			text-align: left;
		}

		.person-slot--right .side-panel-cv {
			justify-content: flex-start;
		}

		.person-slot--right .side-panel-action > * {
			justify-self: start;
		}

		/* Expanding skills is now a plain inline accordion (tap to open): let it
		   grow to its natural height and push the page instead of trapping a
		   tall list inside a short scroll box, and drop the full-page modal
		   backdrop that only made sense when the card was a sticky overlay. */
		.side-panel-stack {
			max-height: none;
			overflow-y: visible;
		}

		.person-backdrop {
			display: none;
		}

		/* The per-card blur halo reads as a floating overlay ring — with the
		   bar now in normal flow it just muddies the edges, so drop it. */
		.person-slot::before {
			display: none;
		}
	}
</style>
