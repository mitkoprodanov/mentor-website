---
/**
 * Personal + Timeline + Contact, in one scroll.
 *
 * Both people sit in a sticky bar at the top, one card anchored to each edge
 * with the timeline visible in the gap between them — the cards are capped in
 * width and carry their own background, so revealing their skills never covers
 * the whole timeline, only the sides.
 *
 * Each card collapses to name + role + CV + a "Skills" button; the skills and
 * filter tags reveal on hover (both cards together) or via the button on
 * touch (see panelToggle.client.ts). Filtering is modal (filterModal).
 *
 * Near the page's end the bar shifts into "contact mode" (see
 * contactMode.client.ts): each card swaps its Skills button for a LinkedIn
 * link (the CV stays), and the studio's contact card slides up into the
 * centre between them — so the same two cards become the contact cards in
 * place, with no duplicated second set.
 */
import { getPerson } from '../data/people';
import { asset } from '../utils/asset';
import PersonHeader from './personal/PersonHeader.astro';
import PersonCard from './personal/PersonCard.astro';
import CvDownloadLink from './personal/CvDownloadLink.astro';
import ExternalLink from './common/ExternalLink.astro';
import Timeline from './timeline/Timeline.astro';
import FilterResults from './projects/FilterResults.astro';
import Contact from './sections/Contact.astro';

const mitko = getPerson('mitko');
const adam = getPerson('adam');
---

<div id="personal" class="scrolly">
	<!-- Dimmed backdrop behind the filter modal — clicking it clears the
	     filter (see filterModal.client.ts). Fixed, so its DOM position here
	     doesn't matter. -->
	<div class="filter-backdrop" aria-hidden="true"></div>

	<!-- Modal backdrop for the person cards: blurs and desaturates the rest of
	     the page whenever a card's skills are revealed (hover, keyboard focus,
	     or the touch toggle), the same way the project detail modal dims its
	     background — driven purely by :has() below. Sits under the sticky bar so
	     the cards stay crisp on top. Fixed, so its DOM position here doesn't
	     matter. -->
	<div class="person-backdrop" aria-hidden="true"></div>

	<div class="person-bar" id="person-bar" popover="manual">
		<div class="person-bar-inner">
			{
				[
					{ person: mitko, side: 'left' as const },
					{ person: adam, side: 'right' as const },
				].map((entry) => (
					<div class:list={['person-slot', `person-slot--${entry.side}`]} style={`--person-color: var(--${entry.person.id}-color)`}>
						<div class:list={['person-photo', entry.person.id === 'mitko' ? 'person-photo--cutout' : 'person-photo--framed']} aria-hidden="true">
							<img src={asset(`/people/${entry.person.id}.png`)} alt="" width="132" height="150" loading="eager" decoding="async" />
						</div>
						{/* Curvy, person-tinted flourishes that lift the card off the busy
						    timeline behind it — a stronger, more graphic separation than the
						    soft blur ring alone. Two layers, both in the person's colour:
						      • .decor-frame — a curvy loop just OUTSIDE the whole card, on
						        every side (top, bottom, and both the outer and inner edge, so
						        the edge facing the centre timeline is framed too). Stretches to
						        fit the card at any height. The card is opaque and sits above,
						        so only the loop around it ever shows.
						      • .decor-cradle — arcs cupping the headshot above the card, so the
						        line "circles" the whole person (photo) + card together. Fades in
						        lock-step with the photo (see --photo-opacity), so it only shows
						        while the photo does — before the pair docks and the photo tucks
						        up behind the navbar.
						    Both are left–right symmetric, so the same markup serves both cards. */}
						<div class="slot-decor" aria-hidden="true">
							<span class="decor-glow"></span>
							<span class="decor-frame"></span>
							<svg class="decor-cradle" viewBox="0 0 150 168" fill="none" xmlns="http://www.w3.org/2000/svg">
								<polygon class="decor-line decor-line--outer" points="75,4 146,49 146,126 75,164 4,126 4,49" />
								<polygon class="decor-line decor-line--inner" points="75,15 136,54 136,120 75,153 14,120 14,54" />
							</svg>
						</div>
						<div class="side-panel">
							<PersonHeader person={entry.person} />
							{/* Each collapsible row is wrapped in a .collapse-row grid so its
							    height can be animated by transitioning `grid-template-rows`
							    from 1fr↔0fr — the parent .side-panel then reflows smoothly
							    each frame as the wrapper's row track shrinks. `height: auto`
							    keyword interpolation (via `interpolate-size`) proved unreliable
							    here for parent-follow, so this grid trick is the workaround. */}
							<div class="collapse-row">
								<div class="side-panel-cv">
									<CvDownloadLink person={entry.person} />
								</div>
							</div>
							<div class="collapse-row">
								<div class="side-panel-action">
									<div class="panel-toggle-wrap">
										<button class="panel-toggle btn-sheen" type="button" aria-expanded="false">
											<span class="panel-toggle-label">Skills</span>
											<span class="panel-toggle-chev" aria-hidden="true">▾</span>
										</button>
									</div>
									<div class="side-panel-linkedin">
										<ExternalLink href={entry.person.linkedin} class="linkedin-pill btn-sheen">LinkedIn</ExternalLink>
									</div>
								</div>
							</div>
							<div class="side-panel-stack">
								<PersonCard person={entry.person} />
							</div>
							<div class="card-filter" hidden>
								<button type="button" class="card-filter-tag" data-card-filter-label />
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>

	<!-- Active-filter chip: single clickable button that clears the filter.
	     Lives at the top level of #personal (a sibling of .timeline-area) so
	     `position: fixed` resolves to the viewport — .timeline-area has
	     `transform: translateX(-50%)` during filter-active, which would
	     otherwise pin any fixed descendant to the modal box. Hidden until the
	     filter turns on; toggled by tagFilter.client.ts / driven by
	     filterModal.client.ts / panelToggle.client.ts via its id. -->
	<div class="filter-chip-shield">
		<button
			type="button"
			class="filter-chip btn-sheen"
			id="timeline-filter-chip-clear"
			aria-label="Clear filter"
			hidden
		>
			<span class="filter-chip-label">Filtered by: <strong id="timeline-filter-chip-skill"></strong></span>
			<span class="filter-chip-icon" aria-hidden="true">✕</span>
		</button>
	</div>

	<div class="timeline-area" id="timeline-area">
		<Timeline />
		<!-- The skill-tag filter's detailed results — hidden until a filter turns
		     on, when it replaces the timeline inside this lifted modal (see the
		     body.filter-active rules below and FilterResults.astro). -->
		<FilterResults />
	</div>

	<Contact />
</div>

<script>
	import '../scripts/tagFilter.client';
	import '../scripts/experienceCard.client';
	import '../scripts/projectModal.client';
	import '../scripts/panelToggle.client';
	import '../scripts/filterModal.client';
	import '../scripts/contactMode.client';
	import '../scripts/contactSnap.client';
	import '../scripts/navScroll.client';
	import '../scripts/personPhotos.client';
	import '../scripts/personCardResize.client';
</script>

<style>
	.scrolly {
		width: 100%;
		/* No bottom padding below the closing Contact section. Contact is
		   min-height:100vh and the directional snap (contactSnap.client.ts) rests
		   with its top flush to the viewport top — so any padding here would leave a
		   strip of empty scroll *past* that rest: free play the snap can't remove
		   (you'd snap to the title-on-top, then still be able to nudge ~4rem further).
		   Contact fills the last screen on its own, so drop it and make that rest the
		   true end of the page. (Mobile re-adds bottom padding below, where the snap
		   is disabled and the bar scrolls with the page.) */
		padding: 2rem 1.5rem 0;
	}

	/* Transparent, so the timeline shows through the gap between the two
	   edge-anchored cards; each card carries its own opaque background. */
	/* Also carries `popover="manual"` (see the markup) so that when a project
	   modal opens, projectModal.client.ts calls .showPopover() on the bar to
	   promote it into the top layer above the dialog's ::backdrop — that's
	   the only way an element in normal flow can render *above* a dialog
	   opened via showModal(). The UA popover styles (position:fixed inset:0,
	   display:none-when-closed, background/border/padding of a menu) are
	   individually overridden below so the closed bar keeps its normal
	   sticky rendering, and the open bar mirrors that same rectangle in
	   fixed-position form. */
	.person-bar {
		position: sticky;
		z-index: 4;
		/* The bar is a full-width sticky wrapper but only paints at its two
		   edges — the two person cards. Let clicks fall through the empty
		   middle so a project card scrolling behind it (horizontally beside
		   the person cards) stays clickable; the two slots below re-enable
		   pointer events on themselves. Same pattern the filter-active
		   branch uses further down. */
		pointer-events: none;
		/* Undo UA popover paints and sizing. */
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		overflow: visible;
		width: auto;
		height: auto;
		max-width: none;
		max-height: none;
		margin: 0;
		/* Sticky offset — placed AFTER any inset resets so the UA `inset: 0`
		   from `[popover]` (which shorthand-sets `top: 0`) is not what wins. */
		top: 3rem;
		right: auto;
		bottom: auto;
		left: auto;
	}

	/* Force the closed popover to remain visible in normal flow (the UA
	   default is `display: none`). */
	.person-bar:not(:popover-open) {
		display: block;
	}

	/* When shown as a popover (project modal open), pin the bar to the same
	   position it held while sticky — so promoting it into the top layer
	   introduces no visual jump. */
	.person-bar:popover-open {
		position: fixed;
		top: 3rem;
		left: 0;
		right: 0;
	}

	/* Solo-project modal — only the person whose experience is in the modal
	   comes forward on top; the other person's slot fades to invisible so
	   the attention is on the single card. `visibility: hidden` keeps the
	   layout of `.person-bar-inner` stable (still a two-cell flex row) so
	   the surviving card sits in its usual edge slot instead of jumping to
	   the centre. Exact-match attribute selectors, so a two-person modal
	   (`data-modal-people="mitko adam"`) matches neither. */
	:global(body[data-modal-people='mitko']) .person-slot--right,
	:global(body[data-modal-people='adam']) .person-slot--left {
		visibility: hidden;
	}

	/* During the About→Timeline intro lift (thoughtCloud.client.ts translates the
	   whole .scrolly to crawl the cards/timeline up), the bar must ride that
	   transform as normal flow rather than sticking — otherwise it clamps to its
	   sticky top while the timeline slides past it. `relative` (not `static`)
	   keeps its z-index:4 stacking over the timeline; top:0 cancels the sticky
	   offset. The class is removed the instant the lift ends, restoring sticky. */
	:global(body.tl-lifted) .person-bar {
		position: relative;
		top: 0;
	}

	.person-bar-inner {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 1.5rem;
		max-width: 1600px;
		margin: 0 auto;
		padding: 0.6rem 1.5rem;
	}

	/* Capped width and anchored to each edge — leaving the centre open for the
	   timeline even when the skills are expanded. The whole slot (card + its
	   photo) is the moving unit on the About→Timeline hand-off: it slides from
	   the screen centre out to its own edge, so the photo stays locked directly
	   above its card the entire way. Driven by personPhotos.client.ts:
	     --cx    (per slot) distance from the card's centre to the viewport centre
	     --split (eased 0→1) collapses it — split 0 stacks the pair at centre,
	             split 1 rests each slot at its edge; --photo-motion zeroes the
	             travel under reduced motion. */
	.person-slot {
		position: relative;
		flex: 0 1 355px;
		min-width: 0;
		/* Re-enable pointer events on the actual card slot; the parent
		   .person-bar sets pointer-events: none so the empty middle lets
		   clicks through to the timeline behind. */
		pointer-events: auto;
		transform: translateX(calc((1 - var(--split, 1)) * var(--cx, 0px) * var(--photo-motion, 1)));
		will-change: transform;
		/* Eases flex-basis between the resting 340px and the header-only pixel
		   width published by personCardResize.client.ts as --panel-w-shrunk.
		   Two pixel endpoints, so no keyword interpolation is needed — the
		   panel background, the .slot-decor frame and glow (both sized to the
		   slot) and the headshot (centred in the slot) all reflow together
		   frame by frame. A snappy, fast ease — matches the Skills-panel
		   height transition below so both animations feel like one system. */
		transition: flex-basis 0.14s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Shrink the slot to fit just name + role whenever the card is stripped
	   of its action buttons — any project detail modal (single-person or the
	   two-person "mitko adam" variant), and the filtered-results framing.
	   Fallback of max-content keeps things sensible until the JS measurement
	   lands (that first run happens off-screen, before the reader can see it). */
	:global(body[data-modal-people]) .person-slot,
	:global(body.filter-active) .person-slot {
		flex-basis: var(--panel-w-shrunk, max-content);
	}

	/* ---- Headshot photos above each card --------------------------------
	   One per person, absolutely positioned above its card — out of flow, so it
	   never adds height to the sticky bar ("doesn't take the space afterwards")
	   — and carried along by the slot's transform so it rides above the card.
	   It adds only its own flourish: an eased lift + zoom that's strongest at
	   centre and settles as the pair reaches the sides, then a fade as it tucks
	   behind the navbar. A vertical, flat-top hexagon echoing the brand. */
	.person-photo {
		/* Pointy-top hexagon traced from Adam's own source crop: the point sits
		   top & bottom centre and the left/right edges run vertical, so the sides
		   never pinch into a head the way a flat-top hexagon's side points do. */
		--hex: polygon(50% 0%, 100% 28%, 100% 76%, 50% 100%, 0% 76%, 0% 28%);
		position: absolute;
		left: 50%;
		bottom: calc(100% + 14px);
		width: 132px;
		height: 150px;
		z-index: 2;
		pointer-events: none;
		clip-path: var(--hex);
		transform: translateX(-50%)
			translateY(calc((1 - var(--split, 1)) * -14px * var(--photo-motion, 1)))
			scale(calc(1 + (1 - var(--split, 1)) * 0.1 * var(--photo-motion, 1)));
		transform-origin: bottom center;
		opacity: var(--photo-opacity, 1);
		filter:
			drop-shadow(0 8px 16px rgba(0, 0, 0, 0.55))
			drop-shadow(0 0 12px color-mix(in srgb, var(--person-color) 42%, transparent));
		will-change: transform, opacity;
	}

	.person-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Desaturated + sepia-warmed so the photo reads in the site's palette
		   rather than as a raw snapshot. */
		filter: grayscale(0.5) sepia(0.36) saturate(1.05) contrast(1.02) brightness(0.97);
		transition: filter 0.3s ease;
	}

	/* --- Adam: a self-contained hexagon photo (its own café backdrop). A 3px
	   person-tinted ring shows through the padding; the image is clipped to the
	   same hexagon and scaled a hair past the frame so no white corner sliver
	   from the source survives the crop. --- */
	.person-photo--framed {
		padding: 3px;
		background: linear-gradient(150deg, color-mix(in srgb, var(--person-color) 90%, #fff), color-mix(in srgb, var(--person-color) 35%, var(--bg)));
	}

	.person-photo--framed img {
		clip-path: var(--hex);
		object-position: center 22%;
		transform: scale(1.06);
	}

	/* Accent wash over Adam's photo, clipped to the hexagon. */
	.person-photo--framed::after {
		content: '';
		position: absolute;
		inset: 3px;
		clip-path: var(--hex);
		background: var(--person-color);
		mix-blend-mode: soft-light;
		opacity: 0.3;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	/* --- Mitko: a background-removed cut-out. Instead of a hard photographic
	   edge, he floats on a soft person-tinted radial backdrop inside the hexagon,
	   and a person-coloured glow traced around his silhouette (the image's own
	   drop-shadow, which follows its alpha) feathers the extraction edge so the
	   cut reads as an intentional halo. --- */
	.person-photo--cutout {
		background: radial-gradient(
			ellipse 72% 62% at 50% 42%,
			color-mix(in srgb, var(--person-color) 34%, var(--bg)) 0%,
			color-mix(in srgb, var(--person-color) 14%, var(--bg)) 48%,
			var(--bg) 88%
		);
	}

	.person-photo--cutout img {
		/* Pulled down and un-zoomed so his whole head clears the top point. */
		object-position: center 2%;
		transform: scale(0.98);
		filter: grayscale(0.5) sepia(0.36) saturate(1.05) contrast(1.02) brightness(0.97)
			drop-shadow(0 0 5px color-mix(in srgb, var(--person-color) 75%, #fff))
			drop-shadow(0 0 12px color-mix(in srgb, var(--person-color) 55%, transparent));
	}

	/* When the cards are engaged (hover reveals both together, or a card is
	   touch-opened) the photos warm toward full colour — tying them into the
	   same reveal choreography as the skills panels. */
	.person-bar-inner.reveal .person-photo img,
	.person-slot:has(.side-panel.is-open) .person-photo img,
	.person-slot:hover .person-photo img {
		filter: grayscale(0.15) sepia(0.15) saturate(1.1) contrast(1.02) brightness(1);
	}

	/* Cutout keeps its silhouette halo on hover (the drop-shadows must ride
	   along with the warmed colour filter). */
	.person-bar-inner.reveal .person-photo--cutout img,
	.person-slot:has(.side-panel.is-open) .person-photo--cutout img,
	.person-slot:hover .person-photo--cutout img {
		filter: grayscale(0.15) sepia(0.15) saturate(1.1) contrast(1.02) brightness(1)
			drop-shadow(0 0 5px color-mix(in srgb, var(--person-color) 75%, #fff))
			drop-shadow(0 0 12px color-mix(in srgb, var(--person-color) 55%, transparent));
	}

	.person-bar-inner.reveal .person-photo--framed::after,
	.person-slot:hover .person-photo--framed::after {
		opacity: 0.16;
	}

	/* Each resting card carries its own soft "modal" halo: a band just outside
	   its border that blurs and desaturates whatever shows through the sticky
	   bar behind it (usually the timeline), fading gradually to nothing at its
	   outer edge — so even an un-hovered card reads as lifted off its
	   background, a lighter echo of the full-page backdrop that drops in on
	   hover. Lives on the slot (not the panel, which clips overflow) and sits
	   behind the opaque card, so only the ring around it is ever visible. */
	.person-slot::before {
		content: '';
		position: absolute;
		inset: -18px;
		z-index: -1;
		border-radius: 28px;
		-webkit-backdrop-filter: blur(8px) saturate(0.5);
		backdrop-filter: blur(8px) saturate(0.5);
		/* Feather the blur out to nothing across the ring *outside* the card:
		   fully applied at the card edge, transparent at the outer edge, on all
		   four sides. Two linear gradients (one per axis) intersected so the
		   corners fade too — a plain radial mask can't ring a non-square box
		   without cutting off the long sides. */
		-webkit-mask:
			linear-gradient(to right, transparent, #000 18px, #000 calc(100% - 18px), transparent),
			linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 18px), transparent);
		-webkit-mask-composite: source-in;
		mask:
			linear-gradient(to right, transparent, #000 18px, #000 calc(100% - 18px), transparent),
			linear-gradient(to bottom, transparent, #000 18px, #000 calc(100% - 18px), transparent);
		mask-composite: intersect;
		opacity: 1;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	/* Once the skills are revealed, the full-page .person-backdrop takes over
	   the blur/desaturate, so each card's own halo would only double the edge —
	   fade it out then. */
	.person-bar-inner.reveal .person-slot::before,
	.person-bar-inner:has(.side-panel.is-open) .person-slot::before {
		opacity: 0;
	}

	/* Each card is its own opaque, bordered box so it cleanly covers the
	   timeline only where it sits. When its skills are revealed it behaves like
	   a modal — a blurred/desaturated backdrop drops over the rest of the page
	   (see .person-backdrop) and the card itself scrolls if its content
	   overflows the viewport (see .side-panel-stack) rather than the page. */
	/* ---- Person-tinted flourishes --------------------------------------
	   Geometric double-hairline framing + a soft tinted glow that lift each card
	   off the busy timeline — matching the site's rounded-rect / hairline
	   language rather than the old hand-drawn loop. Three layers (see markup):
	   a soft glow halo, a double-line rounded frame around the card, and a
	   double-line hexagon around the photo above it. The card panel is opaque and
	   sits above (z-index below), so only the parts past it ever show. */
	.slot-decor {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		color: var(--person-color);
	}

	/* Soft person-tinted halo lifting the card + headshot off the timeline — the
	   "glow". Two blurred blobs: the lower behind the card, the upper (smaller)
	   behind the photo above it. */
	.decor-glow {
		position: absolute;
		left: 50%;
		top: -158px;
		transform: translateX(-50%);
		width: calc(100% + 90px);
		height: calc(100% + 214px);
		z-index: -1;
		background:
			radial-gradient(44% 38% at 50% 78%, color-mix(in srgb, var(--person-color) 24%, transparent), transparent 72%),
			radial-gradient(32% 21% at 50% 18%, color-mix(in srgb, var(--person-color) 20%, transparent), transparent 70%);
		filter: blur(5px);
		transition: opacity 0.25s ease;
	}

	/* The card frame: a double hairline just outside the card, stretching with it
	   at any height. Clean CSS corners (not a stretched SVG) so the rounding stays
	   true, matching the pills/cards; a soft tinted edge-glow backs the halo. The
	   inner hairline (::before) traces a fainter line inside the outer one. */
	.decor-frame {
		position: absolute;
		left: -15px;
		top: -15px;
		width: calc(100% + 30px);
		height: calc(100% + 30px);
		border: 1px solid color-mix(in srgb, var(--person-color) 62%, transparent);
		border-radius: 20px;
		box-shadow: 0 0 20px -2px color-mix(in srgb, var(--person-color) 28%, transparent);
		transition: opacity 0.25s ease;
	}

	.decor-frame::before {
		content: '';
		position: absolute;
		inset: 5px;
		border: 1px solid color-mix(in srgb, var(--person-color) 30%, transparent);
		border-radius: 15px;
	}

	/* The photo hexagon: fixed-size and centred so its double outline tracks the
	   fixed-width headshot, echoing the hex crop and the logo's geometry. Tied to
	   --photo-opacity (published on .person-bar-inner) so it fades out with the
	   headshot as the pair docks. */
	.decor-cradle {
		position: absolute;
		left: 50%;
		top: -173px;
		transform: translateX(-50%);
		width: 150px;
		height: 168px;
		opacity: var(--photo-opacity, 1);
		filter: drop-shadow(0 0 5px color-mix(in srgb, var(--person-color) 45%, transparent));
	}

	.decor-line {
		stroke: currentColor;
		stroke-linejoin: round;
		fill: none;
		vector-effect: non-scaling-stroke;
	}

	.decor-line--outer {
		stroke-width: 1.4;
		opacity: 0.9;
	}

	.decor-line--inner {
		stroke-width: 1;
		opacity: 0.45;
	}

	/* When the skills reveal (hover / open) the full-page backdrop takes over
	   separation and the card grows tall — ease the frame + glow back so they
	   don't compete with the expanded modal, mirroring the blur ring's fade.
	   (The hexagon is already gone by then: the photo has faded on docking.) */
	.person-bar-inner.reveal .decor-frame,
	.person-bar-inner.reveal .decor-glow,
	.person-bar-inner:has(.side-panel.is-open) .decor-frame,
	.person-bar-inner:has(.side-panel.is-open) .decor-glow {
		opacity: 0.4;
	}

	.side-panel {
		display: flex;
		flex-direction: column;
		/* Was `gap: 0.4rem` — moved to per-child margin-top on the second-
		   onwards children (see the `> * + *` rule below) so that the CV
		   pill and Skills row can each animate their own leading margin
		   from 0.4rem → 0 alongside their height/opacity fade. Flex `gap`
		   can't be animated per child, so when a row's `display` flipped to
		   `none` at the end of its transition the row's slice of the shared
		   gap collapsed in one 0.4rem step — the exact "border isn't easing"
		   snap this refactor removes. */
		gap: 0;
		padding-bottom: 0.7rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		/* Own stacking context so the corner flourishes (z-index 0) sit behind
		   the opaque card while its own children stay above. */
		position: relative;
		z-index: 1;
		/* Never let the whole card grow past the viewport when its skills are
		   revealed. The sticky bar sits ~3.6rem down (top: 3rem + the bar's own
		   padding), so cap the card a little short of the remaining height and
		   leave a small bottom gap. The fixed header/CV/button keep their size
		   and the skills list (.side-panel-stack) flex-shrinks into its own
		   scroll area to absorb whatever's left — so the card bottom is always
		   on screen. Lifted on mobile below, where the bar scrolls with the page. */
		max-height: calc(100vh - 4.5rem);
		/* Let the collapsible rows inside (the Skills button and the CV pill)
		   animate their height between 0 and auto rather than snapping — height
		   keyword interpolation is opt-in and inherits, so enabling it here covers
		   every descendant that transitions its height. */
		interpolate-size: allow-keywords;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	/* Per-child leading gap — the row-by-row equivalent of the parent's old
	   `gap: 0.4rem`. Non-first children get 0.4rem above them; the
	   collapsible wrappers below override this to 0 in their hidden state
	   and include `margin-top` in their transition list, so the leading
	   gap eases away with the row rather than snapping at the end of the
	   height/display transition. */
	.side-panel > * + * {
		margin-top: var(--gap-xs);
	}

	/* Collapsible row wrapper — the two rows inside the card that can grow
	   in or out of the layout (the CV pill, the Skills+Lock row). Animates
	   its own height by transitioning `grid-template-rows` between `1fr`
	   (open) and `0fr` (closed) — the reliable CSS-only smooth-collapse
	   pattern. The parent .side-panel is a plain flex column, so the
	   card's overall height is the sum of its children's heights: as the
	   wrapper's row track eases from 1fr → 0fr, the card border eases with
	   it in the same frame-by-frame reflow. `min-height: 0` on the inner
	   is what lets a grid item shrink below its content size; `overflow:
	   hidden` clips the content past the wrapper's shrinking edge. The
	   inner .side-panel-cv / .side-panel-action still handle their own
	   opacity fade in and out, and their own hidden-state pointer-events. */
	.collapse-row {
		display: grid;
		grid-template-rows: 1fr;
		transition:
			grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			margin-top 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.collapse-row > * {
		min-height: 0;
		overflow: hidden;
	}

	/* Brighter, glowing silhouette when the card is hovered. */
	.side-panel:hover {
		border-color: color-mix(in srgb, var(--person-color) 55%, var(--border));
		box-shadow: 0 0 26px -2px color-mix(in srgb, var(--person-color) 38%, transparent);
	}

	/* Hovering one card reveals both (they're a paired unit), so the *other*
	   card is part of the same modal even though the pointer isn't on it — give
	   it the same lifted border/glow so it stands off the blurred, desaturated
	   backdrop exactly like the hovered one, rather than sitting flat with just
	   its faint idle border. Also applies to the touch-opened card. */
	.person-bar-inner.reveal .side-panel,
	.side-panel.is-open {
		border-color: color-mix(in srgb, var(--person-color) 55%, var(--border));
		box-shadow: 0 0 26px -2px color-mix(in srgb, var(--person-color) 38%, transparent);
	}

	/* Modal backdrop for a revealed card — blurs and desaturates the rest of the
	   page behind the cards, like the project detail modal's ::backdrop. Sits
	   below the sticky bar (z-index 4) so the opaque cards stay crisp on top.
	   Shown via :has() whenever any card's skills are revealed — hover
	   (.reveal), keyboard focus (:focus-within), or the touch toggle (.is-open)
	   — but never in contact mode, where the cards aren't showing skills. */
	.person-backdrop {
		position: fixed;
		inset: 0;
		z-index: 3;
		background: rgba(4, 6, 10, 0.5);
		-webkit-backdrop-filter: blur(5px) saturate(0.65);
		backdrop-filter: blur(5px) saturate(0.65);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	:global(body:not(.contact-mode):has(.person-bar-inner.reveal)) .person-backdrop,
	:global(body:not(.contact-mode):has(.person-bar-inner:focus-within)) .person-backdrop,
	:global(body:not(.contact-mode):has(.side-panel.is-open)) .person-backdrop {
		opacity: 1;
		/* The panel behaves like a modal: catch pointer events on the backdrop
		   so hover/click on the timeline behind is blocked. A click here isn't
		   inside .side-panel, so the outside-click handler in
		   panelToggle.client.ts collapses the panel — same "click outside to
		   dismiss" contract as any modal. */
		pointer-events: auto;
	}

	/* While a project detail modal is open, the modal's own backdrop already
	   dims the page — suppress the person-cards' own hover/focus backdrop so
	   the two don't stack and darken twice. The person cards themselves are
	   promoted into the top layer via popover (see .person-bar above) so
	   they still read crisp on top. */
	:global(body[data-modal-people]) .person-backdrop {
		opacity: 0 !important;
	}

	/* While a project modal is up, strip the sticky cards back to their
	   pre-arrival intro look — just name + role — collapsing the CV pill
	   and the Skills+Lock row (via their .collapse-row wrappers) so the
	   card matches the very first thing the visitor sees at the top of the
	   site (before the About→Timeline hand-off unlocks the interactive
	   controls). The card border eases with the row because the wrapper
	   animates `grid-template-rows` from 1fr → 0fr — a real per-frame
	   height change — while the inner fades opacity in step. */
	:global(body[data-modal-people]) .collapse-row {
		grid-template-rows: 0fr;
		margin-top: 0;
	}

	:global(body[data-modal-people]) .side-panel-action,
	:global(body[data-modal-people]) .side-panel-cv {
		opacity: 0;
		pointer-events: none;
	}

	.side-panel :global(.person-header) {
		padding: 0.9rem 1rem 0.4rem;
	}

	/* The CV pill is deliberately absent from the skills-revealed card — it only
	   appears once the bar flips into contact mode (further down), where the two
	   cards become the contact cards above the Contact section. So it stays fully
	   hidden on hover, keyboard focus, and the touch toggle. */
	/* The CV pill is deliberately absent from the skills-revealed card — it only
	   appears once the bar flips into contact mode (further down), where the two
	   cards become the contact cards above the Contact section. The height of
	   its slot is owned by the parent .collapse-row wrapper (see above); this
	   rule just fades the pill's own contents. */
	.side-panel-cv {
		display: flex;
		justify-content: flex-start;
		padding: 0 1rem;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	/* Slot closed by default — the CV pill only unfolds in contact mode. */
	.collapse-row:has(> .side-panel-cv) {
		grid-template-rows: 0fr;
		margin-top: 0;
	}

	/* Toggle and LinkedIn share one cell and crossfade between each other when
	   contact mode flips — no layout jump. */
	/* Toggle and LinkedIn share one cell and crossfade between each other when
	   contact mode flips — no layout jump. The slot's height belongs to the
	   parent .collapse-row wrapper (see above); this rule just fades the
	   button/LinkedIn contents. */
	.side-panel-action {
		display: grid;
		padding: 0 1rem;
		opacity: 1;
		transition: opacity 0.45s ease;
	}

	/* Until the cards finish sliding out to the sides they're a purely visual,
	   non-interactive intro: no Skills button (so the resting card is just its
	   title), and nothing hoverable, openable, or glowing. Both switch on only
	   once docked — body.cards-arrived, set by personPhotos.client.ts when the
	   split completes. pointer-events:none also blocks every :hover effect
	   (glow, photo warm-up) and the toggle click in one stroke. */
	:global(body:not(.cards-arrived)) .person-bar-inner {
		pointer-events: none;
	}

	/* .person-slot has pointer-events:auto (so the bar's empty centre stays
	   click-through), which lets :hover and pointerenter fire on the slot even
	   though the parent .person-bar-inner has pointer-events:none above. Explicitly
	   kill them on the slot too until the cards have arrived. */
	:global(body:not(.cards-arrived)) .person-slot {
		pointer-events: none;
	}

	/* Skills+Lock hidden during the intro — the wrapper is closed and its
	   leading gap collapsed so no seam remains between Name+Role and the
	   (currently-hidden) skills stack below. The inner also fades to 0
	   opacity and blocks pointer events so the button can't be tabbed to. */
	:global(body:not(.cards-arrived)) .collapse-row:has(> .side-panel-action) {
		grid-template-rows: 0fr;
		margin-top: 0;
	}

	:global(body:not(.cards-arrived)) .side-panel-action {
		opacity: 0;
		pointer-events: none;
	}

	.side-panel-action > * {
		grid-area: 1 / 1;
		justify-self: start;
		transition: opacity 0.4s ease;
	}

	/* "Skills" button styled like the CV pill: person-tinted soft fill, bold,
	   same rounded silhouette. */
	.panel-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: var(--pad-btn);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 600;
		cursor: pointer;
		color: var(--person-color);
		background: color-mix(in srgb, var(--person-color) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--person-color) 45%, transparent);
		border-radius: var(--r-full);
		/* Same person-tinted glint as the CV pill above it, offset the other
		   way so the pair drift out of step. */
		--sheen-color: var(--person-color);
		--sheen-strength: 0.16;
		--sheen-delay: -5s;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			opacity 0.4s ease;
	}

	/* Clicking Skills locks the paired reveal open (see panelToggle.client.ts,
	   which sets .locked on the bar). While locked, both cards' buttons hold the
	   same filled "stronger" state as hover — together, so the pair reads as one
	   pinned-open unit even after the pointer leaves. */
	.panel-toggle:hover,
	.panel-toggle:focus-visible,
	.person-bar-inner.locked .panel-toggle,
	.side-panel.is-open .panel-toggle {
		color: var(--bg);
		background: var(--person-color);
		border-color: var(--person-color);
		box-shadow: 0 0 18px 1px color-mix(in srgb, var(--person-color) 55%, transparent);
	}

	.panel-toggle-chev {
		transition: transform 0.2s ease;
	}

	/* Wraps the Skills button + its "Lock" checkbox in a single row so they
	   crossfade as one unit with the LinkedIn cell above (both are placed in
	   grid cell 1/1 of .side-panel-action). */
	.panel-toggle-wrap {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}

	.person-slot--right .panel-toggle-wrap {
		flex-direction: row-reverse;
	}

	.side-panel.is-open .panel-toggle-chev,
	.person-bar-inner.locked .panel-toggle-chev {
		transform: rotate(180deg);
	}

	/* LinkedIn shown only in contact mode (crossfaded in over the toggle). */
	.side-panel-linkedin {
		opacity: 0;
		pointer-events: none;
		/* Person-tinted — Mitko's link glows ember, Ádám's honey — so the
		   attribution reads with the same color language the rest of each
		   panel already carries. */
		--link-color: var(--person-color);
	}

	/* LinkedIn styled as a CV-style action pill (see CvDownloadLink.astro),
	   tinted with the person's own colour and glinting via the shared
	   `.btn-sheen` class — so email/LinkedIn on the studio card and each
	   person's LinkedIn all read as the same button family. */
	.side-panel-linkedin :global(.linkedin-pill) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: var(--pad-btn);
		border-radius: var(--r-full);
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration: none;
		color: var(--person-color);
		background: color-mix(in srgb, var(--person-color) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--person-color) 45%, transparent);
		--sheen-color: var(--person-color);
		--sheen-strength: 0.16;
		--sheen-delay: -2s;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Second person's pill drifts out of step with the first. */
	.person-slot--right .side-panel-linkedin :global(.linkedin-pill) {
		--sheen-delay: -5s;
	}

	.side-panel-linkedin :global(.linkedin-pill:hover),
	.side-panel-linkedin :global(.linkedin-pill:focus-visible) {
		color: var(--bg);
		background: var(--person-color);
		border-color: var(--person-color);
		transform: translateY(-1px);
		box-shadow:
			0 0 20px 2px color-mix(in srgb, var(--person-color) 55%, transparent),
			0 0 0 1px var(--person-color);
	}

	.side-panel-linkedin :global(.linkedin-pill:focus-visible) {
		outline: 2px solid var(--person-color);
		outline-offset: 2px;
	}

	/* Drop the ExternalLink's underline sweep on the filled pill; keep the "↗"
	   icon nudging on hover as a hint. */
	.side-panel-linkedin :global(.linkedin-pill .external-link-label::after) {
		display: none;
	}

	.side-panel-linkedin :global(.linkedin-pill:hover .external-link-icon),
	.side-panel-linkedin :global(.linkedin-pill:focus-visible .external-link-icon) {
		transform: translate(2px, -2px);
	}

	/* Collapsed by default; skills reveal via the JS `.reveal` class (hover,
	   both cards together) or the toggle's is-open (touch). When revealed and
	   taller than the viewport allows, the card scrolls its own content here
	   (capped height + contained overscroll) rather than letting the page
	   scroll behind it — the modal behaviour paired with .person-backdrop and
	   the wheel handling in panelToggle.client.ts. */
	.side-panel-stack {
		/* Skills panel toggle uses the same fast ease as the slot's horizontal
		   shrink above (0.14s cubic-bezier) so opening/closing the skills feels
		   like one animation with the card resize. `interpolate-size` opts in
		   to keyword sizing so `height: 0` ↔ `height: auto` interpolates
		   frame-by-frame — the panel's own border eases in step, no snap.
		   Collapsed state uses `overflow: hidden` to clip content past the
		   shrinking edge; the open-state rules below re-enable overflow-y:auto
		   so the skills list can still scroll internally when the panel is
		   capped by the viewport-relative max-height. */
		height: 0;
		min-height: 0;
		overflow: hidden;
		interpolate-size: allow-keywords;
		transition: height 0.14s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Slimmer take on the site-wide scrollbar (see Layout.astro) for the
	   revealed skills — a light bar inside the narrow card, same tinted thumb. */
	.side-panel-stack::-webkit-scrollbar {
		width: 8px;
	}

	.side-panel.is-open .side-panel-stack {
		height: auto;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	@media (hover: hover) and (pointer: fine) {
		.person-bar-inner.reveal .side-panel-stack,
		.person-bar-inner:focus-within .side-panel-stack {
			height: auto;
			overflow-y: auto;
			overscroll-behavior: contain;
		}
	}

	/* While a project modal is up, lock both person cards in their resting
	   closed state — the intro-beginning look. Hover reveal and any prior
	   is-open expansion are both suppressed so the sticky bar reads exactly
	   as it did at the top of the site. */
	:global(body[data-modal-people]) .side-panel.is-open .side-panel-stack,
	:global(body[data-modal-people]) .person-bar-inner.reveal .side-panel-stack,
	:global(body[data-modal-people]) .person-bar-inner:focus-within .side-panel-stack {
		height: 0;
		overflow: hidden;
	}

	/* Right-hand card mirrors to the right edge. */
	.person-slot--right :global(.person-header) {
		text-align: right;
	}

	.person-slot--right .side-panel-cv {
		justify-content: flex-end;
	}

	.person-slot--right .side-panel-action > * {
		justify-self: end;
	}

	/* The active filter tag, echoed under the (collapsed) card while filtering
	   — a button that clears the filter on click. */
	.card-filter {
		padding: 0.15rem 1rem 0;
	}

	.person-slot--right .card-filter {
		text-align: right;
	}

	.card-filter-tag {
		font-family: inherit;
		cursor: pointer;
		border: none;
		display: inline-block;
		font-size: var(--text-sm);
		font-weight: 600;
		padding: var(--pad-tag);
		border-radius: var(--r-full);
		background: var(--person-color);
		color: var(--bg);
		box-shadow: 0 0 14px 1px color-mix(in srgb, var(--person-color) 55%, transparent);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.card-filter-tag:hover,
	.card-filter-tag:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 0 20px 3px color-mix(in srgb, var(--person-color) 70%, transparent);
		outline: none;
	}

	/* ---- Contact mode: the person cards become contact cards, in place ----
	   As the reader scrolls into the closing Contact section (see
	   sections/Contact.astro, which is where the "Contact" title + studio card
	   live, in normal page flow), each person card swaps its Skills button for
	   its LinkedIn link — so the two people read as contact cards pinned above
	   that section. */
	:global(body.contact-mode) .panel-toggle {
		opacity: 0;
		pointer-events: none;
	}

	:global(body.contact-mode) .side-panel-linkedin {
		opacity: 1;
		pointer-events: auto;
	}

	/* No skills panel in contact mode. */
	:global(body.contact-mode) .side-panel-stack {
		display: none !important;
	}

	/* CV pill stays put in contact mode, where the cards read as contact cards
	   even though they aren't hover-revealed. Its slot's height opens via
	   the wrapper's grid-template-rows transition; the pill itself just
	   fades in. */
	:global(body.contact-mode) .collapse-row:has(> .side-panel-cv) {
		grid-template-rows: 1fr;
		margin-top: 0.4rem;
	}

	:global(body.contact-mode) .side-panel-cv {
		opacity: 1;
	}

	/* Under reduced motion the rest of the bar snaps rather than eases (photos,
	   contact snap), so keep the Skills button and CV pill consistent: reveal them
	   instantly with no height/opacity travel. */
	@media (prefers-reduced-motion: reduce) {
		.side-panel-action,
		.side-panel-cv,
		.collapse-row {
			transition: none;
		}
	}

	.timeline-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1600px;
		margin: 0 auto;
		/* Real scrollable empty space under the last company/project entry — more
		   than half the viewport, so at the "Projects" rest position (Contact just
		   peeking in at the bottom, see contactSnap.client.ts) the bottom of the
		   last entry sits *above* the middle of the screen. The reader then scrolls
		   through actual empty space before the directional snap into Contact
		   fires; nothing is faded in over the timeline tail. */
		padding-bottom: 60vh;
	}

	/* ---- Filter modal ---------------------------------------------------
	   Filtering doesn't collapse the page in place — it lifts the filtered
	   Timeline jobs/projects into a centered modal panel over a dimmed
	   backdrop, so the reader sees just the filtered results, not the whole
	   site. Dismiss by clicking the backdrop, the panel chip's ✕, or Escape
	   (see filterModal.client.ts / tagFilter.client.ts). */
	.filter-backdrop {
		position: fixed;
		inset: 0;
		z-index: 25;
		background: rgba(4, 6, 10, 0.74);
		-webkit-backdrop-filter: blur(3px);
		backdrop-filter: blur(3px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	:global(body.filter-active) .filter-backdrop {
		opacity: 1;
		pointer-events: auto;
	}

	/* Filter chip — the "Filtered by … ✕" pill that clears the active filter.
	   Fixed just above the .timeline-area modal (which lifts to top: 4.5rem in
	   the filter view), with a small gap between its bottom edge and the
	   modal's top. Sitting outside the modal's scroll container means nothing
	   in the results can pass under the chip while the reader scrolls. */
	.filter-chip-shield {
		position: fixed;
		top: 2rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 28;
		display: flex;
		justify-content: center;
	}

	.filter-chip-shield:has(.filter-chip[hidden]) {
		display: none;
	}

	/* Same visual language as the Project detail's link-chip (see
	   .project-link-chip in ProjectDetail.astro), minus the arrow-drift, so
	   the two chips read as one system. Opaque so it stays legible when a
	   playing video happens to sit right behind it. */
	.filter-chip {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		width: max-content;
		padding: var(--pad-chip);
		border-radius: var(--r-full);
		font-family: inherit;
		font-size: var(--text-ui);
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.2;
		color: var(--accent-3);
		background: color-mix(in srgb, var(--accent) 12%, var(--bg));
		border: 1px solid color-mix(in srgb, var(--accent-3) 55%, var(--border));
		cursor: pointer;
		/* A stronger-than-default idle glint so the pill visibly reads as a
		   live click target while it sits alone above the results — no other
		   hover affordance is present at that spot. */
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.35;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.15s ease;
	}

	.filter-chip[hidden] {
		display: none;
	}

	.filter-chip:hover,
	.filter-chip:focus-visible,
	.filter-chip:active {
		color: var(--bg);
		background: var(--accent-3);
		border-color: var(--accent-3);
		box-shadow: 0 0 18px 1px color-mix(in srgb, var(--accent-3) 55%, transparent);
	}

	.filter-chip:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 3px;
	}

	.filter-chip-label strong {
		color: inherit;
	}

	.filter-chip-icon {
		font-size: 0.9em;
		line-height: 1;
	}

/* Filtering: hide the original timeline (rendered by the child Timeline — use :global for #timeline) and drop the original page headings/labels when the filter modal is active so the modal shows a flat project list. */
	:global(body.filter-active #timeline) {
		display: none;
	}

