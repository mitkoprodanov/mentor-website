---
import Section from '../Section.astro';
import Vision from '../common/Vision.astro';
import { asset } from '../../utils/asset';

const logoSrc = asset('/logo/primary.png');
const maskUrl = `url(${logoSrc})`;
---

<Section id="about" class="about">
	<div class="hero-content">
		<h1>
			<img src={logoSrc} alt="Mentor Game Studio" class="hero-logo" />
			<span class="hero-shine" style={`-webkit-mask-image: ${maskUrl}; mask-image: ${maskUrl};`} aria-hidden="true"></span>
		</h1>
		{/* The pitch sentence with clickable value-prop parts, in place of the old
		    tagline + vision lines. */}
		<Vision variant="hero" scopeId="hero" />
	</div>
	<a href="#timeline" class="scroll-cue" aria-label="Scroll to timeline section">↓</a>
</Section>

<noscript>
	<style>
		.hero-logo {
			opacity: 1 !important;
			transform: none !important;
		}
		.hero-shine {
			display: none !important;
		}
	</style>
</noscript>

<style>
	/* .about is applied to <section>, which is rendered by Section.astro — :global()
	   is required here so this rule isn't scoped away from that element. */
	:global(.about) {
		position: relative;
		background:
			radial-gradient(ellipse at 50% 30%, var(--accent-soft), transparent 60%),
			var(--bg);
		text-align: center;
	}

	/* The hero no longer fills the whole first screen: it sits in the upper
	   portion and the two founders' photos + card headers (pulled up from the
	   sticky person bar just below) fill the lower portion, so opening the site
	   shows the studio *and* the team at once. So drop Section's forced 100vh
	   min-height and centre-justification here, and size the section with a
	   bottom pad just large enough to seat the person bar in the lower part of
	   the first screen — from where it splits out to the sides as you scroll.
	   Targets the #about id (also set by Section.astro) rather than the .about
	   class: Section's own `padding`/`min-height` land on the same element, and
	   an id selector unambiguously outranks a class-only override either way. */
	:global(#about) {
		min-height: auto;
		justify-content: flex-start;
		padding-bottom: clamp(9rem, 4rem + 16vh, 15rem);
	}

	.hero-content h1 {
		position: relative;
		margin: 0;
		line-height: 0;
	}

	.hero-logo {
		width: min(90vw, 420px);
		height: auto;
		opacity: 0;
		transform: scale(0);
	}

	/* A light streak that sweeps once across the logo after it fades in.
	   Masked by the logo artwork itself (its own alpha channel), so the
	   shine only ever shows up over pixels that are actually part of the
	   mark — it automatically fits the M/wordmark/trail's exact silhouette
	   with no coordinate-guessing against the raster needed. */
	.hero-shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.9) 50%, transparent 60%);
		background-size: 300% 100%;
		background-position: 150% 0;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		opacity: 0;
		pointer-events: none;
	}

	/* Reveal sequence, replayed by heroReveal.client.ts whenever the hero scrolls
	   into view (including on first load): the logo fades/scales in, then a light
	   shine sweeps across it. The pitch sentence has its own fade-in (in
	   ThoughtCloud.astro). */
	.hero-content.is-revealed .hero-logo {
		animation: hero-logo-fade-in 1250ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-content.is-revealed .hero-shine {
		animation: hero-shine-sweep 700ms ease-out 1100ms both;
	}

	@keyframes hero-logo-fade-in {
		from {
			opacity: 0;
			transform: scale(0);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes hero-shine-sweep {
		0% {
			opacity: 0;
			background-position: 150% 0;
		}
		15% {
			opacity: 1;
		}
		85% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			background-position: -50% 0;
		}
	}

	@media (max-width: 900px) {
		:global(#about) {
			padding-bottom: clamp(20rem, 4rem + 30vh, 32rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-logo {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
		.hero-shine {
			animation: none !important;
			opacity: 0 !important;
		}
	}

	.scroll-cue {
		position: absolute;
		/* Anchored to the viewport height, not `bottom` (which now measures
		   from .about's much-taller bottom edge, thanks to #about's extra
		   padding-bottom above) — this keeps it visible near the bottom of
		   the first screen without scrolling, while that extra gap still
		   grows the section underneath it as intended. */
		top: calc(80vh - 3.5rem);
		text-decoration: none;
		font-size: 1.5rem;
		color: var(--fg-muted);
		animation: bounce 2s infinite;
	}

	@keyframes bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(8px);
		}
	}
</style>

<script>
	import '../../scripts/heroReveal.client';
	import '../../scripts/vision.client';
</script>
