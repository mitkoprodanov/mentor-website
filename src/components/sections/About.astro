---
import Section from '../Section.astro';
---

<Section id="about" class="about">
	<div class="hero-content">
		<h1>
			<img src="/logo/primary.png" alt="Mentor Game Studio" class="hero-logo" />
			<span class="hero-shine" aria-hidden="true"></span>
		</h1>
		<p class="tagline">Battle-tested game developer team built for collaboration.</p>
		<p class="vision">Expanding our network to bring on more specialized talent as we grow.</p>
	</div>
	<a href="#timeline" class="scroll-cue" aria-label="Scroll to timeline section">↓</a>
</Section>

<noscript>
	<style>
		.hero-logo {
			opacity: 1 !important;
			transform: none !important;
		}
		.hero-shine {
			display: none !important;
		}
		.tagline,
		.vision {
			opacity: 1 !important;
			transform: none !important;
		}
	</style>
</noscript>

<style>
	/* .about is applied to <section>, which is rendered by Section.astro — :global()
	   is required here so this rule isn't scoped away from that element. */
	:global(.about) {
		position: relative;
		background:
			radial-gradient(ellipse at 50% 30%, var(--accent-soft), transparent 60%),
			var(--bg);
		text-align: center;
	}

	/* Extra room below the (vertically centered) hero content, on top of
	   Section.astro's base 4rem — so the tagline/vision line have scrolled
	   well out of view by the time the Timeline's first entry appears,
	   instead of the two overlapping in the viewport. Targets the #about id
	   (also set by Section.astro) rather than the .about class: Section's
	   own `padding: 4rem 1.5rem` shorthand has equal specificity to a
	   class-only selector here, and — evidently — lands later in the
	   compiled cascade, so a same-specificity override was silently losing
	   to it. An id selector unambiguously outranks it either way. */
	:global(#about) {
		padding-bottom: calc(4rem + 50vh);
	}

	.hero-content h1 {
		position: relative;
		margin: 0;
		line-height: 0;
	}

	.hero-logo {
		width: min(90vw, 420px);
		height: auto;
		opacity: 0;
		transform: scale(0);
	}

	/* A light streak that sweeps once across the logo after it fades in.
	   Masked by the logo artwork itself (its own alpha channel), so the
	   shine only ever shows up over pixels that are actually part of the
	   mark — it automatically fits the M/wordmark/trail's exact silhouette
	   with no coordinate-guessing against the raster needed. */
	.hero-shine {
		position: absolute;
		inset: 0;
		background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.9) 50%, transparent 60%);
		background-size: 300% 100%;
		background-position: 150% 0;
		-webkit-mask-image: url('/logo/primary.png');
		mask-image: url('/logo/primary.png');
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		opacity: 0;
		pointer-events: none;
	}

	.tagline {
		color: var(--fg-muted);
		font-size: clamp(1rem, 2vw, 1.35rem);
		margin-top: 1rem;
		opacity: 0;
		transform: translateY(10px);
	}

	.vision {
		color: var(--fg-muted);
		font-size: 0.9rem;
		margin-top: 0.5rem;
		opacity: 0;
		transform: translateY(10px);
	}

	/* Reveal sequence, replayed by heroReveal.client.ts whenever the hero
	   scrolls into view (including on first load): the logo fades/scales
	   in, then as the light shine starts sweeping across it, the tagline
	   and vision line start fading up right alongside it (staggered
	   200ms apart from each other), rather than waiting for the shine to
	   finish first. */
	.hero-content.is-revealed .hero-logo {
		animation: hero-logo-fade-in 1250ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-content.is-revealed .hero-shine {
		animation: hero-shine-sweep 700ms ease-out 1100ms both;
	}

	.hero-content.is-revealed .tagline {
		animation: hero-line-in 450ms cubic-bezier(0.22, 1, 0.36, 1) 1400ms both;
	}

	.hero-content.is-revealed .vision {
		animation: hero-line-in 450ms cubic-bezier(0.22, 1, 0.36, 1) 1600ms both;
	}

	@keyframes hero-logo-fade-in {
		from {
			opacity: 0;
			transform: scale(0);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes hero-shine-sweep {
		0% {
			opacity: 0;
			background-position: 150% 0;
		}
		15% {
			opacity: 1;
		}
		85% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			background-position: -50% 0;
		}
	}

	@keyframes hero-line-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-logo {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
		.hero-shine {
			animation: none !important;
			opacity: 0 !important;
		}
		.tagline,
		.vision {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}

	.scroll-cue {
		position: absolute;
		/* Anchored to the viewport height, not `bottom` (which now measures
		   from .about's much-taller bottom edge, thanks to #about's extra
		   padding-bottom above) — this keeps it visible near the bottom of
		   the first screen without scrolling, while that extra gap still
		   grows the section underneath it as intended. */
		top: calc(80vh - 3.5rem);
		text-decoration: none;
		font-size: 1.5rem;
		color: var(--fg-muted);
		animation: bounce 2s infinite;
	}

	@keyframes bounce {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(8px);
		}
	}
</style>

<script>
	import '../../scripts/heroReveal.client';
</script>
