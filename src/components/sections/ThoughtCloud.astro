---
/**
 * The hero pitch: one sentence under the logo whose value-prop phrases are
 * hoverable "thought parts". Each line has one left-side part and one right-side
 * part; hovering reveals that thought's detail in a panel flanking the sentence
 * (left parts → left panel, right parts → right panel). Below 1180px both panels
 * fall back to a centred card below the sentence. Copy lives in data/thoughts.ts.
 */
import { thoughts } from '../../data/thoughts';

const byId = Object.fromEntries(thoughts.map((t) => [t.id, t]));

// Label shown in the detail card title — matches the sentence phrasing, not thoughts.ts titles.
const labelFor: Record<string, string> = {
	'in-sync':            'battle-tested duo',
	'shipped-experiences': 'proven experience',
	'easy-integration':   'easy integration',
	'true-ownership':     'true ownership',
	'complete-development': 'complete development',
	'built-to-scale':     'ready to scale',
};

// Sentence segments: plain strings, { br } for line breaks, or clickable parts
// tagged with the id of their thought and which side their detail panel appears on.
type Seg = string | { br: true } | { id: string; text: string; side: 'left' | 'right' };

const sentence: Seg[] = [
	'A ',
	{ id: 'in-sync',            text: 'battle-tested duo',    side: 'left'  },
	' with ',
	{ id: 'shipped-experiences', text: 'proven experience',   side: 'right' },
	' to build on,',
	{ br: true },
	'we offer ',
	{ id: 'easy-integration',   text: 'easy integration',     side: 'left'  },
	' while taking ',
	{ id: 'true-ownership',     text: 'true ownership',       side: 'right' },
	' of our work seriously',
	{ br: true },
	'— bringing together ',
	{ id: 'complete-development', text: 'complete development', side: 'left' },
	" that's ",
	{ id: 'built-to-scale',     text: 'ready to scale',       side: 'right' },
	'.',
];

const leftIds  = ['in-sync', 'easy-integration', 'complete-development'];
const rightIds = ['shipped-experiences', 'true-ownership', 'built-to-scale'];
---

<div class="thought-sentence">
	{/* Left detail panel — shown to the left of the sentence on wide screens */}
	<div class="sentence-detail detail-left" aria-live="polite">
		{
			leftIds.map((id) => (
				<div class="detail" id={`thought-detail-${id}`} data-detail hidden>
					<span class="detail-title">{labelFor[id]}</span>
					<span class="detail-text">{byId[id].description}</span>
				</div>
			))
		}
	</div>

	<p class="sentence">
		{
			sentence.map((seg) =>
				typeof seg === 'string' ? (
					seg
				) : 'br' in seg ? (
					<br />
				) : (
					<button
						class="part btn-sheen"
						type="button"
						data-thought-part
						data-side={seg.side}
						aria-expanded="false"
						aria-controls={`thought-detail-${seg.id}`}
					>
						{seg.text}
					</button>
				),
			)
		}
	</p>

	{/* Right detail panel — shown to the right of the sentence on wide screens */}
	<div class="sentence-detail detail-right" aria-live="polite">
		{
			rightIds.map((id) => (
				<div class="detail" id={`thought-detail-${id}`} data-detail hidden>
					<span class="detail-title">{labelFor[id]}</span>
					<span class="detail-text">{byId[id].description}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.thought-sentence {
		position: relative;
		max-width: 44rem;
		margin: 1.6rem auto 0;
		animation: sentence-in 550ms cubic-bezier(0.22, 1, 0.36, 1) 1250ms both;
	}

	@keyframes sentence-in {
		from {
			opacity: 0;
			transform: translateY(9px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.thought-sentence {
			animation: none;
		}
	}

	/* ── Sentence ──────────────────────────────────────────────────────────── */

	/* Stagger the drifting sheen so the six thought parts never glint in unison. */
	.part:nth-of-type(2) { --sheen-delay: -1.5s; }
	.part:nth-of-type(3) { --sheen-delay: -3s; }
	.part:nth-of-type(4) { --sheen-delay: -4.5s; }
	.part:nth-of-type(5) { --sheen-delay: -6s; }
	.part:nth-of-type(6) { --sheen-delay: -7.5s; }

	.sentence {
		margin: 0;
		/* Capped a touch lower than before so the long middle line still fits on one
		   line (three lines total) at the small-caps width, without a sprawl-wide
		   container. */
		font-size: clamp(0.95rem, 0.82rem + 0.55vw, 1.05rem);
		line-height: 1.9;
		color: var(--fg-muted);
		/* Render as capital and smaller-capital letters only — no plain lowercase —
		   echoing the all-caps logo type directly above. */
		font-variant-caps: small-caps;
		letter-spacing: 0.02em;
	}

	/* ── Part (hoverable phrase) ───────────────────────────────────────────── */

	.part {
		/* Inherit the sentence's font including small-caps. */
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		/* Same idle-life glint the other clickable surfaces carry (see
		   `.btn-sheen` in Layout.astro). Warm accent, staggered per element so
		   neighbours never flash in unison. */
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.18;

		/* Not a solid material — a soft radial glow that's brightest behind the
		   letters and fades out to the sides (no box edge), plus a faint halo on
		   the glyphs themselves. A whisper of warmth over the dark hero. */
		color: var(--fg);
		background: radial-gradient(
			ellipse 74% 155% at 50% 50%,
			color-mix(in srgb, var(--accent) 15%, rgba(255, 255, 255, 0.08)) 0%,
			color-mix(in srgb, var(--accent) 6%, rgba(255, 255, 255, 0.02)) 48%,
			transparent 80%
		);
		text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 16%, transparent);
		border: 0;
		border-radius: 6px;
		padding: 0.04rem 0.36rem 0.08rem;
		vertical-align: baseline;
		transition:
			background 0.22s ease,
			text-shadow 0.22s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.part:hover {
			background: radial-gradient(
				ellipse 80% 160% at 50% 50%,
				color-mix(in srgb, var(--accent) 26%, rgba(255, 255, 255, 0.14)) 0%,
				color-mix(in srgb, var(--accent) 9%, rgba(255, 255, 255, 0.03)) 48%,
				transparent 82%
			);
			text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 30%, transparent);
		}
	}

	.part:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.3);
		outline-offset: 2px;
	}

	/* Active (detail is open) */
	.part.is-active {
		background: radial-gradient(
			ellipse 80% 160% at 50% 50%,
			color-mix(in srgb, var(--accent) 26%, rgba(255, 255, 255, 0.14)) 0%,
			color-mix(in srgb, var(--accent) 9%, rgba(255, 255, 255, 0.03)) 48%,
			transparent 82%
		);
		text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 30%, transparent);
	}

	/* ── Side detail panels ────────────────────────────────────────────────── */

	.sentence-detail {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 15.5rem;
		text-align: left;
		z-index: 10;
	}

	.detail-left  { right: calc(100% + 1.5rem); }
	.detail-right { left:  calc(100% + 1.5rem); }

	/* ── Detail card ───────────────────────────────────────────────────────── */

	.detail {
		background: rgba(12, 15, 20, 0.82);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 0.8rem 1rem;
		box-shadow:
			0 16px 34px -14px rgba(0, 0, 0, 0.75),
			0 4px 12px -6px rgba(0, 0, 0, 0.4);
		animation: detail-in 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.detail[hidden] {
		display: none;
	}

	/* Title matches the sentence phrase — small-caps for visual continuity. */
	.detail-title {
		display: block;
		font-size: 0.88rem;
		font-weight: 600;
		font-variant-caps: small-caps;
		letter-spacing: 0.02em;
		color: var(--fg);
		margin-bottom: 0.3rem;
	}

	.detail-text {
		display: block;
		font-size: 0.8rem;
		font-variant-caps: normal;
		letter-spacing: 0;
		line-height: 1.6;
		color: var(--fg-muted);
	}

	@keyframes detail-in {
		from {
			opacity: 0;
			transform: translateY(-5px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.detail {
			animation: none;
		}
	}

	/* ── Responsive fallback ────────────────────────────────────────────────── */

	/* Not enough room for side panels — both drop to a centred card below the sentence. */
	@media (max-width: 1250px) {
		.sentence-detail {
			top: calc(100% + 1rem);
			left: 50%;
			right: auto;
			transform: translateX(-50%);
			width: min(30rem, 90vw);
		}
	}

	/* On a phone let the detail push the page in normal flow. */
	@media (max-width: 900px) {
		.thought-sentence {
			margin-top: 1.25rem;
		}

		.sentence-detail {
			position: static;
			transform: none;
			width: 100%;
			margin-top: 0.9rem;
		}
	}
</style>
