---
/**
 * The "thought cloud" over the About hero: six category pills that float in a
 * loose grid below the logo, each revealing a fuller description on hover /
 * click / keyboard focus. Copy lives in data/thoughts.ts.
 *
 * Layout & motion (desktop):
 *   • The cloud is position:fixed, so it stays "on top" across the About→Timeline
 *     hand-off — it isn't tied to the About section's own scroll. Each pill is
 *     absolutely anchored on its own point and grows *around that point* when
 *     opened, so opening one never nudges the others ("non-interfering").
 *   • thoughtCloud.client.ts scrubs a three-beat sequence off the scroll
 *     position (per-pill CSS vars --mx/--my/--op/--s), so the beats land in
 *     order: the hero logo + text scrolls out, THEN the pills sweep in from the
 *     left/right edges to their cradle and hold, THEN the person cards begin
 *     their split (personPhotos.client.ts, whose start is tuned to fire just
 *     after) while the pills drift up and fade. A small idle wander (a slow
 *     Lissajous drift ≈ a random unit-circle direction) rides on top throughout.
 *   • The pill background is semi-solid tinted glass so the titles read over the
 *     busy hero without fully hiding it.
 *
 * On a phone (≤900px, matching ScrollyRegion's breakpoint) the cloud drops the
 * fixed floating behaviour entirely and renders as a simple in-flow stack of
 * the same expandable pills — see the media block below and the mobile guard in
 * the client script.
 */
import { thoughts } from '../../data/thoughts';

// Resting anchor for each pill, as (left, top) in *viewport* percentages (the
// cloud fills the screen; the client script then slides the whole cloud as one
// block for the parallax). A dense 3×2 grid — the pills sit close, almost
// touching, as a single tight cluster riding just above the person cards in the
// band between the logo/texts and the timeline.
const anchors = [
	{ tx: '35%', ty: '66%' },
	{ tx: '50%', ty: '66%' },
	{ tx: '65%', ty: '66%' },
	{ tx: '35%', ty: '74%' },
	{ tx: '50%', ty: '74%' },
	{ tx: '65%', ty: '74%' },
];

// A warm, on-brand tint per pill so the six categories read as distinct without
// leaving the site's orange/amber family.
const hues = ['var(--accent)', 'var(--accent-2)', 'var(--accent-3)', 'var(--mentor)', 'var(--accent-2)', 'var(--accent-3)'];
---

<div class="thought-cloud" aria-label="What we bring">
	{
		thoughts.map((thought, i) => (
			<div
				class="thought btn-sheen"
				data-thought
				style={`--tx:${anchors[i % anchors.length].tx};--ty:${anchors[i % anchors.length].ty};--hue:${hues[i % hues.length]};--i:${i}`}
			>
				<button
					class="thought-toggle"
					type="button"
					aria-expanded="false"
					aria-controls={`thought-desc-${thought.id}`}
				>
					<span class="thought-title">{thought.title}</span>
				</button>
				<div class="thought-desc" id={`thought-desc-${thought.id}`} role="region">
					<p>{thought.description}</p>
				</div>
			</div>
		))
	}
</div>

<style>
	/* The fixed field. The client script slides the whole cloud as one block
	   (translateY) for the parallax and fades it via opacity, so no per-pill
	   motion is needed. pointer-events:none so only the pills catch the pointer,
	   and only while the block is live (.is-live). Sits above the person bar
	   (z-index 4) but below the navbar (z-index 10). Starts hidden so there's no
	   pre-JS flash before the script positions it. */
	.thought-cloud {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 6;
		opacity: 0;
		pointer-events: none;
		will-change: transform, opacity;
	}

	.thought-cloud.is-live .thought {
		pointer-events: auto;
	}

	/* The whole thought is one semi-solid tinted-glass card, anchored by its
	   centre on its grid point — so revealing its description grows the box
	   symmetrically around that point and never shifts its neighbours. The pill
	   itself doesn't move; the parent cloud carries the parallax. overflow:hidden
	   clips the collapsed description and the sheen to the radius. */
	.thought {
		position: absolute;
		left: var(--tx);
		top: var(--ty);
		width: 190px;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		overflow: hidden;
		color: var(--fg);
		background: color-mix(in srgb, var(--hue) 15%, color-mix(in srgb, var(--bg-alt) 78%, transparent));
		border: 1px solid color-mix(in srgb, var(--hue) 45%, var(--border));
		border-radius: 14px;
		-webkit-backdrop-filter: blur(7px);
		backdrop-filter: blur(7px);
		box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.6);
		transform: translate(-50%, -50%);
		pointer-events: none;
		/* Faint on-brand glint drifting across the card, staggered per pill so
		   they never flash in unison — the shared "this is clickable" cue. */
		--sheen-color: var(--hue);
		--sheen-strength: 0.14;
		--sheen-delay: calc(var(--i) * -1.5s);
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	/* The always-visible title, and the interaction target (a real button, for
	   click + keyboard). Transparent — the card behind it carries the fill. */
	.thought-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 2.6rem;
		padding: 0.5rem 0.9rem;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		cursor: pointer;
		color: inherit;
		background: none;
		border: none;
		border-radius: 14px;
	}

	.thought-title {
		/* Warm tint on the label, brightening to full fg when the pill opens. */
		color: color-mix(in srgb, var(--hue) 55%, var(--fg));
		transition: color 0.2s ease;
	}

	/* The revealed description: collapsed to nothing at rest, easing open below
	   the title when the pill is engaged. `interpolate-size` lets the max-height
	   animate to its natural content height rather than snapping. */
	.thought-desc {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		interpolate-size: allow-keywords;
		transition:
			max-height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.3s ease,
			margin-top 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.thought-desc p {
		margin: 0;
		padding: 0.7rem 0.9rem 0.85rem;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--fg-muted);
	}

	/* Engaged = hover (on hover-capable pointers), keyboard focus, or the
	   click/tap toggle (.is-open). Raise the pill above its neighbours, solidify
	   its glass, and ease the description open. */
	.thought:focus-within,
	.thought.is-open {
		z-index: 3;
	}

	@media (hover: hover) and (pointer: fine) {
		.thought:hover {
			z-index: 3;
		}
	}

	.thought:focus-within,
	.thought.is-open,
	.thought:hover {
		background: color-mix(in srgb, var(--hue) 20%, var(--bg-alt));
		border-color: color-mix(in srgb, var(--hue) 70%, var(--border));
		box-shadow: 0 0 24px -2px color-mix(in srgb, var(--hue) 45%, transparent);
	}

	.thought:focus-within .thought-title,
	.thought.is-open .thought-title,
	.thought:hover .thought-title {
		color: var(--fg);
	}

	/* Only the hovered/opened pill reveals its text — but reveal on hover only
	   where hover is real (so a tap doesn't leave a stuck-open panel on touch,
	   which uses .is-open instead). */
	.thought.is-open .thought-desc,
	.thought:focus-within .thought-desc {
		max-height: 16rem;
		opacity: 1;
		margin-top: 0.4rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.thought:hover .thought-desc {
			max-height: 16rem;
			opacity: 1;
			margin-top: 0.4rem;
		}
	}

	/* ---- Reduced motion --------------------------------------------------
	   No parallax — the cloud just sits parked, its pills clickable, and the
	   script only shows/hides it by scroll zone. */
	@media (prefers-reduced-motion: reduce) {
		.thought-cloud {
			opacity: 1;
		}
		.thought {
			pointer-events: auto;
		}
	}

	/* ---- Phone (≤900px): drop the fixed parallax -------------------------
	   No room to slide a fixed field over a single-column timeline, so the
	   cloud becomes a normal in-flow, centred stack of the same expandable
	   pills. The client script skips all motion at this width. */
	@media (max-width: 900px) {
		.thought-cloud {
			position: static;
			transform: none;
			width: 100%;
			max-width: 420px;
			height: auto;
			margin: 2.5rem auto 0;
			display: flex;
			flex-direction: column;
			gap: 0.7rem;
			opacity: 1;
			pointer-events: auto;
		}

		.thought {
			position: static;
			left: auto;
			top: auto;
			width: 100%;
			transform: none !important;
			opacity: 1 !important;
			pointer-events: auto;
			animation: none !important;
		}

		.thought-toggle {
			min-height: 2.8rem;
		}
	}
</style>

<noscript>
	<style>
		/* Without JS there's no scroll choreography — render the cloud as a plain
		   centred, in-flow list of the expandable pills (like the phone layout),
		   fully visible. */
		.thought-cloud {
			position: static !important;
			height: auto !important;
			display: flex !important;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.7rem;
			max-width: 900px;
			margin: 2rem auto 0;
			opacity: 1 !important;
			pointer-events: auto !important;
		}
		.thought {
			position: static !important;
			transform: none !important;
			opacity: 1 !important;
			pointer-events: auto !important;
		}
	</style>
</noscript>
