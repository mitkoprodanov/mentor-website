---
/**
 * The hero pitch: one sentence under the logo whose value-prop phrases are
 * clickable "thought parts". Clicking a part reveals that thought's detail in a
 * panel just below the sentence (copy lives in data/thoughts.ts). Static,
 * readable hero copy — it simply scrolls away with the rest of the hero (see
 * the scroll order in About.astro); the click behaviour is in
 * thoughtCloud.client.ts.
 */
import { thoughts } from '../../data/thoughts';

const byId = Object.fromEntries(thoughts.map((t) => [t.id, t]));

// A warm, on-brand tint per part so the clickable phrases read as distinct.
const hueFor: Record<string, string> = {
	'in-sync': 'var(--accent)',
	'shipped-experiences': 'var(--accent-2)',
	'easy-integration': 'var(--accent-3)',
	'true-ownership': 'var(--mentor)',
	'complete-development': 'var(--accent-2)',
	'built-to-scale': 'var(--accent-3)',
};

// The sentence as segments: plain strings are static text; objects are the
// clickable parts, each tied to a thought id for its detail.
type Seg = string | { id: string; text: string };
const sentence: Seg[] = [
	'A ',
	{ id: 'in-sync', text: 'battle-tested duo' },
	' with ',
	{ id: 'shipped-experiences', text: 'shipped experience' },
	' to build on, we offer ',
	{ id: 'easy-integration', text: 'easy integration' },
	' while taking ',
	{ id: 'true-ownership', text: 'true ownership' },
	' of our work seriously — bringing together ',
	{ id: 'complete-development', text: 'complete development' },
	' that’s ',
	{ id: 'built-to-scale', text: 'built to scale' },
	' as we grow.',
];
---

<div class="thought-sentence">
	<p class="sentence">
		{
			sentence.map((seg) =>
				typeof seg === 'string' ? (
					seg
				) : (
					<button
						class="part"
						type="button"
						data-thought-part
						aria-expanded="false"
						aria-controls={`thought-detail-${seg.id}`}
						style={`--hue:${hueFor[seg.id]}`}
					>
						{seg.text}
					</button>
				),
			)
		}
	</p>

	{/* One shared area below the sentence; the clicked part's detail shows here.
	    Absolutely placed so opening it never shifts the logo or the person cards. */}
	<div class="sentence-detail" aria-live="polite">
		{
			thoughts.map((t) => (
				<div class="detail" id={`thought-detail-${t.id}`} data-detail style={`--hue:${hueFor[t.id]}`} hidden>
					<span class="detail-title">{t.title}</span>
					<span class="detail-text">{byId[t.id].description}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.thought-sentence {
		position: relative;
		max-width: 40rem;
		margin: 1.6rem auto 0;
		/* Fades up on load, a beat after the logo's reveal. Self-contained (plays
		   with or without JS); `both` holds it hidden through the delay. */
		animation: sentence-in 550ms cubic-bezier(0.22, 1, 0.36, 1) 1250ms both;
	}

	@keyframes sentence-in {
		from {
			opacity: 0;
			transform: translateY(9px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.thought-sentence {
			animation: none;
		}
	}

	.sentence {
		margin: 0;
		font-size: clamp(1.15rem, 0.85rem + 1.35vw, 1.7rem);
		line-height: 1.6;
		color: var(--fg-muted);
		text-wrap: balance;
	}

	/* A clickable phrase: brighter, tinted, weight-lifted, with a soft underline
	   so it reads as interactive within the muted sentence. Inline button reset. */
	.part {
		font: inherit;
		font-weight: 600;
		color: color-mix(in srgb, var(--hue) 55%, var(--fg));
		background: none;
		border: none;
		padding: 0.05em 0.14em;
		margin: 0 -0.02em;
		border-radius: 6px;
		cursor: pointer;
		white-space: nowrap;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
		box-shadow: inset 0 -0.09em 0 color-mix(in srgb, var(--hue) 55%, transparent);
		transition:
			color 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.part:hover {
			color: var(--fg);
			background: color-mix(in srgb, var(--hue) 16%, transparent);
			box-shadow: inset 0 -0.09em 0 var(--hue);
		}
	}

	.part:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--hue) 70%, transparent);
		outline-offset: 1px;
	}

	/* Active (opened) part: filled pill, so the sentence shows which detail is up. */
	.part.is-active {
		color: var(--bg);
		background: var(--hue);
		box-shadow: 0 0 16px -2px color-mix(in srgb, var(--hue) 55%, transparent);
	}

	/* The detail panel sits just under the sentence, absolutely placed so it
	   overlays the gap before the person cards rather than pushing layout. */
	.sentence-detail {
		position: absolute;
		top: calc(100% + 0.9rem);
		left: 50%;
		transform: translateX(-50%);
		width: min(34rem, 92vw);
		z-index: 5;
	}

	.detail {
		text-align: left;
		background: color-mix(in srgb, var(--hue) 8%, var(--bg-alt));
		border: 1px solid color-mix(in srgb, var(--hue) 45%, var(--border));
		border-radius: 14px;
		padding: 0.85rem 1.1rem;
		box-shadow:
			0 16px 34px -14px rgba(0, 0, 0, 0.75),
			0 0 24px -6px color-mix(in srgb, var(--hue) 30%, transparent);
		animation: detail-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.detail[hidden] {
		display: none;
	}

	.detail-title {
		display: block;
		font-weight: 700;
		font-size: 0.95rem;
		color: color-mix(in srgb, var(--hue) 55%, var(--fg));
		margin-bottom: 0.25rem;
	}

	.detail-text {
		display: block;
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--fg-muted);
	}

	@keyframes detail-in {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.detail {
			animation: none;
		}
	}

	@media (max-width: 900px) {
		.thought-sentence {
			margin-top: 1.25rem;
		}
		.sentence {
			font-size: clamp(1.05rem, 3.6vw, 1.35rem);
		}
		/* On a phone let the detail push the page (no fixed hero gap to overlay). */
		.sentence-detail {
			position: static;
			transform: none;
			width: 100%;
			margin-top: 0.9rem;
		}
	}
</style>
