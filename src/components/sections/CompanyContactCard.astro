---
import { STUDIO_CONTACT } from '../../data/contact';
---

<div id="contact" class="company-card">
	<h3 class="brand-heading">{STUDIO_CONTACT.name}</h3>
	<a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a>
	<a href={STUDIO_CONTACT.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
</div>

<style>
	.company-card {
		background: var(--bg-alt);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.75rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		max-width: 500px;
		width: 100%;
		margin: 3rem auto 0;
	}

	.company-card h3 {
		margin: 0 0 0.25rem;
		font-size: 1.1rem;
	}

	.company-card a {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.95rem;
		word-break: break-word;
	}

	.company-card a:hover {
		text-decoration: underline;
	}
</style>
