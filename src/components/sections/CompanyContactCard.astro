---
import { STUDIO_CONTACT } from '../../data/contact';
import ExternalLink from '../common/ExternalLink.astro';
---

<div class="company-card">
	<h3 class="brand-heading">{STUDIO_CONTACT.name}</h3>
	<p class="contact-lead">Let's talk about your project.</p>
	<div class="contact-links">
		<ExternalLink href={`mailto:${STUDIO_CONTACT.email}`} external={false}>
			{STUDIO_CONTACT.email}
		</ExternalLink>
		<ExternalLink href={STUDIO_CONTACT.linkedin}>LinkedIn</ExternalLink>
	</div>
</div>

<style>
	.company-card {
		/* Same framed-card language the Contact / Timeline pills and the
		   person cards use (see ScrollyRegion.astro's `.side-panel` +
		   `.decor-frame`): opaque dark panel, warm-accent hairline border,
		   a soft warm halo, and (via the outer ::before ring below) a second
		   hairline running just past its edge. Replaces the earlier reddish
		   project-dot border/glow. */
		position: relative;
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border));
		border-radius: 24px;
		padding: 3.5rem 3rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		max-width: 720px;
		width: 100%;
		margin: 0 auto;
		box-shadow: 0 0 32px 4px color-mix(in srgb, var(--accent) 25%, transparent);
		isolation: isolate;
	}

	/* Outer hairline ring — mirrors `.title-toggle::before` on the Timeline
	   and Contact pills, and `.decor-frame` on the person cards. */
	.company-card::before {
		content: '';
		position: absolute;
		inset: -8px -10px;
		border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
		border-radius: 28px;
		pointer-events: none;
	}

	.company-card h3 {
		margin: 0;
		font-size: 2rem;
		letter-spacing: 0.02em;
	}

	.contact-lead {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		color: var(--fg-muted);
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.5rem 2rem;
	}

	.company-card :global(.external-link) {
		font-size: 1.15rem;
	}

	/* The generous desktop padding squeezes the content column to a sliver on
	   a phone (a ~295px card would leave ~200px of usable width) — pull it in
	   so the studio name, lead line, and links have room to breathe. */
	@media (max-width: 600px) {
		.company-card {
			padding: 2.5rem 1.5rem;
			border-radius: 20px;
		}

		.company-card h3 {
			font-size: 1.6rem;
		}
	}
</style>
