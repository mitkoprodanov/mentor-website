---
import { STUDIO_CONTACT } from '../../data/contact';
import ExternalLink from '../common/ExternalLink.astro';
import { asset } from '../../utils/asset';
---

<div class="company-card">
	<h3 class="company-card__wordmark">
		<img src={asset('/logo/horizontal.png')} alt={STUDIO_CONTACT.name} width="490" height="150" loading="lazy" decoding="async" />
	</h3>
	<p class="contact-lead">Let's talk about your project.</p>
	<div class="contact-links">
		<!--
			Split email pill: left segment copies the address to clipboard;
			right segment opens the mailto: link. The outer div keeps the
			same pill shape, border, sheen, and sizing as a regular contact-pill.
			Hook point for future telemetry: contact_email_copy (see script below).
		-->
		<div
			class="contact-pill btn-sheen contact-email-pill"
			role="group"
			aria-label="Company email"
		>
			<button
				class="email-copy-btn"
				type="button"
				aria-label="Copy email address to clipboard"
				data-email={STUDIO_CONTACT.email}
			>
				<!--
					Single clipboard SVG. On copy the .email-copy-check group
					animates: appearing a little below centre, floating up slowly,
					fading out before it reaches the top of the clipboard body.
				-->
				<svg class="email-copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<rect x="9" y="2" width="6" height="4" rx="1" ry="1" />
					<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
					<g class="email-copy-check" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="8 14 11 17 16 11" />
					</g>
				</svg>
			</button>
			<span class="email-pill-sep" aria-hidden="true"></span>
			<a class="email-mailto-link" href={`mailto:${STUDIO_CONTACT.email}`}>
				<span class="email-mailto-text">{STUDIO_CONTACT.email}</span>
				<span class="external-link-icon" aria-hidden="true">↗</span>
			</a>
		</div>
		<ExternalLink href={STUDIO_CONTACT.linkedin} class="contact-pill btn-sheen">LinkedIn</ExternalLink>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.email-copy-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const email = btn.dataset.email;
			if (!email) return;

			const markCopied = () => {
				btn.classList.add('is-copied');
				btn.setAttribute('aria-label', 'Email address copied');
				// Future telemetry hook: contact_email_copy
				setTimeout(() => {
					btn.classList.remove('is-copied');
					btn.setAttribute('aria-label', 'Copy email address to clipboard');
				}, 1500);
			};

			if (navigator.clipboard?.writeText) {
				navigator.clipboard.writeText(email).then(markCopied).catch(() => {
					legacyCopy(email);
					markCopied();
				});
			} else {
				legacyCopy(email);
				markCopied();
			}
		});
	});

	function legacyCopy(text: string): void {
		const ta = document.createElement('textarea');
		ta.value = text;
		ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
		document.body.appendChild(ta);
		ta.select();
		document.execCommand('copy');
		document.body.removeChild(ta);
	}
</script>

<style>
	.company-card {
		/* Same framed-card language the Contact / Timeline pills and the
		   person cards use (see ScrollyRegion.astro's `.side-panel` +
		   `.decor-frame`): opaque dark panel, warm-accent hairline border,
		   a soft warm halo, and (via the outer ::before ring below) a second
		   hairline running just past its edge. Replaces the earlier reddish
		   project-dot border/glow. */
		position: relative;
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--mentor) 55%, var(--border));
		border-radius: var(--r-feature);
		padding: 3.5rem 3rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		max-width: 720px;
		width: 100%;
		margin: 0 auto;
		box-shadow: 0 0 32px 4px color-mix(in srgb, var(--mentor) 25%, transparent);
		isolation: isolate;
	}

	/* Outer hairline ring — mirrors `.title-toggle::before` on the Timeline
	   and Contact pills, and `.decor-frame` on the person cards. */
	.company-card::before {
		content: '';
		position: absolute;
		inset: -8px -10px;
		border: 1px solid color-mix(in srgb, var(--mentor) 42%, transparent);
		border-radius: 28px;
		pointer-events: none;
	}

	/* Studio identity comes from the brand wordmark PNG (extracted from the
	   horizontal lockup on the branding board) rather than typeset text, so
	   "MENTOR / GAME STUDIO" matches the logo exactly — same typeface, spacing,
	   and orange for GAME STUDIO. Sized to fluidly track the card width. */
	.company-card__wordmark {
		margin: 0;
		display: block;
		width: min(360px, 70%);
	}

	.company-card__wordmark img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Match the non-clickable filler in Vision's sentence ("A", "with", "to
	   build on,", …): muted grey, small-caps, open tracking — so the lead line
	   reads as body copy in the same voice as the hero pitch, not as another
	   coloured heading competing with the wordmark. */
	.contact-lead {
		margin: 0 0 0.5rem;
		font-size: clamp(0.95rem, 0.82rem + 0.55vw, 1.05rem);
		line-height: 1.9;
		color: var(--fg-muted);
		font-variant-caps: small-caps;
		letter-spacing: var(--letter-open);
	}

	.contact-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	/* Email + LinkedIn styled as CV-style action pills (see CvDownloadLink.astro):
	   mentor-tinted soft fill, mid-strength border, full-strength label; hover
	   fills solid with a mentor-coloured halo. The metallic glint is provided by
	   the shared `.btn-sheen` class in Layout.astro. */
	.company-card :global(.contact-pill) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: var(--pad-btn-lg);
		border-radius: var(--r-full);
		font-size: var(--text-base);
		font-weight: 600;
		text-decoration: none;
		color: var(--mentor);
		background: color-mix(in srgb, var(--mentor) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--mentor) 45%, transparent);
		--sheen-color: var(--mentor);
		--sheen-strength: 0.16;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Second pill's glint drifts out of sync with the first. */
	.company-card :global(.contact-pill + .contact-pill) {
		--sheen-delay: -3s;
	}

	/* Hover only on pointer devices — prevents :hover sticking after touch tap. */
	@media (hover: hover) {
		.company-card :global(.contact-pill:hover) {
			color: var(--bg);
			background: var(--mentor);
			border-color: var(--mentor);
			transform: translateY(-1px);
			box-shadow:
				0 0 20px 2px color-mix(in srgb, var(--mentor) 55%, transparent),
				0 0 0 1px var(--mentor);
		}
		.company-card :global(.contact-pill:hover .external-link-icon) {
			transform: translate(2px, -2px);
		}
	}

	/* Keyboard focus and JS tap-flash (touch devices). */
	.company-card :global(.contact-pill:focus-visible),
	.company-card :global(.contact-pill.is-tapping:not(.contact-email-pill)) {
		color: var(--bg);
		background: var(--mentor);
		border-color: var(--mentor);
		transform: translateY(-1px);
		box-shadow:
			0 0 20px 2px color-mix(in srgb, var(--mentor) 55%, transparent),
			0 0 0 1px var(--mentor);
	}

	.company-card :global(.contact-pill:focus-visible) {
		outline: 2px solid var(--mentor);
		outline-offset: 2px;
	}

	/* The ExternalLink's built-in underline sweep and the "↗" icon nudge don't
	   read on a filled pill — drop the underline so the label stays clean, and
	   keep the icon inline as a static hint. */
	.company-card :global(.contact-pill .external-link-label::after) {
		display: none;
	}

	.company-card :global(.contact-pill:focus-visible .external-link-icon),
	.company-card :global(.contact-pill.is-tapping .external-link-icon) {
		transform: translate(2px, -2px);
	}

	/* ── Split email pill ────────────────────────────────────────────────────
	   Override the full-fill hover on the wrapper div: each segment fills
	   independently, so the container only holds shape + border + glow.
	   More specific (.contact-pill.contact-email-pill) than .contact-pill
	   so it wins without relying on source order. */
	.company-card :global(.contact-pill.contact-email-pill) {
		padding: 0;
		gap: 0;
	}

	/* Wrapper glow: pointer hover only on hover-capable devices; focus/tap-flash
	   and the copy animation always. :has(.is-copied) keeps the glow alive for
	   the full 1.5 s checkmark animation even after blur clears :focus-within. */
	@media (hover: hover) {
		.company-card :global(.contact-pill.contact-email-pill:hover) {
			color: var(--mentor);
			background: color-mix(in srgb, var(--mentor) 14%, transparent);
			border-color: color-mix(in srgb, var(--mentor) 45%, transparent);
			transform: none;
			box-shadow:
				0 0 20px 2px color-mix(in srgb, var(--mentor) 55%, transparent),
				0 0 0 1px var(--mentor);
		}
		/* Suppress the global icon nudge on the outer pill hover — the mailto
		   segment manages its own nudge on its individual hover. */
		.company-card :global(.contact-email-pill:hover .external-link-icon) {
			transform: none;
		}
	}

	.company-card :global(.contact-pill.contact-email-pill:focus-within),
	.company-card :global(.contact-pill.contact-email-pill:has(.is-copied)),
	.company-card :global(.contact-pill.contact-email-pill:has(.is-tapping)) {
		color: var(--mentor);
		background: color-mix(in srgb, var(--mentor) 14%, transparent);
		border-color: color-mix(in srgb, var(--mentor) 45%, transparent);
		transform: none;
		box-shadow:
			0 0 20px 2px color-mix(in srgb, var(--mentor) 55%, transparent),
			0 0 0 1px var(--mentor);
	}

	/* Copy button — left segment */
	.company-card :global(.email-copy-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		/* Match pill vertical padding; inner-side horizontal is slightly narrower
		   than outer-side to keep the icon visually centred in its touch target. */
		padding: 0.85rem 0.65rem 0.85rem 1.4rem;
		background: transparent;
		border: none;
		cursor: pointer;
		color: inherit;
		font: inherit;
		/* Round only the pill's left end — right end is straight to meet the sep. */
		border-radius: var(--r-full) 0 0 var(--r-full);
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	@media (hover: hover) {
		.company-card :global(.email-copy-btn:hover) {
			color: var(--bg);
			background: var(--mentor);
		}
	}

	.company-card :global(.email-copy-btn:focus-visible),
	.company-card :global(.email-copy-btn.is-tapping),
	.company-card :global(.email-copy-btn.is-copied) {
		color: var(--bg);
		background: var(--mentor);
	}

	.company-card :global(.email-copy-btn:focus-visible) {
		outline: 2px solid var(--mentor);
		outline-offset: -2px;
	}

	/* Vertical separator between copy button and mailto link */
	.company-card :global(.email-pill-sep) {
		display: block;
		width: 1px;
		align-self: stretch;
		flex-shrink: 0;
		background: color-mix(in srgb, var(--mentor) 40%, transparent);
		/* Inset slightly so it doesn't reach the pill's rounded ends */
		margin: 0.35rem 0;
	}

	/* Mailto link — right segment */
	.company-card :global(.email-mailto-link) {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.85rem 1.4rem 0.85rem 0.65rem;
		text-decoration: none;
		color: inherit;
		font-weight: 600;
		/* Round only the pill's right end. */
		border-radius: 0 var(--r-full) var(--r-full) 0;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	@media (hover: hover) {
		.company-card :global(.email-mailto-link:hover) {
			color: var(--bg);
			background: var(--mentor);
		}
		.company-card :global(.email-mailto-link:hover .external-link-icon) {
			transform: translate(2px, -2px);
		}
	}

	.company-card :global(.email-mailto-link:focus-visible),
	.company-card :global(.email-mailto-link.is-tapping) {
		color: var(--bg);
		background: var(--mentor);
	}

	.company-card :global(.email-mailto-link:focus-visible) {
		outline: 2px solid var(--mentor);
		outline-offset: -2px;
	}

	.company-card :global(.email-mailto-link:focus-visible .external-link-icon),
	.company-card :global(.email-mailto-link.is-tapping .external-link-icon) {
		transform: translate(2px, -2px);
	}

	/* Keep the ↗ icon consistent size with the outer pill rule. */
	.company-card :global(.email-mailto-link .external-link-icon) {
		font-size: 0.85em;
		transition: transform 0.2s ease;
	}

	/* ── Clipboard icon ─────────────────────────────────────────────────── */
	.company-card :global(.email-copy-icon) {
		display: block;
		flex-shrink: 0;
	}

	/* ── Animated checkmark inside the clipboard ─────────────────────────
	   The <g class="email-copy-check"> starts invisible. When .is-copied is
	   added to the button it plays once: appearing a little below the
	   clipboard's centre, floating slowly upward, then fading out before
	   reaching the top edge of the clipboard body.
	   Duration matches the 1500ms timeout in the click handler so the
	   animation has finished before the class is removed. */
	.company-card :global(.email-copy-check) {
		opacity: 0;
	}

	.company-card :global(.email-copy-btn.is-copied .email-copy-check) {
		animation: email-check-float 1.5s linear forwards;
	}

	@keyframes email-check-float {
		/* 0 – 18 %  (0 – 270 ms): fade in while rising from y+4 */
		0%   { transform: translateY(4px);   opacity: 0; }
		18%  { transform: translateY(1.5px); opacity: 1; }
		/* 18 – 70 % (270 – 1050 ms): slow rise, fully visible */
		70%  { transform: translateY(-2px);  opacity: 1; }
		/* 70 – 86 % (1050 – 1290 ms): fade out before the top */
		86%  { transform: translateY(-4px);  opacity: 0; }
		/* 86 – 100 % (1290 – 1500 ms): gone, held for clean class removal */
		100% { transform: translateY(-4px);  opacity: 0; }
	}

	/* Reduced motion: pure crossfade, no translate */
	@media (prefers-reduced-motion: reduce) {
		.company-card :global(.email-copy-btn.is-copied .email-copy-check) {
			animation: email-check-fade 1.5s linear forwards;
		}
	}

	@keyframes email-check-fade {
		0%, 10%  { opacity: 0; }
		20%, 75% { opacity: 1; }
		90%, 100% { opacity: 0; }
	}

	/* ── Mobile ──────────────────────────────────────────────────────────── */
	@media (max-width: 900px) {
		.company-card {
			padding: 2rem 1.5rem;
			border-radius: var(--r-feature);
		}

		.company-card__wordmark {
			width: min(280px, 80%);
		}

		/* Mirror --pad-btn-lg mobile override (0.44rem 0.8rem) for split segments. */
		.company-card :global(.email-copy-btn) {
			padding: 0.44rem 0.4rem 0.44rem 0.8rem;
		}

		.company-card :global(.email-mailto-link) {
			padding: 0.44rem 0.8rem 0.44rem 0.4rem;
		}
	}
</style>
