---
import Section from '../Section.astro';
import { sideProjects } from '../../data/sideProjects';
---

{
	sideProjects.length > 0 && (
		<Section id="side-projects" title="Side Projects" compact>
			<div class="side-projects">
				{sideProjects.map((project) => (
					<div class="side-project-card">
						<h4>{project.name}</h4>
						<p class="side-project-tag">{project.tag}</p>
						<p>{project.description}</p>
					</div>
				))}
			</div>
		</Section>
	)
}

<style>
	.side-projects {
		max-width: 600px;
		width: 100%;
		text-align: center;
	}

	.side-project-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.5rem 1.75rem;
	}

	.side-project-card h4 {
		margin: 0 0 0.25rem;
		font-size: 1.1rem;
	}

	.side-project-tag {
		color: var(--accent);
		font-size: 0.85rem;
		margin: 0 0 0.75rem;
	}

	.side-project-card p:not(.side-project-tag) {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--fg);
		margin: 0;
	}
</style>
