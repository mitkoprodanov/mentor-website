---
/**
 * Contact closes the page as an ordinary full-height section in normal flow —
 * the "Contact" title above the Mentor Game Studio card — so it simply scrolls
 * up from the bottom as part of the main page, filling the viewport once
 * reached (which is what pushes the tail of Timeline/Projects up out of view).
 *
 * Scrolling into it also flips the sticky top bar into "contact mode" (see
 * contactMode.client.ts + ScrollyRegion.astro): each person card swaps its
 * Skills button for its LinkedIn link, so the two people read as contact cards
 * pinned above this section.
 */
import CompanyContactCard from './CompanyContactCard.astro';
---

<section id="contact" class="contact-zone">
	<h2 class="contact-title brand-heading">Contact</h2>
	<CompanyContactCard />
</section>

<style>
	.contact-zone {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2.5rem;
		padding: 4rem 1.5rem;
		/* Anchor-jump lands below the fixed navbar + sticky bar. */
		scroll-margin-top: 8rem;
	}

	.contact-title {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		text-align: center;
		color: var(--fg);
	}

	/* A gentle fade/rise as the section scrolls into view, keyed off contact
	   mode — enough to feel like it's floating up into place, without breaking
	   the sense that it's just the page's own last section. */
	.contact-title,
	.contact-zone :global(.company-card) {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	:global(body.contact-mode) .contact-title,
	:global(body.contact-mode) .contact-zone :global(.company-card) {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-title,
		.contact-zone :global(.company-card) {
			transition: opacity 0.3s ease;
			transform: none;
		}
	}
</style>
