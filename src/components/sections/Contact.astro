---
import Section from '../Section.astro';

const contacts = [
	{
		name: 'Mentor Game Studio',
		links: [
			{ label: 'mitko.prodanov@mentorgamestudio.com', href: 'mailto:mitko.prodanov@mentorgamestudio.com' },
			{ label: 'LinkedIn', href: 'https://www.linkedin.com/company/mentor-game-studio' },
		],
	},
	{
		name: 'Mitko Prodanov',
		links: [{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/mitko-prodanov-920b55b7/' }],
	},
	{
		name: 'Ádám Nemesházi',
		links: [{ label: 'LinkedIn', href: 'https://linkedin.com/in/adam-nemeshazi' }],
	},
];
---

<Section id="contact" title="Contact">
	<div class="contact-grid">
		{
			contacts.map((contact) => (
				<div class="contact-card">
					<h3>{contact.name}</h3>
					{contact.links.map((link) =>
						link.href.startsWith('mailto:') ? (
							<a href={link.href}>{link.label}</a>
						) : (
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.label}
							</a>
						),
					)}
				</div>
			))
		}
	</div>
</Section>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(200px, 1fr));
		gap: 1.5rem;
		max-width: 900px;
		width: 100%;
	}

	.contact-card {
		background: var(--bg-alt);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 1.75rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.contact-card h3 {
		margin: 0 0 0.25rem;
		font-size: 1.1rem;
	}

	.contact-card a {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.95rem;
		word-break: break-word;
	}

	.contact-card a:hover {
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
