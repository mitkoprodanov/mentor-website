---
/**
 * Contact closes the page as an ordinary full-height section in normal flow —
 * the "Contact" title above the Mentor Game Studio card — so it simply scrolls
 * up from the bottom as part of the main page, filling the viewport once
 * reached (which is what pushes the tail of Timeline/Projects up out of view).
 *
 * Scrolling into it also flips the sticky top bar into "contact mode" (see
 * contactMode.client.ts + ScrollyRegion.astro): each person card swaps its
 * Skills button for its LinkedIn link, so the two people read as contact cards
 * pinned above this section.
 */
import CompanyContactCard from './CompanyContactCard.astro';
---

<section id="contact" class="contact-zone">
	<h2 class="contact-title brand-heading"><span class="contact-title__text">Contact</span></h2>
	<CompanyContactCard />
</section>

<style>
	.contact-zone {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		/* Top-align so the section's own title lands at the same viewport y
		   as the Timeline's sticky pill (see Timeline.astro `.timeline-header
		   { top: 3.5rem }`). The scroll-snap in contactSnap.client.ts flushes
		   this section to viewport top, and `padding-top: 3.5rem` puts the
		   title exactly at the timeline pill's resting position — so snapping
		   between Timeline and Contact leaves the headline in place. */
		justify-content: flex-start;
		gap: 2.5rem;
		padding: 3.5rem 1.5rem 4rem;
		/* Anchor-jump matches the snap — section top flush with viewport top,
		   the padding-top above handling the offset to the title. */
		scroll-margin-top: 0;
	}

	/* Matched to Timeline's `.title-toggle` pill (see Timeline.astro) — same
	   opaque dark panel, warm hairline border, soft warm halo, and outer
	   double-line ring (see ::before below), so both section titles read as
	   the same kind of framed pill. Kept as a display-inline pill (via
	   `align-self: center`) so the title still centers in the flex column
	   layout of `.contact-zone` while wearing the frame. */
	.contact-title {
		position: relative;
		display: inline-flex;
		align-items: center;
		align-self: center;
		margin: 0;
		padding: 0.4em 1.6em;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		text-align: center;
		color: var(--fg);
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--mentor) 55%, var(--border));
		border-radius: 999px;
		box-shadow: 0 0 24px -4px color-mix(in srgb, var(--mentor) 30%, transparent);
		text-shadow: 0 0 12px color-mix(in srgb, var(--mentor) 18%, transparent);
		isolation: isolate;
	}

	/* Outer hairline ring — the same `.decor-frame`-style double-line
	   flourish riding just outside the Timeline pill. */
	.contact-title::before {
		content: '';
		position: absolute;
		inset: -6px -10px;
		border: 1px solid color-mix(in srgb, var(--mentor) 45%, transparent);
		border-radius: 999px;
		pointer-events: none;
	}

	/* Illuminated opening letter — kept identical to Timeline's
	   `.title-toggle__text::first-letter`. Applied on the inner span so
	   ::first-letter has a plain block-like text container to bind to (the
	   pill itself is inline-flex, which doesn't reliably support the pseudo). */
	.contact-title__text {
		display: inline-block;
		line-height: 1;
	}

	.contact-title__text::first-letter {
		font-size: 1.35em;
		line-height: 1;
	}

	/* No fade / rise on the Contact content — it's the page's own static ending,
	   revealed by scrolling into it (the directional snap in contactSnap.client.ts
	   locks the section to viewport top). */
</style>
