---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { LogoDef, LogoTransition } from '../../data/logos';
import LogoPlate from './LogoPlate.astro';

/** Intrinsic width/height of a PNG under /public (IHDR chunk), or undefined if unreadable. */
function pngRatio(src: string): number | undefined {
	try {
		const buf = readFileSync(join(process.cwd(), 'public', src));
		return buf.readUInt32BE(16) / buf.readUInt32BE(20);
	} catch {
		return undefined;
	}
}

/**
 * The single renderer for a registry logo (data/logos.ts), used everywhere a
 * logo is shown. The registry definition says what the artwork needs (backing
 * plate); the `variant` says where it is shown and so how it is sized:
 *   - 'header':  beside the year + company name block in a company box header
 *     (stretches to that block's height, never below logo.headerHeight);
 *   - 'preview': small badge beside a project name on the Timeline (fixed width);
 *   - 'detail':  beside the title in the project modal (fixed width).
 * Purely presentational and noninteractive. `data-partner-logo` carries the
 * canonical logo id (telemetry identity).
 */
interface Props {
	logo: LogoDef;
	variant: 'header' | 'preview' | 'detail';
	/** Background-to-logo transition band (see LogoPlate.astro). Default: DEFAULT_LOGO_TRANSITION. */
	transition?: LogoTransition;
}

const { logo, variant, transition } = Astro.props;

const size = {
	header: 'position: absolute; inset: 0; width: 100%; height: 100%;',
	preview: `width: ${logo.previewWidth ?? 80}px;`,
	detail: `width: ${logo.detailWidth ?? 130}px;`,
}[variant];
---

<LogoPlate
	treatment={transition}
	layer={logo.plate === 'light' ? '#f3eee4' : '#000'}
	stretch={variant === 'header'}
	style={variant === 'header' ? `min-height: ${logo.headerHeight ?? 26}px; aspect-ratio: ${pngRatio(logo.src) ?? 3};` : undefined}
>
	<span class:list={['logo', `logo--${variant}`, logo.plate && `logo--${logo.plate}`]}>
		<img src={logo.src} alt="" aria-hidden="true" data-partner-logo={logo.id} style={size} />
	</span>
</LogoPlate>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		overflow: hidden;
		line-height: 0;
		/* Radius left inside LogoPlate's transition band. */
		border-radius: var(--lp-inner-r, 0px);
	}

	.logo img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		object-fit: contain;
	}

	/* Header logos fill the LogoPlate frame, which stretches to the full height of the year + name block beside them. */
	/* The frame's aspect-ratio sets its width from the stretched height; the logo just fills inside the band, adding nothing to the header's own height. */
	.logo--header {
		position: absolute;
		inset: var(--lp-total);
	}

	.logo--header img {
		max-width: none;
		width: 100%;
		height: 100%;
	}

	/* Plate padding is a fixed band inside the stretched box (not extra size on top of it). */
	.logo--header.logo--light,
	.logo--header.logo--black {
		padding: 0;
	}

	.logo--header.logo--light img,
	.logo--header.logo--black img {
		inset: 3px 6px !important;
		width: calc(100% - 12px) !important;
		height: calc(100% - 6px) !important;
	}

	.logo--preview {
		opacity: 0.85;
	}

	.logo--detail {
		opacity: 0.9;
	}

	.logo--light {
		background: #f3eee4;
		padding: 4px 9px;
	}

	.logo--black {
		background: #000;
		padding: 3px 8px;
	}
</style>
