---
interface Props {
	label: string;
	/** Renders as a clickable filter button instead of a plain, non-interactive label. */
	linked?: boolean;
	/** The WorkTag id — read by tagFilter.client.ts. Required when `linked` is true. */
	tagId?: string;
}

const { label, linked = false, tagId } = Astro.props;
---

{
	linked ? (
		<button type="button" class="tag tag--linked btn-sheen" data-tag-id={tagId} aria-pressed="false">
			{label}
		</button>
	) : (
		<span class="tag">{label}</span>
	)
}

<style>
	.tag {
		font-size: var(--text-sm);
		padding: var(--pad-tag);
		border-radius: var(--r-full);
		background: var(--accent-soft);
		color: var(--accent-3);
		border: 1px solid rgba(255, 122, 0, 0.3);
		/* Long labels (e.g. award names) wrap onto multiple lines inside the
		   pill instead of forcing it wider than its container — max-width
		   keeps the pill itself from ever exceeding the row it sits in. */
		max-width: 100%;
		white-space: normal;
		overflow-wrap: break-word;
	}

	button.tag {
		font-family: inherit;
		cursor: pointer;
		/* Warm-gold drifting glint marks the pill as a live click target;
		   staggered below so neighbouring tags never flash together. */
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.16;
		text-decoration: underline dotted rgba(255, 209, 102, 0.5);
		text-underline-offset: 3px;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	button.tag:hover {
		background: var(--accent-3);
		color: var(--bg);
		border-color: var(--accent-3);
		transform: translateY(-1px);
		/* Brighter, glowing silhouette on hover. */
		box-shadow:
			0 0 18px 2px rgba(255, 209, 102, 0.5),
			0 0 0 1px rgba(255, 209, 102, 0.6);
	}

	button.tag:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	button.tag[aria-pressed='true'] {
		background: var(--accent-3);
		color: var(--bg);
		border-color: var(--accent-3);
		text-decoration: none;
		transform: scale(1.05);
		box-shadow:
			0 0 20px 3px rgba(255, 209, 102, 0.6),
			0 0 0 1px rgba(255, 209, 102, 0.7);
	}

	:global(body.filter-active) button.tag:not([aria-pressed='true']) {
		opacity: 0.45;
	}

	button.tag--linked:nth-of-type(3n + 2) {
		--sheen-delay: -3s;
	}

	button.tag--linked:nth-of-type(3n + 3) {
		--sheen-delay: -6s;
	}
</style>
