---
/**
 * The Vision — one sentence of value-prop copy whose phrases are clickable
 * "thought parts". Hovering (or tapping) a part reveals the fuller detail
 * for that phrase in a side/below panel.
 *
 * Reusable in place of the previous ThoughtCloud: About.astro renders it as
 * the hero pitch below the logo (`variant="hero"`, side panels flanking on
 * wide screens), and a Timeline project can embed it inside its preview
 * (`variant="preview"`, always-below layout — see ProjectRow.astro).
 *
 * Copy lives in data/thoughts.ts. Interactivity comes from vision.client.ts,
 * which scopes its listeners per `.vision` root so multiple instances on one
 * page each work independently. Detail element ids are scoped with `scopeId`
 * to keep multiple instances from colliding on the same DOM id.
 */
import { thoughts } from '../../data/thoughts';

interface Props {
	/** `hero` — the big landing pitch with side panels flanking the sentence on
	 *  wide screens. `preview` — the compact inline version for a project card:
	 *  no flanking panels, the detail always drops below the sentence. */
	variant?: 'hero' | 'preview';
	/** Prefix used for detail element ids so multiple Vision instances on one
	 *  page don't collide (e.g. `hero` → `hero-detail-in-sync`). */
	scopeId?: string;
}

const { variant = 'hero', scopeId = 'vision' } = Astro.props;

const byId = Object.fromEntries(thoughts.map((t) => [t.id, t]));

// Label shown in the detail card title — matches the sentence phrasing, not thoughts.ts titles.
const labelFor: Record<string, string> = {
	'in-sync':            'battle-tested duo',
	'shipped-experiences': 'proven experience',
	'easy-integration':   'easy integration',
	'true-ownership':     'true ownership',
	'complete-development': 'complete development',
	'built-to-scale':     'ready to scale',
};

// Sentence segments: plain strings, { br } for line breaks, or clickable parts
// tagged with the id of their thought and which side their detail panel appears on.
type Seg = string | { br: true } | { id: string; text: string; side: 'left' | 'right' };

const sentence: Seg[] = [
	'A ',
	{ id: 'in-sync',            text: 'battle-tested duo',    side: 'left'  },
	' with ',
	{ id: 'shipped-experiences', text: 'proven experience',   side: 'right' },
	' to build on,',
	{ br: true },
	'we offer ',
	{ id: 'easy-integration',   text: 'easy integration',     side: 'left'  },
	' while taking ',
	{ id: 'true-ownership',     text: 'true ownership',       side: 'right' },
	' of our work seriously',
	{ br: true },
	'— bringing together ',
	{ id: 'complete-development', text: 'complete development', side: 'left' },
	" that's ",
	{ id: 'built-to-scale',     text: 'ready to scale',       side: 'right' },
	'.',
];

const leftIds  = ['in-sync', 'easy-integration', 'complete-development'];
const rightIds = ['shipped-experiences', 'true-ownership', 'built-to-scale'];

const detailId = (id: string) => `${scopeId}-detail-${id}`;
---

<div class:list={['vision', 'thought-sentence', `vision--${variant}`]}>
	{/* Left detail panel — shown to the left of the sentence on wide screens (hero variant). */}
	<div class="sentence-detail detail-left" aria-live="polite">
		{
			leftIds.map((id) => (
				<div class="detail" id={detailId(id)} data-detail hidden>
					<span class="detail-title">{labelFor[id]}</span>
					<span class="detail-text">{byId[id].description}</span>
				</div>
			))
		}
	</div>

	<p class="sentence">
		{
			sentence.map((seg) =>
				typeof seg === 'string' ? (
					seg
				) : 'br' in seg ? (
					<br />
				) : (
					<button
						class="part btn-sheen"
						type="button"
						data-thought-part
						data-side={seg.side}
						aria-expanded="false"
						aria-controls={detailId(seg.id)}
					>
						{seg.text}
					</button>
				),
			)
		}
	</p>

	{/* Right detail panel — shown to the right of the sentence on wide screens (hero variant). */}
	<div class="sentence-detail detail-right" aria-live="polite">
		{
			rightIds.map((id) => (
				<div class="detail" id={detailId(id)} data-detail hidden>
					<span class="detail-title">{labelFor[id]}</span>
					<span class="detail-text">{byId[id].description}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.vision {
		position: relative;
		max-width: 44rem;
		margin: 1.6rem auto 0;
	}

	.vision--hero {
		animation: sentence-in 550ms cubic-bezier(0.22, 1, 0.36, 1) 1250ms both;
	}

	@keyframes sentence-in {
		from { opacity: 0; transform: translateY(9px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.vision--hero {
			animation: none;
		}
	}

	/* ── Sentence ──────────────────────────────────────────────────────────── */

	.sentence {
		margin: 0;
		font-size: clamp(0.95rem, 0.82rem + 0.55vw, 1.05rem);
		line-height: 1.9;
		color: var(--fg-muted);
		font-variant-caps: small-caps;
		letter-spacing: var(--letter-open);
		text-align: center;
	}

	.vision--preview .sentence {
		font-size: 0.9rem;
		line-height: 1.7;
	}

	/* Stagger the drifting sheen so the six thought parts never glint in unison. */
	.part:nth-of-type(2) { --sheen-delay: -1.5s; }
	.part:nth-of-type(3) { --sheen-delay: -3s; }
	.part:nth-of-type(4) { --sheen-delay: -4.5s; }
	.part:nth-of-type(5) { --sheen-delay: -6s; }
	.part:nth-of-type(6) { --sheen-delay: -7.5s; }

	/* ── Part (hoverable phrase) ───────────────────────────────────────────── */

	.part {
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.18;
		color: var(--fg);
		background: radial-gradient(
			ellipse 74% 155% at 50% 50%,
			color-mix(in srgb, var(--accent) 15%, rgba(255, 255, 255, 0.08)) 0%,
			color-mix(in srgb, var(--accent) 6%, rgba(255, 255, 255, 0.02)) 48%,
			transparent 80%
		);
		text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 16%, transparent);
		border: 0;
		border-radius: 6px;
		padding: 0.04rem 0.36rem 0.08rem;
		vertical-align: baseline;
		position: relative;
		/* Sit above the enclosing project row's transparent click-overlay
		   (see ProjectRow.astro's `.row-open`) so the thought part stays
		   independently clickable when Vision is embedded in a preview. */
		z-index: 2;
		transition:
			background 0.22s ease,
			text-shadow 0.22s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.part:hover {
			background: radial-gradient(
				ellipse 80% 160% at 50% 50%,
				color-mix(in srgb, var(--accent) 26%, rgba(255, 255, 255, 0.14)) 0%,
				color-mix(in srgb, var(--accent) 9%, rgba(255, 255, 255, 0.03)) 48%,
				transparent 82%
			);
			text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 30%, transparent);
		}
	}

	.part:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.3);
		outline-offset: 2px;
	}

	.part.is-active {
		background: radial-gradient(
			ellipse 80% 160% at 50% 50%,
			color-mix(in srgb, var(--accent) 26%, rgba(255, 255, 255, 0.14)) 0%,
			color-mix(in srgb, var(--accent) 9%, rgba(255, 255, 255, 0.03)) 48%,
			transparent 82%
		);
		text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 30%, transparent);
	}

	/* ── Side detail panels ────────────────────────────────────────────────── */

	.sentence-detail {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 15.5rem;
		text-align: left;
		z-index: 10;
	}

	.detail-left  { right: calc(100% + 1.5rem); }
	.detail-right { left:  calc(100% + 1.5rem); }

	.detail {
		background: rgba(12, 15, 20, 0.82);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 0.8rem 1rem;
		box-shadow:
			0 16px 34px -14px rgba(0, 0, 0, 0.75),
			0 4px 12px -6px rgba(0, 0, 0, 0.4);
		animation: detail-in 0.26s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.detail[hidden] {
		display: none;
	}

	.detail-title {
		display: block;
		font-size: 0.97rem;
		font-weight: 600;
		font-variant-caps: small-caps;
		letter-spacing: var(--letter-open);
		color: var(--fg);
		margin-bottom: 0.3rem;
	}

	.detail-text {
		display: block;
		font-size: 0.88rem;
		font-variant-caps: small-caps;
		letter-spacing: var(--letter-open);
		line-height: 1.6;
		color: var(--fg-muted);
	}

	@keyframes detail-in {
		from { opacity: 0; transform: translateY(-5px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	@media (prefers-reduced-motion: reduce) {
		.detail {
			animation: none;
		}
	}

	/* ── Preview variant — flank the detail to the left/right of the sentence,
	   the same as the hero/About layout, only sized narrower and pulled in
	   tighter so both panels stay inside the project-row box. On narrower
	   screens (where the box no longer has the side room) it drops below the
	   sentence instead — see the responsive block. ── */
	.vision--preview .sentence-detail {
		width: 12.5rem;
		/* The detail is taller than this compact sentence, and the experience
		   cards sit right beneath it — so instead of centring on the sentence
		   (which would dip over the cards' top corners), anchor the panel's
		   bottom to the sentence's bottom and let it grow UP into the empty
		   gutter beside the centred title, clear of the cards below. */
		top: auto;
		bottom: 0;
		transform: none;
	}

	.vision--preview .detail-left  { right: calc(100% + 1rem); }
	.vision--preview .detail-right { left:  calc(100% + 1rem); }

	/* ── Responsive fallback — once there's no longer side room, the detail
	   drops below the sentence. The preview goes fully in-flow (static) so it
	   pushes the experience cards beneath it down rather than floating over
	   them; the hero has nothing below it, so it can stay absolute. ────────── */

	@media (max-width: 1250px) {
		.vision--hero .sentence-detail {
			top: calc(100% + 1rem);
			left: 50%;
			right: auto;
			transform: translateX(-50%);
			width: min(30rem, 90vw);
		}

		.vision--preview .sentence-detail,
		.vision--preview .detail {
			text-align: center;
		}

		.vision--preview .sentence-detail {
			position: static;
			transform: none;
			width: 100%;
			margin-top: 0.75rem;
		}
	}

	@media (max-width: 900px) {
		.vision--hero {
			margin-top: 1.25rem;
		}

		.vision--hero .sentence-detail {
			position: static;
			transform: none;
			width: 100%;
			margin-top: 0.9rem;
		}
	}
</style>
