---
import { getEntry, render } from 'astro:content';
import { getPerson } from '../../data/people';
import { getTag, sortTagIdsByIndex } from '../../data/tags';
import { getCatalogProjectsInOrder, type CatalogProject } from '../../data/projectCatalog';
import ProjectDetail from './ProjectDetail.astro';

/**
 * The skill-tag filter's detailed results view — the panel shown (lifted into a
 * modal over the dimmed backdrop, see ScrollyRegion.astro) whenever a skill tag
 * is active. Deliberately unlike the timeline: no companies, tracks, or
 * apart/together relations — one flat stack of matching Projects, ordered by
 * each project's own `order` sort key (see data/timeline.ts and
 * data/projectCatalog.ts), so shared and solo projects intermingle in the
 * same linear read instead of clustering by who worked on them.
 *
 * A card's visual side (centered / translated left / translated right) still
 * comes from who worked on it — that's a per-card style, not an ordering — so
 * a shared project sits centered while solo projects lean into their own
 * gutter, but the stack itself follows the flat order.
 *
 * Every project renders its full detail (the same head/prose/gallery its modal
 * shows). Which cards and which individual media items stay visible under the
 * active tag is decided at runtime by scripts/tagFilter.client.ts, keyed off
 * `data-project-tags` here (union of a project's experience + media tags) and
 * the `data-media-tags` on each gallery figure (see ProjectDetail.astro).
 */

interface LoadedProject {
	project: CatalogProject;
	cards: { personName: string; personId: string; Content: Awaited<ReturnType<typeof render>>['Content'] }[];
	peopleLabel: string;
	tagLabels: string[];
}

async function loadProject(project: CatalogProject): Promise<LoadedProject> {
	const cards = await Promise.all(
		project.experiences.map(async (ref) => {
			const entry = await getEntry('experiences', ref.slug);
			if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
			const { Content } = await render(entry);
			const person = getPerson(ref.person);
			return { personName: person.name, personId: person.id, Content };
		}),
	);
	return {
		project,
		cards,
		peopleLabel: cards.map((c) => c.personName).join(' & '),
		// Ordered by each tag's canonical index in data/tags.ts, so the pill row
		// reads the same order everywhere a project's tags surface.
		tagLabels: sortTagIdsByIndex(project.experienceTagIds).map((id) => getTag(id).label),
	};
}

// One flat stack — every matching project in its own `order` position (see
// data/projectCatalog.ts). A card's `side` is still carried per-project so it
// picks up the right visual treatment (a shared card stays centered, a solo
// card translates toward its person's side and tints in their color — same
// visual language as the media items inside a Project detail), but the stack
// order itself no longer clusters by side.
const loaded = await Promise.all(getCatalogProjectsInOrder().map(loadProject));
type ResultCard = { lp: LoadedProject; side: 'both' | 'left' | 'right' };
const stack: ResultCard[] = loaded.map((lp) => ({ lp, side: lp.project.side }));
---

<div id="filter-results" class="filter-results" aria-hidden="true">
	<div class="filter-chip" id="timeline-filter-chip" hidden>
		<span class="filter-chip-label">Filtered by: <strong id="timeline-filter-chip-skill"></strong></span>
		<button type="button" class="filter-chip-clear" id="timeline-filter-chip-clear" aria-label="Clear filter">✕</button>
	</div>

	<p class="fr-empty" data-fr-empty hidden>No projects match this skill yet.</p>

	<div class="fr-stack">
		{
			stack.map(({ lp, side }) => {
				// Single-person cards translate toward their person's side and pick
				// up their accent color; shared cards stay centered on the neutral
				// warm accent. Same visual language as .shot--person in ProjectDetail.
				const personId = side === 'both' ? null : lp.cards[0]?.personId;
				return (
					<article
						class:list={['fr-card', `fr-card--${side}`, side !== 'both' && 'fr-card--person']}
						data-fr-card
						data-fr-side={side}
						data-project-tags={lp.project.allTagIds.join(' ')}
						style={personId ? `--person-color: var(--${personId}-color)` : undefined}
					>
						<ProjectDetail
							title={lp.project.title}
							subtitle={lp.project.info}
							dateRange={lp.project.dateRange}
							people={lp.cards.length > 1 ? lp.peopleLabel : undefined}
							media={lp.project.media}
							as="h4"
						>
							{lp.cards.map((c) => (
								<div class="modal-exp" data-person={c.personId} style={`--person-color: var(--${c.personId}-color)`}>
									<p class="modal-exp__person">{c.personName}</p>
									<c.Content />
								</div>
							))}
						</ProjectDetail>
					</article>
				);
			})
		}
	</div>
</div>

<style>
	/* Hidden until a filter turns on; ScrollyRegion lifts the whole timeline-area
	   into a modal and swaps the real timeline out for this panel (see the
	   body.filter-active rules there). */
	.filter-results {
		display: none;
		width: 100%;
		max-width: 1200px;
	}

	:global(body.filter-active) .filter-results {
		display: block;
	}

	/* One flat vertical stack — same visual language as the media items
	   inside a Project detail: shared cards stay centered, solo cards
	   translate toward their person's side into the surrounding gutter
	   (see .fr-card--person-* below). Every card keeps the same width;
	   the container's padding-inline is what bears the translation. */
	.fr-stack {
		--stack-gutter: 44px;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding-inline: var(--stack-gutter);
	}

	/* Same direction toggle as the timeline: when the site is in "latest
	   first" mode (see Timeline.astro's direction button, which mirrors its
	   state onto <html data-reversed>), flip the filter stack too so the
	   two views read in the same order. Server-side we always render
	   ascending by the `order` key; the visual reversal is purely CSS. */
	:global(html[data-reversed='true']) .fr-stack {
		flex-direction: column-reverse;
	}

	/* A detailed project card — the same warm-accent boxed language as the
	   timeline's project rows, carrying the project's full detail inside. A
	   both-worked card keeps its own top accent edge in the shared accent; a
	   solo card is tinted with its person's colour. */
	.fr-card {
		border: 1px solid color-mix(in oklab, var(--accent) 32%, var(--border));
		border-top: 3px solid color-mix(in oklab, var(--person-color, var(--accent-3)) 70%, var(--border));
		border-radius: 16px;
		background: color-mix(in oklab, var(--accent) 6%, var(--bg));
		padding: 1.5rem;
	}

	.fr-card--both {
		--person-color: var(--accent-3);
	}

	/* Solo cards keep the same width as shared cards; they just translate
	   exactly one stack-gutter into the surrounding gutter, mirroring
	   .shot--person-* in ProjectDetail.astro. Plus a person-color rule on
	   their own edge so the attribution reads at a glance. */
	.fr-card--left {
		transform: translateX(calc(-1 * var(--stack-gutter)));
		border-left: 3px solid var(--person-color, var(--accent));
	}

	.fr-card--right {
		transform: translateX(var(--stack-gutter));
		border-right: 3px solid var(--person-color, var(--accent));
	}

	/* One person's experience prose inside a card — same lightweight treatment
	   as the modal's slotted experiences (a person-tinted left rule). */
	/* Person-color rule sits on the person's own side — see the matching
	   block in components/timeline/ProjectRow.astro. */
	.modal-exp {
		padding-left: 0.85rem;
		border-left: 2px solid var(--person-color, var(--accent));
	}

	.modal-exp[data-person='adam'] {
		padding-left: 0;
		padding-right: 0.85rem;
		border-left: none;
		border-right: 2px solid var(--person-color, var(--accent));
		text-align: right;
	}

	.modal-exp + .modal-exp {
		margin-top: 1.1rem;
	}

	.modal-exp__person {
		margin: 0 0 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--person-color, var(--accent));
	}

	/* A gallery whose every media item was filtered out leaves nothing to show —
	   the runtime marks it so its empty "Showcase gallery" frame doesn't linger
	   (see tagFilter.client.ts). */
	.filter-results :global(.project-modal__gallery[data-gallery].fr-gallery-empty) {
		display: none;
	}

	.filter-results :global(.shot.fr-hidden) {
		display: none;
	}

	.fr-card[hidden] {
		display: none;
	}

	.fr-empty {
		text-align: center;
		color: var(--fg-muted);
		font-size: 0.95rem;
		padding: 2rem 0;
	}

	/* The active-filter chip, pinned to the top of the lifted modal panel. */
	.filter-chip {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: max-content;
		margin: 0 auto 1.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border-radius: 999px;
		background: var(--bg-alt);
		border: 1px solid var(--accent-3);
		box-shadow: 0 0 16px 2px var(--accent-soft);
		font-size: 0.85rem;
	}

	.filter-chip[hidden] {
		display: none;
	}

	.filter-chip-label strong {
		color: var(--accent-3);
	}

	.filter-chip-clear {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: none;
		background: var(--accent-soft);
		color: var(--fg);
		cursor: pointer;
		font-size: 0.75rem;
		line-height: 1;
	}

	.filter-chip-clear:hover {
		background: var(--accent-3);
		color: var(--bg);
	}

	@media (max-width: 900px) {
		/* No horizontal offset on a phone — the viewport is too narrow for a
		   sideways shift to still read as an offset rather than a truncation. */
		.fr-stack {
			padding-inline: 0;
		}

		.fr-card--left,
		.fr-card--right {
			transform: none;
		}

		.fr-card {
			padding: 1.25rem;
		}
	}
</style>
