---
import { getEntry, render } from 'astro:content';
import { getPerson } from '../../data/people';
import { getTag } from '../../data/tags';
import { getCatalogGroups, COLUMN_PERSON, type CatalogProject } from '../../data/projectCatalog';
import ProjectDetail from './ProjectDetail.astro';

/**
 * The skill-tag filter's detailed results view — the panel shown (lifted into a
 * modal over the dimmed backdrop, see ScrollyRegion.astro) whenever a skill tag
 * is active. Deliberately unlike the timeline: no companies, tracks, or
 * apart/together relations — just the matching Projects, grouped only by who
 * worked on them.
 *
 *   - "Worked on together" projects first, full-width, oldest first.
 *   - then the solo projects side by side: Mitko's on the left, Ádám's on the
 *     right, each oldest first.
 *
 * Every project renders its full detail (the same head/prose/gallery its modal
 * shows). Which cards and which individual media items stay visible under the
 * active tag is decided at runtime by scripts/tagFilter.client.ts, keyed off
 * `data-project-tags` here (union of a project's experience + media tags) and
 * the `data-media-tags` on each gallery figure (see ProjectDetail.astro).
 */

interface LoadedProject {
	project: CatalogProject;
	cards: { personName: string; personId: string; Content: Awaited<ReturnType<typeof render>>['Content'] }[];
	peopleLabel: string;
	tagLabels: string[];
}

async function loadProject(project: CatalogProject): Promise<LoadedProject> {
	const cards = await Promise.all(
		project.experiences.map(async (ref) => {
			const entry = await getEntry('experiences', ref.slug);
			if (!entry) throw new Error(`Missing experience entry: ${ref.slug}`);
			const { Content } = await render(entry);
			const person = getPerson(ref.person);
			return { personName: person.name, personId: person.id, Content };
		}),
	);
	return {
		project,
		cards,
		peopleLabel: cards.map((c) => c.personName).join(' & '),
		tagLabels: project.experienceTagIds.map((id) => getTag(id).label),
	};
}

const groups = getCatalogGroups();
const [both, left, right] = await Promise.all([
	Promise.all(groups.both.map(loadProject)),
	Promise.all(groups.left.map(loadProject)),
	Promise.all(groups.right.map(loadProject)),
]);

const columns = [
	{ side: 'left' as const, person: getPerson(COLUMN_PERSON.left), projects: left },
	{ side: 'right' as const, person: getPerson(COLUMN_PERSON.right), projects: right },
];
---

<div id="filter-results" class="filter-results" aria-hidden="true">
	<div class="filter-chip" id="timeline-filter-chip" hidden>
		<span class="filter-chip-label">Filtered by: <strong id="timeline-filter-chip-skill"></strong></span>
		<button type="button" class="filter-chip-clear" id="timeline-filter-chip-clear" aria-label="Clear filter">✕</button>
	</div>

	<p class="fr-empty" data-fr-empty hidden>No projects match this skill yet.</p>

	<section class="fr-group fr-group--both" data-fr-group="both" hidden={both.length === 0}>
		<h3 class="fr-group-title">Worked on together</h3>
		<div class="fr-stack">
			{
				both.map((lp) => (
					<article class="fr-card fr-card--both" data-fr-card data-project-tags={lp.project.allTagIds.join(' ')}>
						<ProjectDetail
							title={lp.project.title}
							subtitle={lp.project.info}
							dateRange={lp.project.dateRange}
							people={lp.peopleLabel}
							tags={lp.tagLabels}
							media={lp.project.media}
							as="h4"
						>
							{lp.cards.map((c) => (
								<div class="modal-exp" style={`--person-color: var(--${c.personId}-color)`}>
									<p class="modal-exp__person">{c.personName}</p>
									<c.Content />
								</div>
							))}
						</ProjectDetail>
					</article>
				))
			}
		</div>
	</section>

	<section class="fr-solo" data-fr-solo hidden={left.length === 0 && right.length === 0}>
		{
			columns.map((col) => (
				<div class={`fr-col fr-col--${col.side}`} data-fr-col={col.side} style={`--person-color: var(--${col.person.id}-color)`} hidden={col.projects.length === 0}>
					<h3 class="fr-group-title fr-group-title--person">{col.person.name}</h3>
					<div class="fr-stack">
						{col.projects.map((lp) => (
							<article class="fr-card" data-fr-card data-project-tags={lp.project.allTagIds.join(' ')}>
								<ProjectDetail
									title={lp.project.title}
									subtitle={lp.project.info}
									dateRange={lp.project.dateRange}
									people={lp.peopleLabel}
									tags={lp.tagLabels}
									media={lp.project.media}
									as="h4"
								>
									{lp.cards.map((c) => (
										<div class="modal-exp" style={`--person-color: var(--${c.personId}-color)`}>
											<p class="modal-exp__person">{c.personName}</p>
											<c.Content />
										</div>
									))}
								</ProjectDetail>
							</article>
						))}
					</div>
				</div>
			))
		}
	</section>
</div>

<style>
	/* Hidden until a filter turns on; ScrollyRegion lifts the whole timeline-area
	   into a modal and swaps the real timeline out for this panel (see the
	   body.filter-active rules there). */
	.filter-results {
		display: none;
		width: 100%;
		max-width: 1200px;
	}

	:global(body.filter-active) .filter-results {
		display: block;
	}

	.fr-group + .fr-solo {
		margin-top: 2rem;
	}

	.fr-group-title {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--fg-muted);
		margin: 0 0 1rem;
	}

	.fr-group-title--person {
		color: var(--person-color, var(--accent-3));
	}

	.fr-stack {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	/* The remaining solo projects, the two people side by side — Mitko's column
	   on the left, Ádám's on the right, mirroring the timeline's own sides. */
	.fr-solo {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		align-items: start;
	}

	/* Each column is pinned to its own half — Mitko left, Ádám right — so a solo
	   project sits only in its person's half with the other half empty, even when
	   the opposite column has no matches at all (rather than sliding over to fill
	   the row). Mirrors the timeline's own left/right sides. */
	.fr-col--left {
		grid-column: 1;
	}

	.fr-col--right {
		grid-column: 2;
	}

	.fr-col[hidden] {
		display: none;
	}

	/* A detailed project card — the same warm-accent boxed language as the
	   timeline's project rows, carrying the project's full detail inside. A
	   both-worked card keeps its own top accent edge in the shared accent; a
	   solo card is tinted with its person's colour. */
	.fr-card {
		border: 1px solid color-mix(in oklab, var(--accent) 32%, var(--border));
		border-top: 3px solid color-mix(in oklab, var(--person-color, var(--accent-3)) 70%, var(--border));
		border-radius: 16px;
		background: color-mix(in oklab, var(--accent) 6%, var(--bg));
		padding: 1.5rem;
	}

	.fr-card--both {
		--person-color: var(--accent-3);
	}

	/* One person's experience prose inside a card — same lightweight treatment
	   as the modal's slotted experiences (a person-tinted left rule). */
	.modal-exp {
		padding-left: 0.85rem;
		border-left: 2px solid var(--person-color, var(--accent));
	}

	.modal-exp + .modal-exp {
		margin-top: 1.1rem;
	}

	.modal-exp__person {
		margin: 0 0 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--person-color, var(--accent));
	}

	/* A gallery whose every media item was filtered out leaves nothing to show —
	   the runtime marks it so its empty "Showcase gallery" frame doesn't linger
	   (see tagFilter.client.ts). */
	.filter-results :global(.project-modal__gallery[data-gallery].fr-gallery-empty) {
		display: none;
	}

	.filter-results :global(.shot.fr-hidden) {
		display: none;
	}

	.fr-card[hidden] {
		display: none;
	}

	.fr-empty {
		text-align: center;
		color: var(--fg-muted);
		font-size: 0.95rem;
		padding: 2rem 0;
	}

	/* The active-filter chip, pinned to the top of the lifted modal panel. */
	.filter-chip {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: max-content;
		margin: 0 auto 1.5rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border-radius: 999px;
		background: var(--bg-alt);
		border: 1px solid var(--accent-3);
		box-shadow: 0 0 16px 2px var(--accent-soft);
		font-size: 0.85rem;
	}

	.filter-chip[hidden] {
		display: none;
	}

	.filter-chip-label strong {
		color: var(--accent-3);
	}

	.filter-chip-clear {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: none;
		background: var(--accent-soft);
		color: var(--fg);
		cursor: pointer;
		font-size: 0.75rem;
		line-height: 1;
	}

	.filter-chip-clear:hover {
		background: var(--accent-3);
		color: var(--bg);
	}

	@media (max-width: 900px) {
		/* No side-by-side columns on a phone — the two solo columns stack, each
		   still headed by its person so the split stays legible. The single track
		   also means the desktop column-pinning must be released, or a pinned
		   `grid-column: 2` would spawn a phantom second column. */
		.fr-solo {
			grid-template-columns: 1fr;
		}

		.fr-col--left,
		.fr-col--right {
			grid-column: auto;
		}

		.fr-card {
			padding: 1.25rem;
		}
	}
</style>
