---
import type { ProjectMedia } from '../../data/projects';

/**
 * The inner detail of a Project — head, meta, tag pills, a body slot, and the
 * showcase gallery. Rendered in two places:
 *   - inside a <dialog> by ProjectModal.astro (the click-to-open detail on the
 *     timeline), and
 *   - inline by FilterResults.astro (the skill-tag filter's detailed results).
 *
 * Each gallery figure carries `data-media-tags` (its media item's `tagIds`) so
 * the filter can show only the media matching the active tag; that attribute is
 * inert inside the always-fully-shown modal.
 */
interface Props {
	title: string;
	/** Strap-line under the title (a project's `detail`/`info`). */
	subtitle?: string;
	/** Year or year range the work spans, e.g. "2026" or "2024 – Present". */
	dateRange?: string;
	/** Who worked on it, e.g. "Mitko & Ádám". */
	people?: string;
	/** Tag labels rendered as pills. */
	tags?: string[];
	media?: ProjectMedia[];
	url?: string;
	urlLabel?: string;
	titleId?: string;
	/** Heading level for the title — h3 in a modal, h4 when nested in the results view. */
	as?: 'h3' | 'h4';
}

const { title, subtitle, dateRange, people, tags = [], media = [], url, urlLabel, titleId, as = 'h3' } = Astro.props;
const Title = as;

/** Compact, human-friendly label for a project's external link — the host
 *  (with a leading `www.` stripped) plus the *tail* of the path (its last
 *  non-empty segment), e.g. "ubisoft.com/might-and-magic-heroes-vi",
 *  "facebook.com/PrimalAround", "supernova.fandom.com/Supernova". Falls
 *  back to just the host when the URL has no path — e.g.
 *  "mandragoragame.com" — so the label always names both where the link
 *  goes and what it points at. Falls back to the raw URL if the string
 *  won't parse at all. */
function defaultUrlLabel(href: string): string {
	try {
		const u = new URL(href);
		const host = u.host.replace(/^www\./, '');
		const tail = u.pathname.replace(/\/+$/, '').split('/').filter(Boolean).pop();
		return tail ? `${host}/${tail}` : host;
	} catch {
		return href;
	}
}
const resolvedUrlLabel = urlLabel ?? (url ? defaultUrlLabel(url) : undefined);

/**
 * Facebook embed URL — the video plugin's iframe form, so no Facebook SDK or
 * script is needed on the page. `href` is the public page URL of a Facebook
 * video (facebook.com/watch/?v=…) or reel (facebook.com/reel/…) — the plugin
 * handles both. The 640×360 base is a 16:9 landscape box; the iframe is then
 * CSS-transform-scaled to exactly fill its container width (see .shot-video +
 * the scaler in projectModal.client.ts), so it fills the card horizontally
 * with no letterboxing at any width.
 */
const VIDEO_BASE_W = 640;
const VIDEO_BASE_H = 360;
function facebookVideoEmbed(pageUrl: string): string {
	const params = new URLSearchParams({ href: pageUrl, show_text: 'false', width: String(VIDEO_BASE_W), height: String(VIDEO_BASE_H) });
	return `https://www.facebook.com/plugins/video.php?${params.toString()}`;
}

/** Both Facebook kinds render identically (same plugin) — only the badge differs. */
const isFacebookEmbed = (kind: string) => kind === 'facebook-reel' || kind === 'facebook-video';

/**
 * LinkedIn post embed URL. Accepts a full post URL
 * ('https://www.linkedin.com/feed/update/urn:li:activity:…'), a bare activity
 * URN ('urn:li:activity:…'), or just the numeric activity id — all resolve to
 * LinkedIn's public /embed/feed/update/urn:li:activity:<id> iframe endpoint.
 */
function linkedInEmbed(src: string): string {
	let id = src.trim();
	const urnMatch = id.match(/urn:li:(?:activity|share|ugcPost):(\d+)/);
	if (urnMatch) id = urnMatch[1];
	else if (/^\d+$/.test(id)) {
		/* already a bare id */
	} else {
		try {
			const u = new URL(id);
			const m = u.pathname.match(/urn:li:(?:activity|share|ugcPost):(\d+)/);
			if (m) id = m[1];
		} catch {
			/* leave as-is; the iframe will show LinkedIn's own error */
		}
	}
	return `https://www.linkedin.com/embed/feed/update/urn:li:activity:${id}`;
}

/** Pull the 11-char video id out of any YouTube URL form (or pass through a bare id). */
function youtubeId(src: string): string {
	try {
		const u = new URL(src);
		const host = u.hostname.replace(/^www\./, '');
		if (host === 'youtu.be') return u.pathname.slice(1);
		if (host.endsWith('youtube.com') || host.endsWith('youtube-nocookie.com')) {
			if (u.pathname === '/watch') return u.searchParams.get('v') ?? src;
			const m = u.pathname.match(/^\/(?:embed|shorts)\/([^/?]+)/);
			if (m) return m[1];
		}
	} catch {
		/* not a URL — assume it's already an id */
	}
	return src;
}

function mediaTags(m: ProjectMedia): string {
	return (m.tagIds ?? []).join(' ');
}

/** Extra classes/attributes that visually attribute a media item to a single
 *  person — a person-color accent + a slight offset toward their side.
 *  Undefined `person` = shared, everything stays center-full-width. */
function personSide(m: ProjectMedia): 'left' | 'right' | null {
	if (!m.person) return null;
	// Mitko sits in the left column, Ádám in the right — see data/people.ts.
	return m.person === 'mitko' ? 'left' : 'right';
}

function shotClasses(m: ProjectMedia, extra?: string): string {
	const parts = ['shot'];
	if (extra) parts.push(extra);
	const side = personSide(m);
	if (side) parts.push(`shot--person`, `shot--person-${side}`);
	return parts.join(' ');
}

function personStyle(m: ProjectMedia): string | undefined {
	if (!m.person) return undefined;
	return `--person-color: var(--${m.person}-color);`;
}

---

<header class:list={['project-modal__head', { 'project-modal__head--shared': Boolean(people) }]}>
	<Title id={titleId} class="project-modal__title">{title}</Title>
	{subtitle && <p class="project-modal__detail">{subtitle}</p>}
</header>

{
	url && (
		<div class="project-modal__link">
			<a class="project-link-chip btn-sheen" href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${resolvedUrlLabel} in a new tab`}>
				<span class="project-link-chip__label">{resolvedUrlLabel}</span>
				<span class="project-link-chip__icon" aria-hidden="true">↗</span>
			</a>
		</div>
	)
}

{
	tags.length > 0 && (
		<ul class="project-modal__tags">
			{tags.map((label: string) => (
				<li class="tag">{label}</li>
			))}
		</ul>
	)
}

<div class="project-modal__body">
	<slot />
</div>

{
	media.length > 0 && (
		<section class="project-modal__gallery" aria-label="Showcase gallery" data-gallery>
			{media.map((m: ProjectMedia) =>
				m.kind === 'youtube' ? (
					<figure class={shotClasses(m)} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame shot-frame--youtube">
							<div
								class="shot-youtube"
								data-yt-id={youtubeId(m.src)}
								data-start={m.start != null ? String(m.start) : undefined}
								data-end={m.end != null ? String(m.end) : undefined}
								title={m.alt ?? m.caption}
							/>
							<span class="shot-badge">YOUTUBE</span>
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				) : isFacebookEmbed(m.kind) ? (
					<figure class={shotClasses(m, 'shot--video')} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame shot-frame--video">
							<iframe
								class="shot-video"
								src={facebookVideoEmbed(m.src)}
								title={m.alt ?? m.caption}
								loading="lazy"
								scrolling="no"
								allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
								allowfullscreen
							/>
							<span class="shot-badge">{m.kind === 'facebook-reel' ? 'REEL' : 'VIDEO'}</span>
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				) : m.kind === 'linkedin-post' ? (
					<figure class={shotClasses(m, 'shot--linkedin')} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame shot-frame--linkedin">
							{/* Fallback beneath the iframe — visible when a shields/tracker
							    blocker (Brave, uBlock, etc.) prevents the LinkedIn embed
							    from loading. The successfully-loaded iframe is opaque and
							    covers this; a blocked one is transparent and lets it
							    show through. */}
							<a class="shot-linkedin__fallback" href={m.src} target="_blank" rel="noopener noreferrer">
								<span class="shot-linkedin__fallback-title">LinkedIn post</span>
								<span class="shot-linkedin__fallback-hint">Embedded post blocked by your browser — open on LinkedIn ↗</span>
							</a>
							<iframe
								class="shot-linkedin"
								src={linkedInEmbed(m.src)}
								title={m.alt ?? m.caption}
								loading="lazy"
								allow="encrypted-media"
								allowfullscreen
							/>
							<span class="shot-badge">LINKEDIN</span>
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				) : m.kind === 'video' ? (
					<figure class={shotClasses(m, 'shot--video')} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame shot-frame--native-video">
							{/* No forced aspect-ratio on this frame — the browser sizes
							    the <video> at 100% width and its intrinsic aspect
							    ratio, so a non-16:9 clip fits horizontally and the
							    frame's height follows, without cropping or letterbox. */}
							<video class="shot-video-native" src={m.src} controls autoplay muted loop playsinline preload="auto" title={m.alt ?? m.caption} />
							<span class="shot-badge">VIDEO</span>
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				) : m.kind === 'image-row' ? (
					<figure class={shotClasses(m, 'shot--image-row')} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame shot-frame--image-row" data-image-row>
							{(m.images ?? []).map((imgSrc: string) => (
								<img src={imgSrc} alt={m.alt ?? m.caption} loading="lazy" decoding="async" />
							))}
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				) : m.kind === 'text' ? (
					<figure class={shotClasses(m, 'shot--text')} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-text">
							<p class="shot-text__body">{m.caption}</p>
						</div>
					</figure>
				) : (
					<figure class={shotClasses(m)} data-media-tags={mediaTags(m)} data-media-person={m.person} style={personStyle(m)}>
						<div class="shot-frame">
							<img src={m.src} alt={m.alt ?? m.caption} loading="lazy" decoding="async" />
							{m.kind === 'gif' && <span class="shot-badge">GIF</span>}
						</div>
						<figcaption>
							{m.caption}
						</figcaption>
					</figure>
				),
			)}
		</section>
	)
}

<style>
	.project-modal__head {
		padding-right: 2.5rem;
	}

	/* Shared projects — the ones with both people on the byline — center
	   their head so the title reads as belonging to the pair, not to
	   either side. Solo projects keep the default left alignment,
	   matching the left-aligned rest of the modal. */
	.project-modal__head--shared {
		padding-right: 0;
		text-align: center;
	}

	.project-modal__head--shared .project-modal__meta {
		justify-content: center;
	}

	.project-modal__title {
		margin: 0;
		font-size: 1.4rem;
	}

	.project-modal__detail {
		margin: 0.4rem 0 0;
		font-size: 0.92rem;
		color: var(--accent-3);
	}

	.project-modal__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0.3rem 0 0;
		font-size: 0.8rem;
		color: var(--fg-muted);
	}

	/* The work's timeframe, called out in the person accent so it reads as a
	   distinct fact rather than blending into the muted people line. */
	.project-modal__year {
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.03em;
		font-weight: 600;
		color: var(--accent-3);
	}

	.project-modal__meta-sep {
		color: var(--border);
	}

	.project-modal__tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem 0 0;
		padding: 0;
	}

	.tag {
		font-size: 0.75rem;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: var(--accent-soft);
		color: var(--accent-3);
		border: 1px solid rgba(255, 122, 0, 0.3);
	}

	.project-modal__body {
		margin-top: 1.1rem;
	}

	/* Base prose styling for whatever a caller slots in — a plain description
	   paragraph or several rendered experience blocks. `pre-line` preserves the
	   intentional line breaks in the Projects descriptions; harmless elsewhere. */
	.project-modal__body :global(p) {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--fg);
		white-space: pre-line;
	}

	.project-modal__body :global(p + p) {
		margin-top: 0.75rem;
	}

	/* One media item per row, each spanning the full width — so videos (and
	   shots) use up all the horizontal space rather than being squeezed
	   several-to-a-line. The horizontal padding here creates a *gutter*
	   inside the gallery: shots stay 100% wide inside the padded area, and
	   a person-attributed item translates into that same gutter without
	   ever spilling past the panel. Widen --gallery-gutter to give solo
	   items more travel; the modal itself is wide enough to bear it. */
	.project-modal__gallery {
		/* Side gutter around every shot. Shared shots sit in the padded
		   inner area; solo shots translate by exactly this amount into the
		   gutter (via `transform: translateX(...)`, see .shot--person-*
		   below), so the offset lands the shot right against the panel's
		   inner edge without ever spilling past it. Fixed pixels so the
		   gallery padding and the translate distance stay in sync — a %
		   translate resolves against the shot's own width, not the
		   gallery's. */
		--gallery-gutter: 44px;
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		padding-inline: var(--gallery-gutter);
	}

	/* Every shot has the SAME width — the full width of the padded gallery
	   inner area — whether shared or person-attributed. A solo shot slides
	   into the gallery's outer gutter (see .project-modal__gallery's
	   --gallery-gutter above), so the offset is visible but the frame
	   never crosses the panel's own edge. */
	/* Base shot — a bordered figure that holds the media frame AND its
	   caption in one padded surface, so the visual and the caption below
	   read as one connected block. Matches the modal experience prose
	   baseline (.modal-exp in ProjectRow.astro): solid 45%-mix border,
	   soft-tinted fill, 3px person-coloured side accent for solo items,
	   text-media is exactly this treatment without the underline. */
	.shot {
		margin: 0;
		padding: 1rem 1.15rem;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: color-mix(in oklab, var(--accent) 4%, var(--bg));
	}

	/* Solo shots translate exactly one gallery-gutter into the surrounding
	   gutter — same width as any shared shot, just visibly offset toward
	   their person's side. `transform` shifts the paint only, so the grid
	   track stays perfectly sized. */
	.shot--person-left {
		transform: translateX(calc(-1 * var(--gallery-gutter)));
	}

	.shot--person-right {
		transform: translateX(var(--gallery-gutter));
	}

	/* Solo shots — solid person-coloured border at 45% mix, soft 8%-mix
	   person tint on the fill. The 3px accent bar down the person's own
	   edge is set on the side variants below. */
	.shot--person {
		border: 1px solid color-mix(in oklab, var(--person-color, var(--accent)) 45%, var(--border));
		background: color-mix(in oklab, var(--person-color, var(--accent)) 8%, var(--bg));
	}

	.shot--person-left {
		border-left: 3px solid var(--person-color, var(--accent));
	}

	.shot--person-right {
		border-right: 3px solid var(--person-color, var(--accent));
		text-align: right;
	}

	/* Shared shots — the top and bottom borders carry a Mitko→Ádám gradient
	   (painted as a border-box background beneath transparent top/bottom
	   borders) and each side gets its own person's 3px solid accent, so
	   both people are unmistakeably present on the frame. Fill: the same
	   soft left-to-right person-tint pair as the shared timeline preview. */
	.shot:not(.shot--person) {
		border: 1px solid transparent;
		border-left: 3px solid var(--mitko-color);
		border-right: 3px solid var(--adam-color);
		background:
			linear-gradient(
					to right,
					color-mix(in oklab, var(--mitko-color) 6%, var(--bg)) 0%,
					color-mix(in oklab, var(--mitko-color) 6%, var(--bg)) 15%,
					color-mix(in oklab, var(--adam-color) 6%, var(--bg)) 85%,
					color-mix(in oklab, var(--adam-color) 6%, var(--bg)) 100%
				)
				padding-box,
			linear-gradient(
					to right,
					color-mix(in oklab, var(--mitko-color) 45%, var(--border)) 0%,
					color-mix(in oklab, var(--adam-color) 45%, var(--border)) 100%
				)
				border-box;
	}

	.shot-person {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--person-color, var(--accent-3));
		margin-right: 0.4rem;
	}

	/* A native <video> sizes at its intrinsic aspect ratio like an image
	   would — 100% width, height follows. The frame around it doesn't
	   force any aspect (see .shot-frame--native-video below), so a 4:3 or
	   ultrawide clip fits horizontally and shows in full. */
	.shot-frame--native-video {
		--frame-bg: #000;
	}

	.shot-video-native {
		display: block;
		width: 100%;
		height: auto;
		border: 0;
	}

	/* A text-only media item — no frame, no aspect ratio, just prose. The
	   .shot figure supplies the border, fill and padding (see above); this
	   is a plain wrapper. */
	.shot--text {
		max-width: 100%;
	}

	.shot-text__person {
		margin: 0 0 0.35rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--person-color, var(--accent-3));
	}

	.shot-text__body {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--fg);
		white-space: pre-line;
	}

	/* Inner media frame — just clips the visual to a soft rounded edge
	   inside the .shot box; the border/tint of the box itself is on .shot
	   above, so the caption below the frame sits inside the same padded
	   surface and reads as connected to the visual. --frame-bg is the
	   inner fill, defaulting transparent so the .shot tint shows through;
	   overridden to #000 by the video / image-row frame types below where
	   the media needs a black backdrop. */
	.shot-frame {
		position: relative;
		border-radius: 8px;
		overflow: hidden;
		--frame-bg: transparent;
		background: var(--frame-bg);
	}

	/* Images (and gifs) size at their intrinsic aspect ratio — width fills
	   the gallery, height follows so the whole frame is visible with no
	   cropping. A tall portrait or wide banner therefore keeps its own
	   shape. Only iframe embeds (which have no intrinsic size) still force
	   a 16:9 frame — see .shot-frame--video / --youtube below. */
	.shot-frame img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* A Facebook video/reel embed — a full-width 16:9 frame, with the fixed-size
	   plugin iframe absolutely positioned inside and transform-scaled by JS to
	   exactly fill it (see projectModal.client.ts). `overflow: hidden` (from
	   .shot-frame) clips the scaled iframe to the rounded frame. */
	.shot-frame--video {
		position: relative;
		aspect-ratio: 16 / 9;
		--frame-bg: #000;
	}

	.shot-video {
		position: absolute;
		top: 0;
		left: 0;
		width: 640px;
		height: 360px;
		border: 0;
		transform-origin: top left;
	}

	/* YouTube embeds via the IFrame API (see projectModal.client.ts) are natively
	   responsive, so — unlike the fixed-size Facebook plugin — the iframe just
	   fills a full-width 16:9 frame directly, no transform-scaling needed. */
	.shot-frame--youtube {
		position: relative;
		aspect-ratio: 16 / 9;
		--frame-bg: #000;
	}

	.shot-frame--youtube :global(iframe),
	.shot-youtube {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* A LinkedIn post embed — unlike the video embeds, a post has no fixed
	   aspect ratio; its height depends on how much text, media and reactions
	   it carries. Give the frame a tall portrait-ish default and let the
	   embed scroll internally when it doesn't fit, so the modal layout
	   stays predictable regardless of the post's size. */
	.shot-frame--linkedin {
		position: relative;
		width: 100%;
		height: min(720px, 85vh);
		--frame-bg: var(--bg);
	}

	.shot-linkedin {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* The fallback sits behind the iframe; a loaded embed covers it, a
	   blocked (transparent) one lets it show through as the clickable link
	   out to LinkedIn. */
	.shot-linkedin__fallback {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 1rem;
		text-align: center;
		text-decoration: none;
		color: var(--fg);
		background: color-mix(in oklab, var(--accent) 4%, var(--bg));
	}

	.shot-linkedin__fallback-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--accent-3);
	}

	.shot-linkedin__fallback-hint {
		font-size: 0.85rem;
		color: var(--fg-muted);
	}

	/* A composite of several images laid out horizontally. Each <img> uses
	   `flex: <aspect> 1 0` — grow proportional to its own aspect (set by
	   projectModal.client.ts once the image loads) — so widths distribute as
	   W * a_i / Σa. Because width_i / a_i = W / Σa is the same for every
	   image, all heights match; and the row spans the full frame width. A
	   small `--row-gap` sits between adjacent images. Before the loaders
	   report their intrinsic sizes, every image starts on `flex: 1 1 0`,
	   which just distributes width evenly. */
	.shot-frame--image-row {
		--row-gap: 4px;
		display: flex;
		flex-wrap: nowrap;
		align-items: stretch;
		gap: var(--row-gap);
		--frame-bg: #000;
	}

	.shot-frame--image-row img {
