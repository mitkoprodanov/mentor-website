---
import type { ProjectMedia } from '../../data/projects';
import ProjectDetail from './ProjectDetail.astro';

/**
 * The detail modal shared by the timeline (ProjectRow.astro / ApartBlock.astro).
 * It renders only the dialog frame — the top-layer overlay, close/backdrop
 * affordances, its own scroll — and hands the actual content (head, tags,
 * gallery) to ProjectDetail, taking the main body as a slot so each caller
 * supplies whatever fits it (a plain description, or the project's rendered
 * experience prose). Open/close wiring lives in scripts/projectModal.client.ts
 * and keys off `data-project-modal` here matching a trigger's `data-project-open`.
 */
interface Props {
	/** Unique across the page — must equal the trigger's `data-project-open`. */
	modalId: string;
	title: string;
	/** Strap-line under the title (a project's `detail`/`info`). */
	subtitle?: string;
	/** Year or year range the work spans, e.g. "2026" or "2024 – Present". */
	dateRange?: string;
	/** Who worked on it, e.g. "Mitko & Ádám". */
	people?: string;
	/** Person ids whose experience appears in this modal — used by
	 *  projectModal.client.ts to disable their sticky Skills toggle while
	 *  the modal is open (so the closed card reads as their attribution). */
	personIds?: string[];
	/** Tag labels rendered as pills. */
	tags?: string[];
	media?: ProjectMedia[];
	url?: string;
	urlLabel?: string;
}

const { modalId, title, subtitle, dateRange, people, personIds = [], tags = [], media = [], url, urlLabel } = Astro.props;
const titleId = `project-modal-title-${modalId}`;
---

<dialog
	class="project-modal"
	data-project-modal={modalId}
	data-project-people={personIds.join(' ')}
	aria-labelledby={titleId}
>
	<!-- Outside the scroll panel so `position: fixed` resolves to the viewport
	     (the panel's transform animation would make it the containing block). -->
	<button type="button" class="project-modal__close btn-sheen" data-project-close aria-label="Close dialog">
		<span class="project-modal__close-label">Project: <strong>{title}</strong></span>
		<span class="project-modal__close-icon" aria-hidden="true">✕</span>
	</button>

	<div class="project-modal__panel">
		<ProjectDetail title={title} subtitle={subtitle} dateRange={dateRange} people={people} tags={tags} media={media} url={url} urlLabel={urlLabel} titleId={titleId}>
			<slot />
		</ProjectDetail>
	</div>
</dialog>

<style>
	.project-modal {
		/* Roomy enough to serve as the *container* for translated content:
		   media items keep the same width whether shared or solo, and solo
		   items translate a bit toward their person's side inside the extra
		   side gutter — the modal is wide enough that the translated frame
		   still fits without spilling. See .shot / .shot--person in
		   ProjectDetail.astro. */
		width: min(1040px, calc(100vw - 2rem));
		/* Top-aligned to the same anchor as the skill filter view (top: 4.5rem),
		   leaving a 1.5rem gap at the bottom — matching the filter modal's
		   `top: 4.5rem` + `max-height: calc(100vh - 6rem)`. */
		margin-block-start: 4.5rem;
		max-height: min(900px, calc(100vh - 6rem));
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--bg-alt);
		color: var(--fg);
		overflow: hidden;
		box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
	}

	.project-modal::backdrop {
		background: rgba(4, 6, 10, 0.66);
		backdrop-filter: blur(3px);
	}

	/* Dialog fades in with opacity only — no transform on the dialog itself so
	   that `position: fixed` children (the close button) always resolve to the
	   viewport rather than to a transform-created containing block. The panel
	   gets the slide/scale so the entry motion is unchanged visually. */
	.project-modal[open] {
		animation: modal-fade-in 0.24s ease;
	}

	.project-modal[open] .project-modal__panel {
		animation: modal-panel-in 0.24s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-modal[open]::backdrop {
		animation: backdrop-in 0.24s ease;
	}

	@keyframes modal-fade-in {
		from { opacity: 0; }
		to   { opacity: 1; }
	}

	@keyframes modal-panel-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes backdrop-in {
		from { opacity: 0; }
		to   { opacity: 1; }
	}

	/* The panel owns all padding so a click anywhere outside it lands on the
	   <dialog> element itself — that's what the backdrop-close handler keys
	   off of (see projectModal.client.ts). */
	.project-modal__panel {
		position: relative;
		max-height: min(900px, calc(100vh - 6rem));
		overflow-y: auto;
		padding: 1.75rem;
		overscroll-behavior: contain;
	}

	/* Slimmer take on the site-wide scrollbar (see Layout.astro) — the modal is
	   a compact surface, so a lighter bar sits better inside it while keeping
	   the same tinted thumb. */
	.project-modal__panel::-webkit-scrollbar {
		width: 8px;
	}

	/* Floats above the modal at the same anchor as .filter-chip-shield:
	   fixed, centered, top: 2rem. Lives outside the scroll panel so
	   fixed resolves to the viewport (panel has a transform animation). */
	.project-modal__close {
		position: fixed;
		top: 2rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		/* Shared close-dismiss visual: same language as .filter-chip */
		display: flex;
		align-items: center;
		gap: 0.55rem;
		width: max-content;
		padding: var(--pad-chip);
		border-radius: var(--r-full);
		font-family: inherit;
		font-size: var(--text-ui);
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.2;
		color: var(--accent-3);
		background: color-mix(in srgb, var(--accent) 12%, var(--bg));
		border: 1px solid color-mix(in srgb, var(--accent-3) 55%, var(--border));
		cursor: pointer;
		--sheen-color: var(--accent-3);
		--sheen-strength: 0.35;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.project-modal__close:hover,
	.project-modal__close:focus-visible,
	.project-modal__close:active {
		color: var(--bg);
		background: var(--accent-3);
		border-color: var(--accent-3);
		box-shadow: 0 0 18px 1px color-mix(in srgb, var(--accent-3) 55%, transparent);
	}

	.project-modal__close:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 3px;
	}

	.project-modal__close-label strong {
		color: inherit;
	}

	.project-modal__close-icon {
		font-size: 0.9em;
		line-height: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-modal[open],
		.project-modal[open] .project-modal__panel,
		.project-modal[open]::backdrop {
			animation: none;
		}
	}

	/* On narrow/portrait screens the sticky person bar (promoted to the top
	   layer above the dialog) would cover the modal title. The panel gets a
	   padding-block-start so there is room above the title for the JS open
	   handler to scroll past — placing the title exactly at the bar's frame
	   bottom. margin-block-start: 4.5rem leaves room for the floating close
	   button (same offset as desktop); padding is reduced by the same amount
	   so the content-to-bar clearance is unchanged (3.5 + 4.5 = 8rem). */
	@media (max-width: 900px) {
		.project-modal {
			width: calc(100vw - 0.75rem);
			margin-block-start: 4.5rem;
			margin-block-end: 0;
			max-height: calc(100dvh - 4.5rem);
		}

		.project-modal__panel {
			max-height: calc(100dvh - 4.5rem);
			padding: 3.5rem 1rem 2rem;
		}
	}
</style>
