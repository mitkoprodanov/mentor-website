---
import type { ProjectMedia } from '../../data/projects';
import ProjectDetail from './ProjectDetail.astro';

/**
 * The detail modal shared by the timeline (ProjectRow.astro / ApartBlock.astro).
 * It renders only the dialog frame — the top-layer overlay, close/backdrop
 * affordances, its own scroll — and hands the actual content (head, tags,
 * gallery) to ProjectDetail, taking the main body as a slot so each caller
 * supplies whatever fits it (a plain description, or the project's rendered
 * experience prose). Open/close wiring lives in scripts/projectModal.client.ts
 * and keys off `data-project-modal` here matching a trigger's `data-project-open`.
 */
interface Props {
	/** Unique across the page — must equal the trigger's `data-project-open`. */
	modalId: string;
	title: string;
	/** Strap-line under the title (a project's `detail`/`info`). */
	subtitle?: string;
	/** Year or year range the work spans, e.g. "2026" or "2024 – Present". */
	dateRange?: string;
	/** Who worked on it, e.g. "Mitko & Ádám". */
	people?: string;
	/** Tag labels rendered as pills. */
	tags?: string[];
	media?: ProjectMedia[];
	url?: string;
	urlLabel?: string;
}

const { modalId, title, subtitle, dateRange, people, tags = [], media = [], url, urlLabel = 'Visit project' } = Astro.props;
const titleId = `project-modal-title-${modalId}`;
---

<dialog class="project-modal" data-project-modal={modalId} aria-labelledby={titleId}>
	<div class="project-modal__panel">
		<button type="button" class="project-modal__close" data-project-close aria-label="Close dialog">×</button>

		<ProjectDetail title={title} subtitle={subtitle} dateRange={dateRange} people={people} tags={tags} media={media} url={url} urlLabel={urlLabel} titleId={titleId}>
			<slot />
		</ProjectDetail>
	</div>
</dialog>

<style>
	.project-modal {
		/* Roomy enough to serve as the *container* for translated content:
		   media items keep the same width whether shared or solo, and solo
		   items translate a bit toward their person's side inside the extra
		   side gutter — the modal is wide enough that the translated frame
		   still fits without spilling. See .shot / .shot--person in
		   ProjectDetail.astro. */
		width: min(1040px, calc(100vw - 2rem));
		max-height: min(88vh, 900px);
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--bg-alt);
		color: var(--fg);
		overflow: hidden;
		box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
	}

	.project-modal::backdrop {
		background: rgba(4, 6, 10, 0.66);
		backdrop-filter: blur(3px);
	}

	.project-modal[open] {
		animation: modal-in 0.24s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-modal[open]::backdrop {
		animation: backdrop-in 0.24s ease;
	}

	@keyframes modal-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes backdrop-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* The panel owns all padding so a click anywhere outside it lands on the
	   <dialog> element itself — that's what the backdrop-close handler keys
	   off of (see projectModal.client.ts). */
	.project-modal__panel {
		position: relative;
		max-height: min(88vh, 900px);
		overflow-y: auto;
		padding: 1.75rem;
		overscroll-behavior: contain;
	}

	/* Slimmer take on the site-wide scrollbar (see Layout.astro) — the modal is
	   a compact surface, so a lighter bar sits better inside it while keeping
	   the same tinted thumb. */
	.project-modal__panel::-webkit-scrollbar {
		width: 8px;
	}

	.project-modal__close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		font-size: 1.4rem;
		line-height: 1;
		color: var(--fg-muted);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 8px;
		cursor: pointer;
		z-index: 1;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.project-modal__close:hover {
		color: var(--fg);
		border-color: var(--accent);
	}

	.project-modal__close:focus-visible {
		outline: 2px solid var(--accent-3);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-modal[open],
		.project-modal[open]::backdrop {
			animation: none;
		}
	}
</style>
