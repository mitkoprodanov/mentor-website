---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Mentor Game Studio',
	description = 'Battle-tested game developer team built for collaboration.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #0b0d12;
		--bg-alt: #12151c;
		--fg: #e9ecf1;
		--fg-muted: #9aa3b2;
		--accent: #ff7a00;
		--accent-2: #ffa500;
		--accent-3: #ffd166;
		--accent-soft: rgba(255, 122, 0, 0.15);
		--border: rgba(255, 255, 255, 0.08);

		/* Mentor Game Studio — the studio itself, "us". Its own hero color,
		   stronger and more saturated than either person's accent so the
		   Mentor era clearly reads as the most important thread. */
		--mentor: #ffb703;
		--mentor-strong: #ffc633;
		--mentor-soft: rgba(255, 183, 3, 0.22);
		/* Lighter, warm-tinted panel that fills Mentor-era cards so the era
		   reads as its own region — not just the glowing rail beside it. */
		--mentor-bg: color-mix(in oklab, var(--mentor) 12%, var(--bg-alt));
		--mentor-border: color-mix(in oklab, var(--mentor) 45%, var(--border));

		/* Per-person accent, used to color-code the timeline thread and skill tags. */
		--mitko-color: var(--accent);
		--adam-color: var(--accent-3);

		/* Generic timeline project marker (the small dot beside a project
		   name) — deliberately outside the warm orange/yellow person-accent
		   family, so it reads as "just a project marker" and never gets
		   mistaken for either person's color. */
		--project-dot: #ef4444;
		--project-dot-soft: rgba(239, 68, 68, 0.25);

		/* One on-brand scrollbar shared by the whole site — the page itself and
		   every inner scroll area (the project detail modal, a person card's
		   revealed skills, the filtered results panel). A soft translucent thumb
		   at rest that warms to the accent on hover, on an invisible track, so it
		   reads as part of the dark UI rather than the OS default. */
		--scrollbar-thumb: color-mix(in oklab, var(--fg-muted) 45%, transparent);
		--scrollbar-thumb-hover: color-mix(in oklab, var(--accent) 70%, var(--fg-muted));

		/* Native form controls / default scrollbars render dark. */
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}

	/* Firefox — thin, tinted; the color inherits to inner scroll containers. */
	html {
		scrollbar-width: thin;
		scrollbar-color: var(--scrollbar-thumb) transparent;
	}

	/* WebKit / Chromium — pill thumb inset from an invisible track (the 2px
	   transparent border + padding-box clip gives it breathing room), warming
	   to the accent on hover. Applies document-wide, so the page and every
	   overflow area (modal, side panel, filter panel) share the same bar. */
	::-webkit-scrollbar {
		width: 11px;
		height: 11px;
	}

	::-webkit-scrollbar-track {
		background: transparent;
	}

	::-webkit-scrollbar-thumb {
		background: var(--scrollbar-thumb);
		border-radius: 999px;
		border: 2px solid transparent;
		background-clip: padding-box;
	}

	::-webkit-scrollbar-thumb:hover {
		background: var(--scrollbar-thumb-hover);
		background-clip: padding-box;
	}

	::-webkit-scrollbar-corner {
		background: transparent;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html,
		body {
			scroll-behavior: auto;
		}
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family:
			Inter,
			Roboto,
			'Helvetica Neue',
			'Arial Nova',
			'Nimbus Sans',
			Arial,
			sans-serif;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand-heading {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-weight: 700;
	}

	a {
		color: inherit;
	}

	/* --- Shared "clickable surface" sheen --------------------------------
	   A faint metallic glint that drifts once across an interactive pill or
	   box every several seconds, then rests for the remainder of the cycle —
	   just enough motion to hint "this surface is a live click target"
	   without ever pulling focus. Opt in by adding the `btn-sheen` class to
	   the element. Tune per element with:
	     --sheen-strength : peak opacity of the glint (default 0.1)
	     --sheen-color    : highlight tint (default warm white)
	     --sheen-delay    : negative offset used to stagger neighbours so
	                        they never all flash in unison. */
	.btn-sheen {
		position: relative;
	}

	.btn-sheen::after {
		content: '';
		position: absolute;
		inset: 0;
		/* Clip the glint to the host's own rounded shape. */
		border-radius: inherit;
		pointer-events: none;
		/* A narrow diagonal band of light on an otherwise transparent layer;
		   the oversized background gives the band room to travel across. */
		background: linear-gradient(
			115deg,
			transparent 38%,
			color-mix(in srgb, var(--sheen-color, #ffe9c7) 35%, transparent) 47%,
			color-mix(in srgb, var(--sheen-color, #ffe9c7) 70%, transparent) 50%,
			color-mix(in srgb, var(--sheen-color, #ffe9c7) 35%, transparent) 53%,
			transparent 62%
		);
		background-size: 260% 100%;
		background-repeat: no-repeat;
		background-position: 160% 0;
		opacity: 0;
		/* `screen` brightens the tinted surface like a specular glint rather
		   than painting a flat streak over it. */
		mix-blend-mode: screen;
		animation: btn-sheen-drift 9s ease-in-out var(--sheen-delay, 0s) infinite;
	}

	@keyframes btn-sheen-drift {
		/* The glint sweeps through in the first ~2.3s, then the layer sits
		   dark for the rest of the cycle — occasional, not a constant
		   shimmer. */
		0% {
			background-position: 160% 0;
			opacity: 0;
		}
		4% {
			opacity: var(--sheen-strength, 0.1);
		}
		26% {
			background-position: -60% 0;
			opacity: 0;
		}
		100% {
			background-position: -60% 0;
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.btn-sheen::after {
			animation: none;
		}
	}
</style>
