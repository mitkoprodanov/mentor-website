---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Mentor Game Studio',
	description = 'Battle-tested game developer team built for collaboration.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #0b0d12;
		--bg-alt: #12151c;
		--fg: #e9ecf1;
		--fg-muted: #9aa3b2;
		--accent: #ff7a00;
		--accent-2: #ffa500;
		--accent-3: #ffd166;
		--accent-soft: rgba(255, 122, 0, 0.15);
		--border: rgba(255, 255, 255, 0.08);

		/* Mentor Game Studio — the studio itself, "us". Its own hero color,
		   stronger and more saturated than either person's accent so the
		   Mentor era clearly reads as the most important thread. */
		--mentor: #ffb703;
		--mentor-strong: #ffc633;
		--mentor-soft: rgba(255, 183, 3, 0.22);
		/* Lighter, warm-tinted panel that fills Mentor-era cards so the era
		   reads as its own region — not just the glowing rail beside it. */
		--mentor-bg: color-mix(in oklab, var(--mentor) 12%, var(--bg-alt));
		--mentor-border: color-mix(in oklab, var(--mentor) 45%, var(--border));

		/* Per-person accent, used to color-code the timeline thread and skill tags. */
		--mitko-color: var(--accent);
		--adam-color: var(--accent-3);

		/* Generic timeline project marker (the small dot beside a project
		   name) — deliberately outside the warm orange/yellow person-accent
		   family, so it reads as "just a project marker" and never gets
		   mistaken for either person's color. */
		--project-dot: #ef4444;
		--project-dot-soft: rgba(239, 68, 68, 0.25);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html,
		body {
			scroll-behavior: auto;
		}
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family:
			Inter,
			Roboto,
			'Helvetica Neue',
			'Arial Nova',
			'Nimbus Sans',
			Arial,
			sans-serif;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand-heading {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-weight: 700;
	}

	a {
		color: inherit;
	}
</style>
