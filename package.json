{
  "name": "mentor-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "worker:test": "node --test \"workers/telemetry/test/*.test.ts\"",
    "worker:typecheck": "tsc -p workers/telemetry",
    "worker:dev": "wrangler dev --config workers/telemetry/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config workers/telemetry/wrangler.jsonc"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.139.0"
  }
}
